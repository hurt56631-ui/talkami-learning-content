      "example": "他不在公司。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [
        "在",
        "语序"
      ],
      "target": "ai_pattern",
      "myanmar": {
        "example_my": "သူ ကုမ္ပဏီမှာ မရှိဘူး။",
        "usage_my": "“在” ကို နေရာမှာ ရှိ/မရှိ ပြောဖို့ သုံးတယ်။ “正在” လုပ်ဆောင်နေတယ်ဆိုတာနဲ့ မရောပါနဲ့။",
        "teaching_note_my": "မြန်မာလို နေရာပြစကားလုံး “မှာ၊ ကို၊ ကနေ” တွေနဲ့ တရုတ်လို “在၊ 到၊ 从” တို့ရဲ့ နေရာကို နှိုင်းယှဉ်ပြီး သင်ပါ။",
        "review_status": "ai_draft"
      }
