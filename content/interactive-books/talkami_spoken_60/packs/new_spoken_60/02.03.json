  "scenes": [
    {
      "id": "02.03.01",
      "title": "邀请并商量时间",
      "title_my": "ဖိတ်ခေါ်ခြင်းနှင့် အချိန်ညှိခြင်း",
      "original_count": 22,
      "added_count": 15,
      "phrase_count": 37,
      "phrases": [
        {
          "id": "02.03.01-S001",
          "text": "有空一起吃饭吗？",
          "meaning_my": "အားရင် အတူတူ ထမင်းစားကြမလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S002",
          "text": "这周有点忙，下周吧。",
          "meaning_my": "ဒီအပတ် နည်းနည်း အလုပ်များလို့ နောက်အပတ်မှနော်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S003",
          "text": "要不要一起逛街？",
          "meaning_my": "အတူတူ ဈေးလျှောက်ကြမလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S004",
          "text": "我还有事，改天吧。",
          "meaning_my": "တခြားကိစ္စရှိသေးလို့ နောက်တစ်နေ့မှပေါ့။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S005",
          "text": "周末有空吗？",
          "meaning_my": "ပိတ်ရက် အားလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S006",
          "text": "你什么时候有空？",
          "meaning_my": "ဘယ်အချိန် အားလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S007",
          "text": "你哪天休息？",
          "meaning_my": "ဘယ်နေ့ နားရလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S008",
          "text": "周五行吗？",
          "meaning_my": "သောကြာနေ့ ရမလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S009",
          "text": "那就周五吧。",
          "meaning_my": "ဒါဆို သောကြာနေ့ပဲနော်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S010",
          "text": "一起喝杯咖啡？",
          "meaning_my": "ကော်ဖီအတူ သောက်ကြမလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S011",
          "text": "明天下午怎么样？",
          "meaning_my": "မနက်ဖြန် နေ့လယ်နောက်ပိုင်းဆိုရော။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S012",
          "text": "我下午比较方便。",
          "meaning_my": "နေ့လယ်နောက်ပိုင်းက ပိုအားတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S013",
          "text": "要不改到晚上？",
          "meaning_my": "ညဘက် ပြောင်းလိုက်မလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S014",
          "text": "好啊。",
          "meaning_my": "ကောင်းတာပေါ့။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S015",
          "text": "今天不行。",
          "meaning_my": "ဒီနေ့တော့ မရဘူး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S016",
          "text": "我晚上有空。",
          "meaning_my": "ညဘက် အားတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S017",
          "text": "周末得上班，走不开。",
          "meaning_my": "ပိတ်ရက်လည်း အလုပ်ဆင်းရလို့ မအားဘူး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S018",
          "text": "三点我有事。",
          "meaning_my": "သုံးနာရီမှာ ကိစ္စရှိတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S019",
          "text": "时间你定吧。",
          "meaning_my": "အချိန်ကို ခင်ဗျားပဲ ရွေးလိုက်ပါ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S020",
          "text": "中午还是晚上方便？",
          "meaning_my": "နေ့လယ်လား၊ ညဘက်လား၊ ဘယ်အချိန် ပိုအားလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S021",
          "text": "找个时间聚聚吧。",
          "meaning_my": "တစ်နေ့နေ့ အချိန်ရှာပြီး တွေ့ကြရအောင်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S022",
          "text": "要不周六下午？",
          "meaning_my": "စနေနေ့ နေ့လယ်နောက်ပိုင်းဆိုရော။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S023",
          "text": "想请你吃个饭。",
          "meaning_my": "ထမင်းတစ်ခါလောက် ကျွေးချင်လို့ပါ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S024",
          "text": "这次我请客。",
          "meaning_my": "ဒီတစ်ခါ ကိုယ်ပဲ ဝယ်ကျွေးမယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S025",
          "text": "想吃什么？",
          "meaning_my": "ဘာစားချင်လဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S026",
          "text": "你定就行。",
          "meaning_my": "ခင်ဗျားပဲ ဆုံးဖြတ်လိုက်ပါ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S027",
          "text": "要不要叫上别人？",
          "meaning_my": "တခြားလူတွေပါ ခေါ်ကြမလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S028",
          "text": "就我们俩吧。",
          "meaning_my": "နှစ်ယောက်တည်းပဲ သွားကြရအောင်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S029",
          "text": "那就说定了。",
          "meaning_my": "ဒါဆို ဒီအတိုင်း သဘောတူလိုက်ပြီနော်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S030",
          "text": "别放我鸽子啊。",
          "meaning_my": "ချိန်းထားပြီး မလာဘဲ ပျောက်မသွားနဲ့နော်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S031",
          "text": "到时候我提醒你。",
          "meaning_my": "အဲဒီအချိန်ကျ သတိပေးမယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S032",
          "text": "你能来吗？",
          "meaning_my": "လာနိုင်မလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S033",
          "text": "我尽量赶到。",
          "meaning_my": "အမီရောက်အောင် ကြိုးစားမယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S034",
          "text": "我们几点见？",
          "meaning_my": "ဘယ်နှနာရီ တွေ့ကြမလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S035",
          "text": "能往后推半小时吗？",
          "meaning_my": "နာရီဝက်လောက် နောက်ရွှေ့လို့ရမလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S036",
          "text": "临时有点事，改到明天行吗？",
          "meaning_my": "ရုတ်တရက် ကိစ္စပေါ်လာလို့ မနက်ဖြန် ပြောင်းလို့ရမလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.01-S037",
          "text": "你今晚方便吗？",
          "meaning_my": "ဒီည အားလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        }
      ]
    },
    {
      "id": "02.03.02",
      "title": "约定地点",
      "title_my": "တွေ့ဆုံမည့်နေရာ ချိန်းခြင်း",
      "original_count": 17,
      "added_count": 11,
      "phrase_count": 28,
      "phrases": [
        {
          "id": "02.03.02-S001",
          "text": "地铁站门口见吧。",
          "meaning_my": "မြေအောက်ရထားဘူတာ ရှေ့မှာ တွေ့ကြမယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.02-S002",
          "text": "发个定位吧。",
          "meaning_my": "တည်နေရာလေး ပို့ပေးပါ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.02-S003",
          "text": "等一下，我看一下定位。",
          "meaning_my": "ခဏလေး၊ တည်နေရာ ကြည့်လိုက်ဦးမယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.02-S004",
          "text": "我们在门口见吧。",
          "meaning_my": "တံခါးဝမှာ တွေ့ကြမယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.02-S005",
          "text": "到了给我发消息。",
          "meaning_my": "ရောက်ရင် စာပို့ပါ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.02-S006",
          "text": "可以，到了我给你打电话。",
          "meaning_my": "ရတယ်၊ ရောက်ရင် ဖုန်းဆက်မယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.02-S007",
          "text": "哪个门比较好找？",
          "meaning_my": "ဘယ်တံခါးက ရှာရလွယ်လဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.03.02-S008",
          "text": "公司楼下见。",
