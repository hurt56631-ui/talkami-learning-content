          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.02-S007",
          "text": "有日包吗？",
          "meaning_my": "တစ်ရက်စာ ဒေတာပက်ကေ့ချ် ရှိလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_07.01.02_N01",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.02-S008",
          "text": "有月包吗？",
          "meaning_my": "တစ်လစာ ဒေတာပက်ကေ့ချ် ရှိလား။",
