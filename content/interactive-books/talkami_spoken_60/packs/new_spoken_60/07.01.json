    {
      "id": "07.01.02",
      "title": "手机卡流量",
      "title_my": "ဆင်းမ်ကတ်နှင့် မိုဘိုင်းဒေတာ",
      "phrase_count": 33,
      "phrases": [
        {
          "id": "07.01.02-S001",
          "text": "我想办手机卡。",
          "meaning_my": "ဆင်းမ်ကတ် အသစ်လုပ်ချင်ပါတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.02_B001",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.02-S002",
          "text": "手机卡在哪儿办？",
          "meaning_my": "ဆင်းမ်ကတ် ဘယ်မှာ သွားလုပ်ရမလဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.02_B007",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.02-S003",
          "text": "用护照可以办手机卡吗？",
          "meaning_my": "ပတ်စ်ပို့နဲ့ ဆင်းမ်ကတ် လုပ်လို့ရလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.02_B008",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.02-S004",
          "text": "这个套餐一个月多少钱？",
          "meaning_my": "ဒီပက်ကေ့ချ်က တစ်လ ဘယ်လောက်ကျလဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.02_B026",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.02-S005",
          "text": "这个套餐有多少流量？",
          "meaning_my": "ဒီပက်ကေ့ချ်မှာ ဒေတာ ဘယ်လောက်ပါလဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.02_B003",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.02-S006",
          "text": "这个套餐能打多少分钟电话？",
          "meaning_my": "ဒီပက်ကေ့ချ်မှာ ဖုန်းပြောချိန် ဘယ်နှမိနစ် ပါလဲ။",
          "replies": [],
