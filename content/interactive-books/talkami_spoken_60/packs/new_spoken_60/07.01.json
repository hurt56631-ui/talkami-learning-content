  "scenes": [
    {
      "id": "07.01.01",
      "title": "充电电量",
      "title_my": "ဖုန်းအားသွင်းခြင်းနှင့် ဘက်ထရီ",
      "phrase_count": 26,
      "phrases": [
        {
          "id": "07.01.01-S001",
          "text": "手机快没电了。",
          "meaning_my": "ဖုန်းအား ကုန်ခါနီးပြီ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B002",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S002",
          "text": "还有多少电？",
          "meaning_my": "ဘက်ထရီ ဘယ်လောက်ကျန်သေးလဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_07.01.01_N01",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S003",
          "text": "只剩百分之十了。",
          "meaning_my": "ဆယ်ရာခိုင်နှုန်းပဲ ကျန်တော့တယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_07.01.01_N02",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S004",
          "text": "手机没电关机了。",
          "meaning_my": "ဖုန်းအားကုန်လို့ ပိတ်သွားပြီ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B010",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S005",
          "text": "这里可以充电吗？",
          "meaning_my": "ဒီမှာ ဖုန်းအားသွင်းလို့ရလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B007",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S006",
          "text": "哪里能给手机充电？",
          "meaning_my": "ဖုန်းအားသွင်းလို့ရတဲ့နေရာ ဘယ်မှာလဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B001",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S007",
          "text": "有插座吗？",
          "meaning_my": "ပလပ်ပေါက် ရှိလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B004",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S008",
          "text": "能用你的插座充一下吗？",
          "meaning_my": "ဒီပလပ်ပေါက်နဲ့ ခဏအားသွင်းလို့ရမလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_07.01.01_N12",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S009",
          "text": "能借我一根充电线吗？",
          "meaning_my": "အားသွင်းကြိုး တစ်ချောင်းလောက် ငှားလို့ရမလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B005",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S010",
          "text": "能借我一个充电器吗？",
          "meaning_my": "အားသွင်းခေါင်း တစ်ခုလောက် ငှားလို့ရမလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B006",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S011",
          "text": "有Type-C线吗？",
          "meaning_my": "Type-C အားသွင်းကြိုး ရှိလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B011",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S012",
          "text": "可以借充电宝吗？",
          "meaning_my": "ပါဝါဘဏ် ခဏငှားလို့ရမလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B012",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S013",
          "text": "共享充电宝在哪儿租？",
          "meaning_my": "ပါဝါဘဏ် ငှားလို့ရတဲ့နေရာ ဘယ်မှာလဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_07.01.01_N09",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S014",
          "text": "充电宝在哪里还？",
          "meaning_my": "ငှားထားတဲ့ ပါဝါဘဏ်ကို ဘယ်မှာပြန်အပ်ရမလဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B015",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S015",
          "text": "充电要收费吗？",
          "meaning_my": "အားသွင်းရင် ပိုက်ဆံပေးရလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B019",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S016",
          "text": "租充电宝要押金吗？",
          "meaning_my": "ပါဝါဘဏ်ငှားရင် စပေါ်ငွေ ပေးရလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_07.01.01_N11",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S017",
          "text": "我的手机充不上电。",
          "meaning_my": "ဖုန်း အားသွင်းလို့မရဘူး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B009",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S018",
          "text": "充电线坏了。",
          "meaning_my": "အားသွင်းကြိုး ပျက်သွားပြီ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B008",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S019",
          "text": "充电口坏了。",
          "meaning_my": "ဖုန်းအားသွင်းပေါက် ပျက်နေတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_07.01.01_N05",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S020",
          "text": "这个插座没电。",
          "meaning_my": "ဒီပလပ်ပေါက် မီးမလာဘူး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B017",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S021",
          "text": "充了半天，电量一点没涨。",
          "meaning_my": "အားသွင်းထားတာ ကြာပြီ၊ ဘက်ထရီ ရာခိုင်နှုန်း လုံးဝမတက်ဘူး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B013",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S022",
          "text": "充着电手机发烫。",
          "meaning_my": "အားသွင်းရင်း ဖုန်း အရမ်းပူလာတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_07.01.01_N06",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S023",
          "text": "能无线充电吗？",
          "meaning_my": "ကြိုးမဲ့ အားသွင်းလို့ရလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_07.01.01_N04",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S024",
          "text": "这个充电器能用吗？",
          "meaning_my": "ဒီအားသွင်းခေါင်း သုံးလို့ရလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.01.01_B014",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S025",
          "text": "这根线不支持快充。",
          "meaning_my": "ဒီအားသွင်းကြိုးနဲ့ အမြန်အားသွင်းလို့ မရဘူး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_07.01.01_N14",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.01.01-S026",
          "text": "充电头是多少瓦的？",
          "meaning_my": "ဒီအားသွင်းခေါင်းက ဘယ်နှဝပ်လဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_07.01.01_N15",
