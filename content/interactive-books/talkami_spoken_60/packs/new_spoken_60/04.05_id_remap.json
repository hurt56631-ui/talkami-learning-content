  "mapping": [
    {
      "source_ref": "user_original_04.05.01_O001",
      "id": "04.05.01-S001",
      "text": "买单。"
    },
    {
      "source_ref": "user_original_04.05.01_O002",
      "id": "04.05.01-S002",
      "text": "这一桌一共多少钱？"
    },
    {
      "source_ref": "user_original_04.05.01_O003",
      "id": "04.05.01-S003",
      "text": "麻烦给我看一下账单。"
    },
    {
      "source_ref": "user_original_04.05.01_O004",
      "id": "04.05.01-S004",
      "text": "这个费用是什么？"
    },
    {
      "source_ref": "user_original_04.05.01_O005",
      "id": "04.05.01-S005",
      "text": "可以分开结账吗？"
    },
    {
      "source_ref": "user_original_04.05.01_O007",
      "id": "04.05.01-S006",
      "text": "麻烦核对一下金额。"
    },
    {
      "source_ref": "user_original_04.05.01_O011",
      "id": "04.05.01-S007",
      "text": "这道菜算了两遍。"
    },
    {
      "source_ref": "user_original_04.05.01_O012",
      "id": "04.05.01-S008",
      "text": "账单有一项不对。"
    },
    {
      "source_ref": "user_original_04.05.01_O013",
      "id": "04.05.01-S009",
      "text": "这道菜没上，怎么也算钱了？"
    },
    {
      "source_ref": "user_addition_04.05.01_N07",
      "id": "04.05.01-S010",
      "text": "多算了十块。"
    },
    {
      "source_ref": "user_addition_04.05.01_N08",
      "id": "04.05.01-S011",
      "text": "能重新算一下吗？"
    },
    {
      "source_ref": "user_original_04.05.01_O023",
      "id": "04.05.01-S012",
      "text": "优惠怎么没算上？"
    },
    {
      "source_ref": "user_original_04.05.01_O024",
      "id": "04.05.01-S013",
      "text": "这桌要收服务费吗？"
    },
    {
      "source_ref": "user_original_04.05.01_O009",
      "id": "04.05.01-S014",
      "text": "可以在桌边结账吗？"
    },
    {
      "source_ref": "user_original_04.05.01_O010",
      "id": "04.05.01-S015",
      "text": "我来付。"
    },
    {
      "source_ref": "user_addition_04.05.01_N10",
      "id": "04.05.01-S016",
      "text": "可以刷卡吗？"
    },
    {
      "source_ref": "user_addition_04.05.01_N11",
      "id": "04.05.01-S017",
      "text": "可以用微信支付吗？"
    },
    {
      "source_ref": "user_addition_04.05.01_N12",
      "id": "04.05.01-S018",
      "text": "可以用支付宝吗？"
    },
    {
      "source_ref": "user_addition_04.05.01_N18",
      "id": "04.05.01-S019",
      "text": "扫哪个码？"
    },
    {
      "source_ref": "user_original_04.05.01_O025",
      "id": "04.05.01-S020",
      "text": "我扫码付。"
    },
    {
      "source_ref": "user_addition_04.05.01_N19",
      "id": "04.05.01-S021",
      "text": "付款成功了。"
    },
    {
      "source_ref": "user_addition_04.05.01_N20",
      "id": "04.05.01-S022",
      "text": "请给我小票。"
    },
    {
      "source_ref": "user_original_04.05.01_O008",
      "id": "04.05.01-S023",
      "text": "能打印一张账单吗？"
    },
    {
      "source_ref": "user_original_04.05.01_O019",
      "id": "04.05.01-S024",
      "text": "需要分开付吗？"
    },
    {
      "source_ref": "editorial_new_04.05.01_M01",
      "id": "04.05.01-S025",
      "text": "我已经付过了。"
    },
    {
      "source_ref": "user_original_04.05.02_O001",
      "id": "04.05.02-S001",
      "text": "我们AA吧。"
    },
    {
      "source_ref": "user_original_04.05.02_O003",
      "id": "04.05.02-S002",
      "text": "各付各的。"
    },
    {
      "source_ref": "user_original_04.05.02_O004",
      "id": "04.05.02-S003",
      "text": "这顿我请。"
    },
    {
      "source_ref": "user_addition_04.05.02_N02",
      "id": "04.05.02-S004",
      "text": "一人多少钱？"
    },
    {
      "source_ref": "user_original_04.05.02_O005",
      "id": "04.05.02-S005",
      "text": "我先垫上。"
    },
    {
      "source_ref": "user_addition_04.05.02_N04",
      "id": "04.05.02-S006",
      "text": "我先付，大家再转我。"
    },
    {
      "source_ref": "user_original_04.05.02_O006",
      "id": "04.05.02-S007",
      "text": "我转给你。"
    },
    {
      "source_ref": "user_original_04.05.02_O007",
      "id": "04.05.02-S008",
      "text": "钱转过去了，你收一下。"
    },
    {
      "source_ref": "user_original_04.05.02_O009",
      "id": "04.05.02-S009",
      "text": "你把收款码发我。"
    },
    {
      "source_ref": "user_addition_04.05.02_N08",
      "id": "04.05.02-S010",
      "text": "收到了吗？"
    },
    {
      "source_ref": "user_original_04.05.02_O019",
      "id": "04.05.02-S011",
      "text": "我收到了。"
    },
    {
      "source_ref": "user_original_04.05.02_O011",
      "id": "04.05.02-S012",
      "text": "回去我再转给你。"
    },
    {
      "source_ref": "user_original_04.05.02_O015",
      "id": "04.05.02-S013",
      "text": "我把我的那份转给你。"
    },
    {
      "source_ref": "user_original_04.05.02_O018",
      "id": "04.05.02-S014",
      "text": "你转过来了吗？"
    },
    {
      "source_ref": "user_original_04.05.02_O020",
      "id": "04.05.02-S015",
      "text": "一人一半吧。"
    },
    {
      "source_ref": "user_original_04.05.02_O023",
      "id": "04.05.02-S016",
      "text": "你转我八十就行。"
    },
    {
      "source_ref": "user_original_04.05.02_O025",
      "id": "04.05.02-S017",
      "text": "方便把餐费转我吗？"
    },
    {
      "source_ref": "user_original_04.05.02_O021",
      "id": "04.05.02-S018",
      "text": "你不用转了。"
    },
    {
      "source_ref": "user_addition_04.05.02_N10",
      "id": "04.05.02-S019",
      "text": "我还欠你多少钱？"
    },
    {
      "source_ref": "user_addition_04.05.02_N11",
      "id": "04.05.02-S020",
      "text": "你多给了。"
    },
    {
      "source_ref": "user_original_04.05.02_O008",
      "id": "04.05.02-S021",
      "text": "我多付了二十块。"
    },
    {
      "source_ref": "user_original_04.05.02_O013",
      "id": "04.05.02-S022",
      "text": "不用算那么清楚。"
    },
    {
      "source_ref": "user_original_04.05.02_O014",
      "id": "04.05.02-S023",
      "text": "这次你付，下次我来。"
    },
    {
      "source_ref": "user_addition_04.05.02_N15",
      "id": "04.05.02-S024",
      "text": "说好了我请。"
    },
    {
      "source_ref": "user_original_04.05.02_O027",
      "id": "04.05.02-S025",
      "text": "你把收据拍给我吧。"
    },
    {
      "source_ref": "user_original_04.05.02_O028",
      "id": "04.05.02-S026",
      "text": "我把账单发群里。"
    },
    {
      "source_ref": "user_original_04.05.02_O029",
      "id": "04.05.02-S027",
      "text": "现金还是转账？"
    },
    {
      "source_ref": "user_original_04.05.03_O001",
      "id": "04.05.03-S001",
      "text": "可以开发票吗？"
    },
    {
      "source_ref": "user_original_04.05.03_O002",
      "id": "04.05.03-S002",
      "text": "开电子发票就行。"
    },
    {
      "source_ref": "user_original_04.05.03_O004",
      "id": "04.05.03-S003",
      "text": "发票开公司抬头。"
    },
    {
      "source_ref": "user_original_04.05.03_O005",
      "id": "04.05.03-S004",
      "text": "发票抬头写这个。"
    },
    {
      "source_ref": "user_original_04.05.03_O008",
      "id": "04.05.03-S005",
      "text": "发票开个人的。"
    },
    {
      "source_ref": "user_original_04.05.03_O006",
      "id": "04.05.03-S006",
      "text": "电子发票发到哪里？"
    },
    {
      "source_ref": "user_original_04.05.03_O007",
      "id": "04.05.03-S007",
      "text": "发到这个邮箱。"
    },
    {
      "source_ref": "user_original_04.05.03_O009",
      "id": "04.05.03-S008",
      "text": "发票金额好像不对。"
    },
    {
      "source_ref": "user_original_04.05.03_O012",
      "id": "04.05.03-S009",
      "text": "发票信息填错了，能改吗？"
    },
    {
      "source_ref": "user_addition_04.05.03_N05",
      "id": "04.05.03-S010",
      "text": "税号要写吗？"
    },
    {
      "source_ref": "user_addition_04.05.03_N10",
      "id": "04.05.03-S011",
      "text": "多久能开好？"
    },
    {
      "source_ref": "user_addition_04.05.03_N11",
      "id": "04.05.03-S012",
      "text": "发票能补开吗？"
    },
    {
      "source_ref": "user_addition_04.05.03_N13",
      "id": "04.05.03-S013",
      "text": "能重开一张吗？"
    }
  ]
}
