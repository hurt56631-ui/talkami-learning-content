  "scenes": [
    {
      "id": "06.03.01",
      "title": "叫车定位",
      "title_my": "ကားခေါ်ခြင်းနှင့် တည်နေရာသတ်မှတ်ခြင်း",
      "phrase_count": 24,
      "phrases": [
        {
          "id": "06.03.01-S001",
          "text": "我已经叫车了。",
          "meaning_my": "ကား ခေါ်ထားပြီးပြီ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-S001",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S002",
          "text": "上车点在哪儿？",
          "meaning_my": "ကားတက်ရမယ့်နေရာ ဘယ်မှာလဲ။",
          "replies": [
            {
              "id": "06.03.01-S002_reply01",
              "text": "到前面的指定上车点等我吧。",
              "meaning_my": "ရှေ့က သတ်မှတ်ထားတဲ့ ကားတက်နေရာမှာ စောင့်ပေးပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "06.03.01-S002_alt01",
              "text": "在哪里上车？",
              "meaning_my": "ဘယ်မှာ ကားတက်ရမလဲ။"
            }
          ],
          "source_ref": "06.03.01-S003",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S003",
          "text": "司机到哪儿了？",
          "meaning_my": "ယာဉ်မောင်း ဘယ်ရောက်နေပြီလဲ။",
          "replies": [
            {
              "id": "06.03.01-S003_reply01",
              "text": "还有三分钟左右到。",
              "meaning_my": "နောက်ထပ် သုံးမိနစ်လောက်နေရင် ရောက်မယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "06.03.01-S007",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S004",
          "text": "司机还有几分钟到？",
          "meaning_my": "ယာဉ်မောင်း ရောက်ဖို့ နောက်ထပ် ဘယ်နှမိနစ်လိုသေးလဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-补02",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S005",
          "text": "定位对吗？",
          "meaning_my": "တည်နေရာ မှန်ရဲ့လား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-S005",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S006",
          "text": "定位有点偏，我重新发一下。",
          "meaning_my": "တည်နေရာ နည်းနည်းလွဲနေလို့ ပြန်ပို့ပေးမယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-补04",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S007",
          "text": "怎么联系司机？",
          "meaning_my": "ယာဉ်မောင်းကို ဘယ်လို ဆက်သွယ်ရမလဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-S009",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S008",
          "text": "我找不到你的车。",
          "meaning_my": "ကားကို ရှာမတွေ့ဘူး။",
          "replies": [
            {
              "id": "06.03.01-S008_reply01",
              "text": "我在东门，你看到白色的车了吗？",
              "meaning_my": "အရှေ့ဝင်ပေါက်မှာပါ၊ အဖြူရောင်ကား မြင်လား။"
            }
          ],
          "alternatives": [],
          "source_ref": "06.03.01-补06",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S009",
          "text": "车牌尾号是多少？",
          "meaning_my": "ကားနံပါတ်ပြားရဲ့ နောက်ဆုံးဂဏန်းတွေက ဘာတွေလဲ။",
          "replies": [
            {
              "id": "06.03.01-S009_reply01",
              "text": "车牌后四位是六七八九。",
              "meaning_my": "ကားနံပါတ်ရဲ့ နောက်ဆုံးလေးလုံးက ခြောက်၊ ခုနစ်၊ ရှစ်၊ ကိုး။"
            }
          ],
          "alternatives": [
            {
              "id": "06.03.01-S009_alt01",
              "text": "车牌后四位是多少？",
              "meaning_my": "ကားနံပါတ်ရဲ့ နောက်ဆုံးလေးလုံးက ဘာတွေလဲ။"
            }
          ],
          "source_ref": "06.03.01-S006",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "safety",
              "text": "上车前先核对平台显示的车牌号、车型和订单，避免坐错车；手机尾号也可能用于核实订单。",
              "text_my": "ကားမတက်ခင် အက်ပ်ထဲမှာ ပြထားတဲ့ ကားနံပါတ်၊ ကားအမျိုးအစားနဲ့ အော်ဒါကို တိုက်စစ်ပါ။ တချို့ဝန်ဆောင်မှုမှာ ဖုန်းနံပါတ် နောက်ဆုံးဂဏန်းတွေနဲ့လည်း စစ်တတ်တယ်။"
            }
          ]
        },
        {
          "id": "06.03.01-S010",
          "text": "我在东门等你。",
          "meaning_my": "အရှေ့ဝင်ပေါက်မှာ စောင့်နေမယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-S008",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S011",
          "text": "我在东门，不是西门。",
          "meaning_my": "အရှေ့ဝင်ပေါက်မှာပါ၊ အနောက်ဝင်ပေါက် မဟုတ်ဘူး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-S011",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S012",
          "text": "我在路口等你。",
          "meaning_my": "လမ်းဆုံမှာ စောင့်နေမယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-S012",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S013",
          "text": "我在公交站旁边等你。",
          "meaning_my": "ဘတ်စ်ကားမှတ်တိုင်ဘေးမှာ စောင့်နေမယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-S015",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S014",
          "text": "我在马路对面。",
          "meaning_my": "လမ်းတစ်ဖက်ကမ်းမှာ ရှိနေတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-S016",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S015",
          "text": "我站在便利店门口。",
          "meaning_my": "ကုန်စုံဆိုင် တံခါးဝမှာ ရပ်နေတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-补07",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S016",
          "text": "我穿黑色外套。",
          "meaning_my": "အနက်ရောင် အပေါ်အင်္ကျီ ဝတ်ထားတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-补08",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S017",
          "text": "你能开到门口吗？",
          "meaning_my": "တံခါးဝအထိ မောင်းလာပေးလို့ရမလား။",
          "replies": [
            {
              "id": "06.03.01-S017_reply01",
              "text": "不好意思，得去指定上车点。",
              "meaning_my": "အားနာပါတယ်၊ သတ်မှတ်ထားတဲ့ ကားတက်နေရာကို လာပေးပါဦး။"
            }
          ],
          "alternatives": [],
          "source_ref": "06.03.01-S010",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S018",
          "text": "能停到路边吗？",
          "meaning_my": "လမ်းဘေးမှာ ရပ်ပေးလို့ရမလား။",
          "replies": [
            {
              "id": "06.03.01-S018_reply01",
              "text": "这里不能停车。",
              "meaning_my": "ဒီနေရာမှာ ကားရပ်လို့မရဘူး။"
            }
          ],
          "alternatives": [],
          "source_ref": "06.03.01-补10",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S019",
          "text": "麻烦打一下双闪，我好找车。",
          "meaning_my": "ကားအရေးပေါ်မီးနှစ်ဖက် ဖွင့်ပေးပါဦး၊ ကားကို ရှာလို့လွယ်အောင်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-补09",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "“打双闪”指打开车辆危险警告闪光灯，用于让人辨认车辆；司机应根据道路情况和当地交通规则决定是否使用。",
              "text_my": "“打双闪” ဆိုတာ ကားရဲ့ အရေးပေါ်သတိပေးမီးနှစ်ဖက် ဖွင့်တာပါ။ ယာဉ်မောင်းက လမ်းအခြေအနေနဲ့ စည်းကမ်းအတိုင်း သုံးသင့်ပါတယ်။"
            }
          ]
        },
        {
          "id": "06.03.01-S020",
          "text": "麻烦往前开一点。",
          "meaning_my": "ရှေ့ကို နည်းနည်း မောင်းလာပေးပါဦး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-S017",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S021",
          "text": "我马上到上车点。",
          "meaning_my": "ကားတက်တဲ့နေရာ ရောက်တော့မယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-补12",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S022",
          "text": "你等我两分钟。",
          "meaning_my": "နှစ်မိနစ်လောက် စောင့်ပေးပါဦး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-补13",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S023",
          "text": "司机取消订单了，怎么办？",
          "meaning_my": "ယာဉ်မောင်းက အော်ဒါ ဖျက်လိုက်ပြီ၊ ဘယ်လိုလုပ်ရမလဲ။",
          "replies": [
            {
              "id": "06.03.01-S023_reply01",
              "text": "可以重新叫一辆车。",
              "meaning_my": "ကားတစ်စီး ထပ်ခေါ်လို့ရတယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "06.03.01-S002",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.03.01-S024",
          "text": "取消订单要收费吗？",
          "meaning_my": "အော်ဒါဖျက်ရင် အခကြေးငွေ ပေးရမလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "06.03.01-补15",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        }
      ]
    },
    {
      "id": "06.03.02",
      "title": "上车确认",
      "title_my": "ကားတက်ချိန် အတည်ပြုခြင်း",
      "phrase_count": 14,
      "phrases": [
        {
          "id": "06.03.02-S001",
          "text": "师傅，您接的是我这单吗？",
          "meaning_my": "ဆရာ၊ ဒီအော်ဒါကို လက်ခံထားတာလား။",
          "replies": [
            {
              "id": "06.03.02-S001_reply01",
              "text": "对，请先核对一下车牌号。",
              "meaning_my": "ဟုတ်တယ်၊ ကားနံပါတ်ကို အရင် တိုက်စစ်ကြည့်ပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "06.03.02-S001_alt01",
              "text": "这是我叫的车吗？",
              "meaning_my": "ဒါ ခေါ်ထားတဲ့ကားလား။"
            }
          ],
          "source_ref": "06.03.02-S016",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "“师傅”是对司机常见的礼貌称呼；“这单”指当前网约车订单。",
