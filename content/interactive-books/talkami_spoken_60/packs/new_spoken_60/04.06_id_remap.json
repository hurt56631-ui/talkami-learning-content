    },
    {
      "source_ref": "user_addition_04.06.03_N15",
      "id": "04.06.03-S016",
      "text": "能给我加个杯盖吗？"
    },
    {
      "source_ref": "user_addition_04.06.03_N11",
      "id": "04.06.03-S017",
      "text": "这杯不是我的。"
    },
    {
      "source_ref": "user_addition_04.06.03_N12",
      "id": "04.06.03-S018",
      "text": "我点的是少冰，不是正常冰。"
    },
    {
      "source_ref": "user_addition_04.06.03_N13",
      "id": "04.06.03-S019",
      "text": "我点的是热的，不是冰的。"
    },
    {
      "source_ref": "user_addition_04.06.03_N14",
      "id": "04.06.03-S020",
      "text": "能帮我重新做一杯吗？"
    },
    {
      "source_ref": "user_addition_04.06.03_N18",
      "id": "04.06.03-S021",
      "text": "外带袋子要收费吗？"
    },
    {
      "source_ref": "user_addition_04.06.01_N20",
      "id": "04.06.03-S022",
      "text": "杯盖能帮我盖紧点吗？"
