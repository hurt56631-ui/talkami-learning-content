      "text": "甜度可以选吗？"
    },
    {
      "source_ref": "user_original_04.06.02_O002",
      "id": "04.06.02-S004",
      "text": "我要半糖。"
    },
    {
      "source_ref": "user_addition_04.06.02_N04",
      "id": "04.06.02-S005",
      "text": "我要三分糖。"
    },
    {
      "source_ref": "user_original_04.06.02_O010",
      "id": "04.06.02-S006",
      "text": "少糖。"
    },
    {
      "source_ref": "user_original_04.06.02_O027",
      "id": "04.06.02-S007",
      "text": "可以做无糖的吗？"
    },
    {
      "source_ref": "user_addition_04.06.02_N03",
      "id": "04.06.02-S008",
      "text": "我要全糖。"
    },
    {
      "source_ref": "user_original_04.06.02_O003",
      "id": "04.06.02-S009",
      "text": "我要少冰。"
    },
    {
      "source_ref": "user_original_04.06.02_O011",
      "id": "04.06.02-S010",
      "text": "去冰。"
    },
    {
      "source_ref": "user_original_04.06.02_O012",
      "id": "04.06.02-S011",
      "text": "正常冰。"
    },
    {
      "source_ref": "user_original_04.06.02_O026",
