      "text": "可以改成外带吗？"
    },
    {
      "source_ref": "user_original_04.06.03_O005",
      "id": "04.06.03-S005",
      "text": "我来取咖啡。"
    },
    {
      "source_ref": "user_original_04.06.03_O004",
