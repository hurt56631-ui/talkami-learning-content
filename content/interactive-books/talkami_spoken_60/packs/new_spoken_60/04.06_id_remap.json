      "text": "可以多加点冰吗？"
    },
    {
      "source_ref": "user_original_04.06.02_O004",
      "id": "04.06.02-S013",
      "text": "帮我加珍珠。"
    },
    {
      "source_ref": "user_original_04.06.02_O025",
      "id": "04.06.02-S014",
      "text": "珍珠能少放点吗？"
