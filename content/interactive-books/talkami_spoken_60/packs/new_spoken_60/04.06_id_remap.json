    {
      "source_ref": "user_addition_04.06.01_N14",
      "id": "04.06.01-S021",
      "text": "可以加一份浓缩吗？"
    },
    {
      "source_ref": "user_addition_04.06.01_N17",
      "id": "04.06.01-S022",
      "text": "可以做无咖啡因的吗？"
    },
    {
      "source_ref": "user_addition_04.06.02_N02",
