      "text": "这杯不要太烫。"
    },
    {
      "source_ref": "user_original_04.06.01_O018",
      "id": "04.06.01-S015",
      "text": "不要加太多冰。"
    },
    {
      "source_ref": "user_addition_04.06.01_N15",
      "id": "04.06.01-S016",
      "text": "可以换燕麦奶吗？"
    },
    {
      "source_ref": "user_original_04.06.01_O019",
      "id": "04.06.01-S017",
      "text": "换燕麦奶要加钱吗？"
    },
    {
      "source_ref": "user_addition_04.06.01_N16",
      "id": "04.06.01-S018",
      "text": "有豆奶吗？"
    },
    {
      "source_ref": "user_original_04.06.01_O020",
      "id": "04.06.01-S019",
      "text": "我要热拿铁，不加糖。"
    },
    {
      "source_ref": "user_original_04.06.01_O021",
      "id": "04.06.01-S020",
      "text": "这款咖啡苦吗？"
