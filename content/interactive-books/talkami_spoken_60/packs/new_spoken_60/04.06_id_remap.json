      "id": "04.06.01-S004",
      "text": "我要一杯卡布奇诺。"
    },
    {
      "source_ref": "user_addition_04.06.01_N04",
      "id": "04.06.01-S005",
      "text": "我要一杯摩卡。"
    },
    {
      "source_ref": "user_original_04.06.01_O004",
      "id": "04.06.01-S006",
      "text": "中杯就行。"
    },
    {
      "source_ref": "user_addition_04.06.01_N07",
      "id": "04.06.01-S007",
      "text": "我要冰的。"
    },
    {
      "source_ref": "user_addition_04.06.01_N08",
      "id": "04.06.01-S008",
      "text": "我要热的。"
    },
    {
      "source_ref": "user_original_04.06.01_O005",
      "id": "04.06.01-S009",
      "text": "大杯多少钱？"
    },
    {
      "source_ref": "user_original_04.06.01_O006",
      "id": "04.06.01-S010",
      "text": "有小杯吗？"
    },
    {
      "source_ref": "user_original_04.06.01_O009",
      "id": "04.06.01-S011",
      "text": "大杯比中杯贵多少钱？"
    },
    {
      "source_ref": "user_original_04.06.01_O010",
      "id": "04.06.01-S012",
      "text": "能换成大杯吗？"
    },
    {
      "source_ref": "user_original_04.06.01_O011",
