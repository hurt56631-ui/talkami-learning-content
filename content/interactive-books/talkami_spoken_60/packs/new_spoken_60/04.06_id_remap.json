      "text": "这杯要少糖少冰。"
    },
    {
      "source_ref": "user_original_04.06.02_O024",
      "id": "04.06.02-S025",
      "text": "这杯要中杯的。"
    },
    {
      "source_ref": "user_addition_04.06.02_N17",
      "id": "04.06.02-S026",
      "text": "可以做成温的吗？"
    },
    {
      "source_ref": "user_addition_04.06.03_N01",
      "id": "04.06.03-S001",
      "text": "堂食还是外带？"
