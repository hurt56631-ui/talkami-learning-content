          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "priority": "core",
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "source_ref": "user_provided_05.05.01_007"
        },
        {
          "id": "05.05.01-S008",
          "text": "收款人是你吗？",
          "meaning_my": "ငွေလက်ခံမယ့်သူက ခင်ဗျားပဲလား။",
          "replies": [
            {
              "id": "05.05.01-S008_reply01",
              "text": "对，请再核对一下店名。",
              "meaning_my": "ဟုတ်ပါတယ်၊ ဆိုင်နာမည်ကို ထပ်စစ်ကြည့်ပါဦး။"
            }
          ],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "priority": "core",
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "source_ref": "user_provided_05.05.01_008",
          "notes": [
            {
              "type": "usage",
              "text": "付款前核对店名、收款人及金额；不要泄漏付款密码。",
              "text_my": "ငွေမရှင်းခင် ဆိုင်နာမည်၊ ငွေလက်ခံသူနဲ့ ငွေပမာဏ စစ်ပါ။ စကားဝှက် မပေးပါနဲ့။"
            }
          ]
        },
        {
          "id": "05.05.01-S009",
          "text": "收款人名字对吗？",
          "meaning_my": "ငွေလက်ခံသူနာမည် မှန်ရဲ့လား။",
          "replies": [],
