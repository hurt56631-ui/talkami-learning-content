              "meaning_my": "ရပါတယ်၊ WeChat Pay ရော Alipay ရော သုံးလို့ရတယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "05.05.01-S001_alt01",
              "text": "可以用微信吗？",
              "meaning_my": "WeChat နဲ့ ပေးလို့ရလား။"
            }
          ],
          "pinyin": null,
          "phonetic_my": null,
