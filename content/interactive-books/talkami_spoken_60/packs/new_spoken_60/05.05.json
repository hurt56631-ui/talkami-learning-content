      "phrase_count": 14,
      "phrases": [
        {
          "id": "05.05.02-S001",
          "text": "我只有一张一百的。",
          "meaning_my": "ကျွန်တော့်မှာ ယွမ်တစ်ရာတန် တစ်ရွက်ပဲ ရှိတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
