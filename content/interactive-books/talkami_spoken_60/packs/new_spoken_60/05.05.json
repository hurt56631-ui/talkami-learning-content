          "priority": "core",
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "source_ref": "user_provided_05.05.01_002"
        },
        {
          "id": "05.05.01-S003",
          "text": "我扫这个收款码吗？",
          "meaning_my": "ဒီငွေလက်ခံ QR ကုဒ်ကို စကန်ဖတ်ရမှာလား။",
          "replies": [
            {
              "id": "05.05.01-S003_reply01",
              "text": "不用，我扫您的付款码。",
              "meaning_my": "မလိုပါဘူး၊ ခင်ဗျားရဲ့ ငွေပေးချေမှုကုဒ်ကို စကန်ဖတ်ပေးမယ်။"
            }
          ],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "priority": "core",
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "source_ref": "user_provided_05.05.01_003",
          "notes": [
            {
              "type": "usage",
              "text": "收款码由商家展示；付款码由顾客向收银员展示。",
              "text_my": "“收款码” က ဆိုင်ငွေလက်ခံကုဒ်၊ “付款码” က ဝယ်သူက ငွေပေးဖို့ ပြတဲ့ကုဒ်ပါ။"
            }
          ]
        },
        {
          "id": "05.05.01-S004",
          "text": "要出示付款码吗？",
          "meaning_my": "ငွေပေးချေမှုကုဒ်ကို ဖွင့်ပြရမလား။",
          "replies": [
            {
              "id": "05.05.01-S004_reply01",
              "text": "对，请打开付款码。",
              "meaning_my": "ဟုတ်ပါတယ်၊ ငွေပေးချေမှုကုဒ် ဖွင့်ပြပေးပါ။"
            }
          ],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "priority": "core",
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "source_ref": "user_provided_05.05.01_004"
        },
        {
          "id": "05.05.01-S005",
          "text": "扫我的付款码吧。",
          "meaning_my": "ကျွန်တော့် ငွေပေးချေမှုကုဒ်ကို စကန်ဖတ်ပေးပါ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "priority": "core",
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "source_ref": "user_provided_05.05.01_005"
        },
        {
          "id": "05.05.01-S006",
          "text": "钱收到了吗？",
          "meaning_my": "ငွေ ဝင်ပြီးပြီလား။",
          "replies": [
            {
              "id": "05.05.01-S006_reply01",
              "text": "收到了，谢谢。",
              "meaning_my": "ငွေဝင်ပါပြီ၊ ကျေးဇူးပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "05.05.01-S006_alt01",
              "text": "到账了吗？",
              "meaning_my": "ငွေဝင်ပြီးပြီလား။"
            }
          ],
          "pinyin": null,
          "phonetic_my": null,
          "priority": "core",
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "source_ref": "user_provided_05.05.01_006"
        },
        {
          "id": "05.05.01-S007",
          "text": "这个金额不对。",
          "meaning_my": "ဒီငွေပမာဏ မမှန်ဘူး။",
          "replies": [
            {
              "id": "05.05.01-S007_reply01",
              "text": "先别付，我重新核对。",
              "meaning_my": "အရင် ငွေမရှင်းပါနဲ့ဦး၊ ပြန်စစ်ပေးမယ်။"
