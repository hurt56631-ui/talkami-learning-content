  "mapping": [
    {
      "source_ref": "user_original_04.03.01_O015",
      "id": "04.03.01-S001",
      "text": "几位？"
    },
    {
      "source_ref": "user_original_04.03.01_O001",
      "id": "04.03.01-S002",
      "text": "两位。"
    },
    {
      "source_ref": "user_original_04.03.01_O003",
      "id": "04.03.01-S003",
      "text": "有位置吗？"
    },
    {
      "source_ref": "user_original_04.03.01_O007",
      "id": "04.03.01-S004",
      "text": "要排队吗？"
    },
    {
      "source_ref": "user_original_04.03.01_O006",
      "id": "04.03.01-S005",
      "text": "等位要等多久？"
    },
    {
      "source_ref": "user_addition_04.03.01_N01",
      "id": "04.03.01-S006",
      "text": "取号机在哪儿？"
    },
    {
      "source_ref": "user_addition_04.03.01_N02",
      "id": "04.03.01-S007",
      "text": "怎么取号？"
    },
    {
      "source_ref": "user_addition_04.03.01_N04",
      "id": "04.03.01-S008",
      "text": "前面还有几桌？"
    },
    {
      "source_ref": "user_addition_04.03.01_N05",
      "id": "04.03.01-S009",
      "text": "过号了怎么办？"
    },
    {
      "source_ref": "editorial_new_04.03.01_M01",
      "id": "04.03.01-S010",
      "text": "排到我们了吗？"
    },
    {
      "source_ref": "user_addition_04.03.01_N07",
      "id": "04.03.01-S011",
      "text": "有空位叫我一声。"
    },
    {
      "source_ref": "user_original_04.03.01_O012",
      "id": "04.03.01-S012",
      "text": "我们三个人。"
    },
    {
      "source_ref": "user_original_04.03.01_O016",
      "id": "04.03.01-S013",
      "text": "有预约吗？"
    },
    {
      "source_ref": "editorial_new_04.03.01_M02",
      "id": "04.03.01-S014",
      "text": "我订了位。"
    },
    {
      "source_ref": "user_original_04.03.01_O008",
      "id": "04.03.01-S015",
      "text": "我们还有一个人没到。"
    },
    {
      "source_ref": "user_original_04.03.01_O014",
      "id": "04.03.01-S016",
      "text": "我们都到齐了。"
    },
    {
      "source_ref": "user_original_04.03.01_O009",
      "id": "04.03.01-S017",
      "text": "可以先进去等吗？"
    },
    {
      "source_ref": "user_original_04.03.01_O026",
      "id": "04.03.01-S018",
      "text": "可以坐这张桌子吗？"
    },
    {
      "source_ref": "user_addition_04.03.01_N09",
      "id": "04.03.01-S019",
      "text": "这桌有人吗？"
    },
    {
      "source_ref": "user_original_04.03.01_O005",
      "id": "04.03.01-S020",
      "text": "我们想坐靠窗的位置。"
    },
    {
      "source_ref": "user_original_04.03.01_O004",
      "id": "04.03.01-S021",
      "text": "可以坐里面吗？"
    },
    {
      "source_ref": "user_addition_04.03.01_N13",
      "id": "04.03.01-S022",
      "text": "有包间吗？"
    },
    {
      "source_ref": "user_original_04.03.01_O013",
      "id": "04.03.01-S023",
      "text": "可以拼桌吗？"
    },
    {
      "source_ref": "user_original_04.03.01_O011",
      "id": "04.03.01-S024",
      "text": "可以加一把椅子吗？"
    },
    {
      "source_ref": "user_original_04.03.01_O027",
      "id": "04.03.01-S025",
      "text": "可以换个安静点的位置吗？"
    },
    {
      "source_ref": "user_original_04.03.01_O028",
      "id": "04.03.01-S026",
      "text": "有儿童椅吗？"
    },
    {
      "source_ref": "user_original_04.03.01_O025",
      "id": "04.03.01-S027",
      "text": "可以等人到齐再点菜吗？"
    },
    {
      "source_ref": "user_addition_04.03.01_N12",
      "id": "04.03.01-S028",
      "text": "可以换张大桌吗？"
    },
    {
      "source_ref": "user_addition_04.03.01_N14",
      "id": "04.03.01-S029",
      "text": "包间有最低消费吗？"
    },
    {
      "source_ref": "user_original_04.03.02_O001",
      "id": "04.03.02-S001",
      "text": "菜单在哪儿？"
    },
    {
      "source_ref": "user_original_04.03.02_O002",
      "id": "04.03.02-S002",
      "text": "要扫码点菜吗？"
    },
    {
      "source_ref": "user_original_04.03.02_O013",
      "id": "04.03.02-S003",
      "text": "能给我一份纸质菜单吗？"
    },
    {
      "source_ref": "user_original_04.03.02_O003",
      "id": "04.03.02-S004",
      "text": "这是什么菜？"
    },
    {
      "source_ref": "user_original_04.03.02_O005",
      "id": "04.03.02-S005",
      "text": "这道菜有什么配料？"
    },
    {
      "source_ref": "user_addition_04.03.02_N02",
      "id": "04.03.02-S006",
      "text": "这个是什么肉？"
    },
    {
      "source_ref": "user_original_04.03.02_O004",
      "id": "04.03.02-S007",
      "text": "这道菜里面有肉吗？"
    },
    {
      "source_ref": "user_original_04.03.02_O008",
      "id": "04.03.02-S008",
      "text": "菜单有图片吗？"
    },
    {
      "source_ref": "user_original_04.03.02_O014",
      "id": "04.03.02-S009",
      "text": "这个菜单我看不懂。"
    },
    {
      "source_ref": "user_addition_04.03.02_N17",
      "id": "04.03.02-S010",
      "text": "这个和那个有什么区别？"
    },
    {
      "source_ref": "user_addition_04.03.02_N06",
      "id": "04.03.02-S011",
      "text": "这个怎么做的？"
    },
    {
      "source_ref": "user_addition_04.03.02_N07",
      "id": "04.03.02-S012",
      "text": "是炒的还是煮的？"
    },
    {
      "source_ref": "user_original_04.03.02_O007",
      "id": "04.03.02-S013",
      "text": "这个菜怎么吃？"
    },
    {
      "source_ref": "user_addition_04.03.02_N09",
      "id": "04.03.02-S014",
      "text": "有什么汤？"
    },
    {
      "source_ref": "user_addition_04.03.02_N11",
      "id": "04.03.02-S015",
      "text": "有甜点吗？"
    },
    {
      "source_ref": "user_addition_04.03.02_N14",
      "id": "04.03.02-S016",
      "text": "有饮料单吗？"
    },
    {
      "source_ref": "user_addition_04.03.02_N13",
      "id": "04.03.02-S017",
      "text": "这个含酒精吗？"
    },
    {
      "source_ref": "user_original_04.03.02_O009",
      "id": "04.03.02-S018",
      "text": "有素菜吗？"
    },
    {
      "source_ref": "user_original_04.03.02_O018",
      "id": "04.03.02-S019",
      "text": "有清淡点的菜吗？"
    },
    {
      "source_ref": "user_addition_04.03.02_N18",
      "id": "04.03.02-S020",
      "text": "这个里面放香菜吗？"
    },
    {
      "source_ref": "user_addition_04.03.02_N10",
      "id": "04.03.02-S021",
      "text": "这是凉菜还是热菜？"
    },
    {
      "source_ref": "user_original_04.03.02_O015",
      "id": "04.03.02-S022",
      "text": "这道菜是现做的吗？"
    },
    {
      "source_ref": "user_original_04.03.03_O001",
      "id": "04.03.03-S001",
      "text": "我要一份这个。"
    },
    {
      "source_ref": "user_addition_04.03.03_N01",
      "id": "04.03.03-S002",
      "text": "这个来两份。"
    },
    {
      "source_ref": "user_original_04.03.03_O002",
      "id": "04.03.03-S003",
      "text": "两碗米饭。"
    },
    {
      "source_ref": "user_original_04.03.03_O003",
      "id": "04.03.03-S004",
      "text": "来一壶茶。"
    },
    {
      "source_ref": "user_original_04.03.03_O011",
      "id": "04.03.03-S005",
      "text": "我要一瓶水。"
    },
    {
      "source_ref": "user_original_04.03.03_O008",
      "id": "04.03.03-S006",
      "text": "再来一盘青菜。"
    },
    {
      "source_ref": "user_original_04.03.03_O004",
      "id": "04.03.03-S007",
      "text": "再加一个菜。"
    },
    {
      "source_ref": "user_original_04.03.03_O009",
      "id": "04.03.03-S008",
      "text": "有套餐吗？"
    },
    {
      "source_ref": "user_original_04.03.03_O018",
      "id": "04.03.03-S009",
      "text": "就这些，麻烦了。"
    },
    {
      "source_ref": "user_original_04.03.03_O007",
      "id": "04.03.03-S010",
      "text": "这道菜先不要。"
    },
    {
      "source_ref": "user_original_04.03.03_O014",
      "id": "04.03.03-S011",
      "text": "这道菜能换成别的吗？"
    },
    {
      "source_ref": "user_original_04.03.03_O015",
      "id": "04.03.03-S012",
      "text": "米饭可以免费续吗？"
    },
    {
      "source_ref": "user_addition_04.03.03_N14",
      "id": "04.03.03-S013",
      "text": "再来一碗米饭。"
    },
    {
      "source_ref": "user_addition_04.03.03_N16",
      "id": "04.03.03-S014",
      "text": "有纸巾吗？"
    },
    {
      "source_ref": "user_addition_04.03.03_N17",
      "id": "04.03.03-S015",
      "text": "有牙签吗？"
    },
    {
      "source_ref": "user_addition_04.03.03_N05",
      "id": "04.03.03-S016",
      "text": "米饭先上。"
    },
    {
      "source_ref": "user_addition_04.03.03_N06",
      "id": "04.03.03-S017",
      "text": "菜一起上。"
    },
    {
      "source_ref": "user_addition_04.03.03_N07",
      "id": "04.03.03-S018",
      "text": "汤最后上。"
    },
    {
      "source_ref": "editorial_new_04.03.03_M01",
      "id": "04.03.03-S019",
      "text": "菜什么时候能上？"
    },
    {
      "source_ref": "user_addition_04.03.03_N09",
      "id": "04.03.03-S020",
      "text": "能快点上菜吗？"
    },
    {
      "source_ref": "user_addition_04.03.03_N10",
      "id": "04.03.03-S021",
      "text": "我们的菜还没上。"
    },
    {
      "source_ref": "user_addition_04.03.03_N11",
      "id": "04.03.03-S022",
      "text": "帮我催一下菜。"
    },
    {
      "source_ref": "editorial_new_04.03.03_M02",
      "id": "04.03.03-S023",
      "text": "我们点的菜上齐了吗？"
    },
    {
      "source_ref": "editorial_new_04.03.03_M03",
      "id": "04.03.03-S024",
      "text": "我们没点这个。"
    },
    {
      "source_ref": "user_addition_04.03.03_N12",
      "id": "04.03.03-S025",
      "text": "这道菜不要了。"
    },
    {
      "source_ref": "user_addition_04.03.03_N13",
      "id": "04.03.03-S026",
      "text": "这道菜还没做的话，可以取消吗？"
    },
    {
      "source_ref": "user_original_04.03.03_O013",
      "id": "04.03.03-S027",
      "text": "还要加菜吗？"
    },
    {
      "source_ref": "user_addition_04.03.03_N18",
      "id": "04.03.03-S028",
      "text": "剩下的菜能打包吗？"
    }
  ]
}
