          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.02.03-S003",
          "text": "请问是王师傅吗？",
          "meaning_my": "တဆိတ်လောက်၊ ဆရာဝမ်လား။",
          "replies": [],
          "alternatives": [],
