          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.02.03-S004",
          "text": "现在方便说话吗？",
          "meaning_my": "အခု ဖုန်းပြောဖို့ အဆင်ပြေလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.02.03_B002",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.02.03-S005",
          "text": "我现在不方便，晚点打给你。",
          "meaning_my": "အခု အဆင်မပြေလို့ နောက်မှ ဖုန်းပြန်ဆက်မယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.02.03_B003",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.02.03-S006",
          "text": "你给我打电话吧。",
          "meaning_my": "ဖုန်းဆက်ပေးပါ။",
          "replies": [],
          "alternatives": [],
