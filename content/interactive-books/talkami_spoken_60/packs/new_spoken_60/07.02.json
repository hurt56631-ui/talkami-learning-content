          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.02.03-S007",
          "text": "刚才没接到你的电话。",
          "meaning_my": "ခုနက ဖုန်းဆက်တာ မကိုင်လိုက်ရဘူး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.02.03_B010",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.02.03-S008",
          "text": "你听得到吗？",
          "meaning_my": "အသံ ကြားရလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_07.02.03_B006",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.02.03-S009",
          "text": "我听不到你说话。",
          "meaning_my": "ပြောတာ မကြားရဘူး။",
          "replies": [],
          "alternatives": [],
