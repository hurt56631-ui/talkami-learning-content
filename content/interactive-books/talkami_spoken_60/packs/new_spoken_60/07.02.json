          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "07.02.03-S002",
          "text": "请问您是哪位？",
          "meaning_my": "တဆိတ်လောက်၊ ဘယ်သူဆက်တာပါလဲ။",
          "replies": [],
