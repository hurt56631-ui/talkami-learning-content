    {
      "id": "07.02.03",
      "title": "电话沟通",
      "title_my": "ဖုန်းပြောဆိုခြင်း",
      "phrase_count": 26,
      "phrases": [
        {
          "id": "07.02.03-S001",
          "text": "喂，你好。",
          "meaning_my": "ဟယ်လို၊ မင်္ဂလာပါ။",
          "replies": [],
          "alternatives": [],
