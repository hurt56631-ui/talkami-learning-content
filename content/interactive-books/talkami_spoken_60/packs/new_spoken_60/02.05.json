  "scenes": [
    {
      "id": "02.05.01",
      "title": "询问物品位置",
      "title_my": "ပစ္စည်းဘယ်မှာရှိလဲ မေးခြင်း",
      "phrase_count": 30,
      "original_count": 19,
      "added_count": 11,
      "phrases": [
        {
          "id": "02.05.01-S001",
          "text": "我的手机在哪儿？",
          "meaning_my": "ဖုန်း ဘယ်မှာလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S002",
          "text": "钥匙呢？",
          "meaning_my": "သော့ကရော။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S003",
          "text": "你看到我的包了吗？",
          "meaning_my": "အိတ်ကို မြင်မိလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S004",
          "text": "在桌上吗？",
          "meaning_my": "စားပွဲပေါ်မှာလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S005",
          "text": "抽屉里有吗？",
          "meaning_my": "အံဆွဲထဲမှာ ရှိလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S006",
          "text": "帮我找一下。",
          "meaning_my": "နည်းနည်း ကူရှာပေးပါ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S007",
          "text": "我还是找不到。",
          "meaning_my": "ရှာမတွေ့သေးဘူး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S008",
          "text": "你再想想最后放哪儿了。",
          "meaning_my": "နောက်ဆုံး ဘယ်မှာထားခဲ့လဲ ပြန်စဉ်းစားကြည့်ဦး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S009",
          "text": "是不是放柜子里了？",
          "meaning_my": "ဗီရိုထဲမှာ ထားခဲ့တာလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S010",
          "text": "没有，柜子里也没有。",
          "meaning_my": "မရှိဘူး၊ ဗီရိုထဲမှာလည်း မရှိဘူး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S011",
          "text": "我记得放在这里了。",
          "meaning_my": "ဒီမှာ ထားခဲ့တယ်လို့ မှတ်မိတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S012",
          "text": "是不是在外套口袋里？",
          "meaning_my": "အပေါ်အင်္ကျီအိတ်ကပ်ထဲမှာများ ရှိနေလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S013",
          "text": "在你包里。",
          "meaning_my": "ခင်ဗျား အိတ်ထဲမှာ ရှိတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S014",
          "text": "我没看到。",
          "meaning_my": "မမြင်မိဘူး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S015",
          "text": "好像在抽屉里。",
          "meaning_my": "အံဆွဲထဲမှာ ထင်တယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S016",
          "text": "你把包再翻一遍。",
          "meaning_my": "အိတ်ကို နောက်တစ်ခေါက် သေချာရှာကြည့်ပါ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S017",
          "text": "我进店的时候手机还在。",
          "meaning_my": "ဆိုင်ထဲဝင်တုန်းက ဖုန်းရှိသေးတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S018",
          "text": "我的背包找不到了。",
          "meaning_my": "ကျောပိုးအိတ် ရှာမတွေ့တော့ဘူး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S019",
          "text": "床底下找过了吗？",
          "meaning_my": "ကုတင်အောက်မှာ ရှာကြည့်ပြီးပြီလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S020",
          "text": "你放哪儿了？",
          "meaning_my": "ဘယ်မှာ ထားခဲ့တာလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S021",
          "text": "是不是在沙发上？",
          "meaning_my": "ဆိုဖာပေါ်မှာ ရှိနေလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S022",
          "text": "椅子下面找找。",
          "meaning_my": "ကုလားထိုင်အောက်မှာ ရှာကြည့်ပါဦး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S023",
          "text": "门后面有没有？",
          "meaning_my": "တံခါးနောက်မှာ ရှိလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S024",
          "text": "是不是掉地上了？",
          "meaning_my": "ကြမ်းပြင်ပေါ် ကျသွားတာလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S025",
          "text": "在这儿呢。",
          "meaning_my": "ဒီမှာ ရှိတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S026",
          "text": "找到了！",
          "meaning_my": "ရှာတွေ့ပြီ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S027",
          "text": "就在你手边。",
          "meaning_my": "ခင်ဗျား လက်နားမှာတင်ပဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S028",
          "text": "包里找过了吗？",
          "meaning_my": "အိတ်ထဲမှာ ရှာကြည့်ပြီးပြီလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S029",
          "text": "我的耳机去哪儿了？",
          "meaning_my": "နားကြပ် ဘယ်ရောက်သွားလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.01-S030",
          "text": "我再仔细找找。",
          "meaning_my": "သေချာ ထပ်ရှာကြည့်ဦးမယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        }
      ]
    },
    {
      "id": "02.05.02",
      "title": "丢失遗忘",
      "title_my": "ပစ္စည်းပျောက်ခြင်းနှင့် မေ့ကျန်ခြင်း",
      "phrase_count": 34,
      "original_count": 22,
      "added_count": 12,
      "phrases": [
        {
          "id": "02.05.02-S001",
          "text": "我手机丢了。",
          "meaning_my": "ဖုန်း ပျောက်သွားပြီ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S002",
          "text": "我找不到钥匙。",
          "meaning_my": "သော့ ရှာမတွေ့ဘူး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S003",
          "text": "再看看包里有没有。",
          "meaning_my": "အိတ်ထဲမှာ ရှိမရှိ ထပ်ကြည့်ပါဦး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S004",
          "text": "我忘带钱包了。",
          "meaning_my": "ပိုက်ဆံအိတ် ယူလာဖို့ မေ့သွားတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S005",
          "text": "我回去找找。",
          "meaning_my": "ပြန်သွားရှာကြည့်မယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S006",
          "text": "钱包不见了。",
          "meaning_my": "ပိုက်ဆံအိတ် ပျောက်နေပြီ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S007",
          "text": "先想想可能落在哪儿了。",
          "meaning_my": "ဘယ်မှာ ကျန်ခဲ့နိုင်လဲ အရင်စဉ်းစားကြည့်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S008",
          "text": "我到处都找过了。",
          "meaning_my": "နေရာအနှံ့ ရှာပြီးပြီ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S009",
          "text": "好像落在店里了。",
          "meaning_my": "ဆိုင်မှာ ကျန်ခဲ့တာထင်တယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S010",
          "text": "可能忘在公司了。",
          "meaning_my": "ကုမ္ပဏီမှာ မေ့ကျန်ခဲ့တာလည်း ဖြစ်နိုင်တယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S011",
          "text": "我去刚才那家店问问。",
          "meaning_my": "ခုနက ဆိုင်ကို သွားမေးကြည့်မယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S012",
          "text": "里面还有证件。",
          "meaning_my": "အဲဒီထဲမှာ သက်သေခံစာရွက်စာတမ်းတွေလည်း ပါတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S013",
          "text": "你最后在哪儿用的？",
          "meaning_my": "နောက်ဆုံး ဘယ်မှာ သုံးခဲ့တာလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S014",
          "text": "是不是落在店里了？",
          "meaning_my": "ဆိုင်မှာ ကျန်ခဲ့တာလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.05.02-S015",
          "text": "给我的手机打个电话试试。",
          "meaning_my": "ပျောက်နေတဲ့ ဖုန်းကို တစ်ချက် ဆက်ကြည့်ပေးပါဦး။",
