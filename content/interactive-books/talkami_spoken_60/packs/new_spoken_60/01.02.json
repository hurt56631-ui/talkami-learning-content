      "phrases": [
        {
          "id": "01.02.01-S001",
          "text": "谢谢。",
          "meaning_my": "ကျေးဇူးတင်ပါတယ်။",
          "replies": [
            {
              "id": "01.02.01-S001_reply01",
              "text": "不客气。",
              "meaning_my": "ရပါတယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "01.02.01-S001_alt01",
              "text": "谢谢你。",
              "meaning_my": "ကျေးဇူးတင်ပါတယ်နော်။"
            }
          ]
        },
        {
          "id": "01.02.01-S002",
          "text": "太感谢了。",
          "meaning_my": "အရမ်းကျေးဇူးတင်ပါတယ်။",
          "replies": [
            {
              "id": "01.02.01-S002_reply01",
              "text": "不用客气，能帮上忙就好。",
              "meaning_my": "အားမနာပါနဲ့၊ ကူညီပေးနိုင်တာပဲ ဝမ်းသာပါတယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "01.02.01-S002_alt01",
              "text": "真是太谢谢了。",
              "meaning_my": "တကယ် ကျေးဇူးအများကြီးတင်ပါတယ်။"
            }
          ]
        },
        {
          "id": "01.02.01-S003",
          "text": "麻烦你了。",
          "meaning_my": "အလုပ်ရှုပ်စေမိပြီနော်၊ ကျေးဇူးပါ။",
          "replies": [
            {
              "id": "01.02.01-S003_reply01",
              "text": "不麻烦，没事。",
              "meaning_my": "မရှုပ်ပါဘူး၊ ရပါတယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "01.02.01-S003_alt01",
              "text": "麻烦你帮忙了。",
              "meaning_my": "ကူညီပေးရလို့ အလုပ်ရှုပ်သွားပြီနော်။"
            }
          ],
          "notes": [
            {
              "type": "usage",
              "text": "“麻烦你了”常用于别人帮忙前后，既可以表示客气，也可以表达感谢，不一定是真的造成严重麻烦。",
              "text_my": "“麻烦你了” က တစ်ဖက်လူကို အကူအညီတောင်းတဲ့အခါ၊ ကူညီပေးပြီးတဲ့အခါ ပြောတတ်တဲ့ ယဉ်ကျေးစကားပါ။ တကယ် ဒုက္ခကြီးပေးမိတယ်လို့ အမြဲ မဆိုလိုပါဘူး။"
            }
          ]
        },
        {
          "id": "01.02.01-S004",
          "text": "辛苦了。",
          "meaning_my": "ပင်ပန်းသွားပြီနော်။",
          "replies": [
            {
              "id": "01.02.01-S004_reply01",
              "text": "没事，应该的。",
              "meaning_my": "ရပါတယ်၊ လုပ်ပေးရမှာပါပဲ။"
            }
          ],
          "alternatives": [
            {
              "id": "01.02.01-S004_alt01",
              "text": "辛苦你了。",
              "meaning_my": "ပင်ပန်းသွားပြီနော်။"
            }
          ],
          "notes": [
            {
              "type": "culture",
              "text": "“辛苦了”通常是认可对方付出的客气话，不等于对方生病了。",
              "text_my": "“辛苦了” က တစ်ဖက်လူ ကြိုးစားလုပ်ပေးတာကို အသိအမှတ်ပြုပြီး ပြောတာပါ။ နေမကောင်းတာကို ဆိုလိုတာ မဟုတ်ဘူး။"
            }
          ]
        },
        {
          "id": "01.02.01-S005",
          "text": "不客气。",
          "meaning_my": "ရပါတယ်။",
          "replies": [],
          "alternatives": [
            {
              "id": "01.02.01-S005_alt01",
              "text": "别客气。",
              "meaning_my": "အားမနာပါနဲ့။"
            }
