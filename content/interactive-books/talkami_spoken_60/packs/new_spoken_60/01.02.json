  "scenes": [
    {
      "id": "01.02.01",
      "title": "感谢与回应",
      "title_my": "ကျေးဇူးတင်ခြင်းနှင့် ပြန်ဖြေခြင်း",
      "phrase_count": 27,
      "original_count": 17,
      "added_count": 10,
      "phrases": [
        {
          "id": "01.02.01-S001",
          "text": "谢谢。",
          "meaning_my": "ကျေးဇူးတင်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S002",
          "text": "太感谢了。",
          "meaning_my": "အရမ်းကျေးဇူးတင်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S003",
          "text": "麻烦你了。",
          "meaning_my": "အလုပ်ရှုပ်စေမိပြီနော်၊ ကျေးဇူးပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S004",
          "text": "辛苦了。",
          "meaning_my": "ပင်ပန်းသွားပြီနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S005",
          "text": "不客气。",
          "meaning_my": "ရပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S006",
          "text": "不用谢。",
          "meaning_my": "ကျေးဇူးတင်စရာ မလိုပါဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S007",
          "text": "谢谢你提醒我。",
          "meaning_my": "သတိပေးလို့ ကျေးဇူးတင်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S008",
          "text": "谢谢你等我。",
          "meaning_my": "စောင့်ပေးလို့ ကျေးဇူးတင်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S009",
          "text": "我也刚到，没等多久。",
          "meaning_my": "အခုမှပဲ ရောက်တာပါ၊ အကြာကြီး မစောင့်ရပါဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S010",
          "text": "这次多亏你了。",
          "meaning_my": "ဒီတစ်ခါ ခင်ဗျားကူညီပေးလို့ အဆင်ပြေသွားတာ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S011",
          "text": "辛苦你跑这一趟了。",
          "meaning_my": "တကူးတက လာပေးရလို့ ပင်ပန်းသွားပြီနော်၊ ကျေးဇူးတင်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S012",
          "text": "应该的。",
          "meaning_my": "ဒါက လုပ်ပေးရမှာပါပဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S013",
          "text": "那我就不客气了。",
          "meaning_my": "ဒါဆို အားမနာတော့ဘူးနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S014",
          "text": "您辛苦了。",
          "meaning_my": "ပင်ပန်းသွားပြီနော်၊ ကျေးဇူးတင်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S015",
          "text": "谢谢，今天帮大忙了。",
          "meaning_my": "ဒီနေ့ အများကြီး ကူညီပေးလို့ ကျေးဇူးအများကြီးတင်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S016",
          "text": "顺手的事，别客气。",
          "meaning_my": "လက်စနဲ့ ကူပေးတာပါ၊ အားမနာပါနဲ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S017",
          "text": "改天请你吃饭。",
          "meaning_my": "နောက်နေ့ကျ ထမင်းဝယ်ကျွေးမယ်နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S018",
          "text": "谢啦。",
          "meaning_my": "ကျေးဇူးနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S019",
          "text": "谢谢你的礼物。",
          "meaning_my": "လက်ဆောင်ပေးလို့ ကျေးဇူးတင်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S020",
          "text": "谢谢招待。",
          "meaning_my": "ဧည့်ခံပေးလို့ ကျေးဇူးတင်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S021",
          "text": "下次我帮你。",
          "meaning_my": "နောက်တစ်ခါကျ ကူညီပေးမယ်နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S022",
          "text": "你太客气了。",
          "meaning_my": "ဒီလောက် အားနာစရာ မလိုပါဘူးနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S023",
          "text": "小事，不用谢。",
          "meaning_my": "ကိစ္စသေးသေးလေးပါ၊ ကျေးဇူးတင်စရာ မလိုပါဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S024",
          "text": "有需要再找我。",
          "meaning_my": "လိုအပ်ရင် ထပ်ပြောနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S025",
          "text": "谢谢你送我。",
          "meaning_my": "လိုက်ပို့ပေးလို့ ကျေးဇူးတင်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S026",
          "text": "不用麻烦了，谢谢。",
          "meaning_my": "ဒုက္ခမခံပါနဲ့တော့၊ ကျေးဇူးပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.01-S027",
          "text": "今天谢谢你请客。",
          "meaning_my": "ဒီနေ့ ကျွေးမွေးလို့ ကျေးဇူးတင်ပါတယ်။",
          "replies": [],
          "alternatives": []
        }
      ]
    },
    {
      "id": "01.02.02",
      "title": "道歉、补救与回应",
      "title_my": "တောင်းပန်ခြင်း၊ ပြန်လည်ပြင်ဆင်ခြင်းနှင့် ပြန်ဖြေခြင်း",
      "phrase_count": 28,
      "original_count": 15,
      "added_count": 13,
      "phrases": [
        {
          "id": "01.02.02-S001",
          "text": "没关系。",
          "meaning_my": "ရပါတယ်၊ ကိစ္စမရှိပါဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S002",
          "text": "不好意思，我来晚了。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ နောက်ကျသွားလို့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S003",
          "text": "是我弄错了。",
          "meaning_my": "ကိုယ့်ဘက်က မှားသွားတာပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S004",
          "text": "不好意思，我忘了。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ မေ့သွားလို့ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S005",
          "text": "对不起。",
          "meaning_my": "တောင်းပန်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S006",
          "text": "我马上处理。",
          "meaning_my": "အခုချက်ချင်း ဖြေရှင်းပေးပါမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S007",
          "text": "我把时间记错了。",
          "meaning_my": "အချိန်ကို မှားမှတ်ထားမိတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S008",
          "text": "没事，我们重新约个时间。",
          "meaning_my": "ရပါတယ်၊ အချိန်အသစ် ပြန်ချိန်းကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S009",
          "text": "不好意思，我拿错东西了。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ ပစ္စည်းမှားယူမိလို့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S010",
          "text": "对不起，耽误你时间了。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ အချိန်ကုန်စေမိလို့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S011",
          "text": "我这就改。",
          "meaning_my": "အခုချက်ချင်း ပြင်လိုက်မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S012",
          "text": "下次我会注意。",
          "meaning_my": "နောက်တစ်ခါ သတိထားပါမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S013",
          "text": "不好意思，给你添麻烦了。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ အလုပ်ရှုပ်စေမိလို့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S014",
          "text": "刚才是我说错了。",
          "meaning_my": "ခုနက ပြောမှားသွားတာပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S015",
          "text": "别往心里去。",
          "meaning_my": "စိတ်ထဲ မထားပါနဲ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S016",
          "text": "真不好意思。",
          "meaning_my": "တကယ် အားနာပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S017",
          "text": "我不是故意的。",
          "meaning_my": "တမင် လုပ်တာ မဟုတ်ပါဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S018",
          "text": "是我没注意。",
          "meaning_my": "သတိမထားမိတာပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S019",
          "text": "下次不会了。",
          "meaning_my": "နောက်တစ်ခါ ဒီလို မဖြစ်တော့ပါဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S020",
          "text": "我赔给你。",
          "meaning_my": "လျော်ပေးပါမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S021",
          "text": "别生气了。",
          "meaning_my": "စိတ်မဆိုးပါနဲ့တော့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S022",
          "text": "算了，没事。",
          "meaning_my": "ထားလိုက်ပါ၊ ကိစ္စမရှိပါဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S023",
          "text": "下次注意就好。",
          "meaning_my": "နောက်တစ်ခါ သတိထားရင် ရပါပြီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S024",
          "text": "不好意思，我没听清。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ သေချာ မကြားလိုက်လို့ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S025",
          "text": "不好意思，发错了。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ မှားပို့မိလို့ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S026",
          "text": "抱歉，回复晚了。",
          "meaning_my": "စာပြန်တာ နောက်ကျသွားလို့ တောင်းပန်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S027",
          "text": "不好意思，让你久等了。",
          "meaning_my": "အကြာကြီး စောင့်ခိုင်းမိလို့ တောင်းပန်ပါတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.02-S028",
          "text": "不好意思，打错电话了。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ ဖုန်းမှားခေါ်မိလို့ပါ။",
          "replies": [],
          "alternatives": []
        }
      ]
    },
    {
      "id": "01.02.03",
      "title": "礼貌开口与回应",
      "title_my": "ယဉ်ယဉ်ကျေးကျ စကားစခြင်းနှင့် ပြန်ဖြေခြင်း",
      "phrase_count": 23,
      "original_count": 12,
      "added_count": 11,
      "phrases": [
        {
          "id": "01.02.03-S001",
          "text": "请问一下。",
          "meaning_my": "တစ်ခုလောက် မေးပါရစေ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S002",
          "text": "打扰一下。",
          "meaning_my": "တစ်ဆိတ်လောက်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S003",
          "text": "现在方便吗？",
          "meaning_my": "အခု ပြောလို့ အဆင်ပြေလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S004",
          "text": "现在不太方便，晚点可以吗？",
          "meaning_my": "အခု သိပ်မအားသေးဘူး၊ နောက်မှ ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S005",
          "text": "借过一下。",
          "meaning_my": "နည်းနည်းလောက် လမ်းဖယ်ပေးပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S006",
          "text": "能问个问题吗？",
          "meaning_my": "မေးခွန်းတစ်ခု မေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S007",
          "text": "请进。",
          "meaning_my": "ဝင်ခဲ့ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S008",
          "text": "请问，这个位子有人吗？",
          "meaning_my": "တစ်ဆိတ်လောက်၊ ဒီခုံမှာ ထိုင်မယ့်သူ ရှိလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S009",
          "text": "不好意思，我能进来吗？",
          "meaning_my": "တောင်းပန်ပါတယ်၊ အထဲဝင်လို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S010",
          "text": "请问，洗手间在哪儿？",
          "meaning_my": "တစ်ဆိတ်လောက်၊ အိမ်သာ ဘယ်မှာလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S011",
          "text": "请稍等。",
          "meaning_my": "ခဏစောင့်ပေးပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S012",
          "text": "有什么事吗？",
          "meaning_my": "ဘာကိစ္စရှိလို့လဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S013",
          "text": "能帮我个忙吗？",
          "meaning_my": "တစ်ခုလောက် ကူညီပေးလို့ ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S014",
          "text": "麻烦你帮我看一下。",
          "meaning_my": "တစ်ချက်လောက် ကြည့်ပေးပါဦး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S015",
          "text": "我在找这个地方。",
          "meaning_my": "ဒီနေရာကို ရှာနေတာပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S016",
          "text": "请问怎么走？",
          "meaning_my": "ဘယ်လိုသွားရမလဲ မေးပါရစေ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S017",
          "text": "能借我支笔吗？",
          "meaning_my": "ဘောပင်တစ်ချောင်း ခဏငှားလို့ ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S018",
          "text": "不打扰你了。",
          "meaning_my": "မနှောင့်ယှက်တော့ပါဘူးနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S019",
          "text": "可以再说一遍吗？",
          "meaning_my": "နောက်တစ်ခေါက် ထပ်ပြောပေးလို့ ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S020",
          "text": "我说清楚了吗？",
          "meaning_my": "ခုနက ပြောတာ ရှင်းရဲ့လား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S021",
          "text": "我能坐这儿吗？",
          "meaning_my": "ဒီမှာ ထိုင်လို့ ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S022",
          "text": "能帮我拍张照吗？",
          "meaning_my": "ဓာတ်ပုံတစ်ပုံလောက် ရိုက်ပေးလို့ ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.02.03-S023",
          "text": "你先请。",
          "meaning_my": "အရင်သွားပါဦး။",
          "replies": [],
          "alternatives": []
        }
      ]
    }
