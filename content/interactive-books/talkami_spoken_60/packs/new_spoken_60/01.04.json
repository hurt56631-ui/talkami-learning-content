  "scenes": [
    {
      "id": "01.04.01",
      "title": "询问名称、用途与回应",
      "title_my": "အမည်၊ အသုံးပြုပုံ မေးမြန်းခြင်းနှင့် ပြန်ဖြေခြင်း",
      "phrase_count": 19,
      "original_count": 11,
      "added_count": 8,
      "phrases": [
        {
          "id": "01.04.01-S001",
          "text": "这是什么？",
          "meaning_my": "ဒါဘာလဲ။",
          "replies": [
            {
              "id": "01.04.01-S001_reply01",
              "text": "这是充电器。",
              "meaning_my": "ဒါ အားသွင်းစက်ပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S001_alt01",
              "text": "这是啥？",
              "meaning_my": "ဒါဘာလဲ။"
            }
          ]
        },
        {
          "id": "01.04.01-S002",
          "text": "这个叫什么？",
          "meaning_my": "ဒါကို ဘယ်လိုခေါ်လဲ။",
          "replies": [
            {
              "id": "01.04.01-S002_reply01",
              "text": "这个叫充电宝。",
              "meaning_my": "ဒါကို ပါဝါဘဏ်လို့ ခေါ်တယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S002_alt01",
              "text": "这东西叫什么？",
              "meaning_my": "ဒီပစ္စည်းကို ဘယ်လိုခေါ်လဲ။"
            }
          ]
        },
        {
          "id": "01.04.01-S003",
          "text": "这是干什么用的？",
          "meaning_my": "ဒါကို ဘာအတွက် သုံးတာလဲ။",
          "replies": [
            {
              "id": "01.04.01-S003_reply01",
              "text": "这是用来充电的。",
              "meaning_my": "ဒါက အားသွင်းဖို့ သုံးတာပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S003_alt01",
              "text": "这东西是做什么的？",
              "meaning_my": "ဒီပစ္စည်းက ဘာလုပ်ဖို့လဲ။"
            }
          ],
          "notes": [
            {
              "type": "usage",
              "text": "“干什么用的”是问用途，不是问谁来做。",
              "text_my": "“干什么用的” က ဘာအတွက် အသုံးပြုတာလဲဆိုတာ မေးတာပါ။ ဘယ်သူလုပ်တာလဲလို့ မေးတာ မဟုတ်ဘူး။"
            }
          ]
        },
        {
          "id": "01.04.01-S004",
          "text": "这个怎么用？",
          "meaning_my": "ဒါကို ဘယ်လိုသုံးရလဲ။",
          "replies": [
            {
              "id": "01.04.01-S004_reply01",
              "text": "先按这个按钮。",
              "meaning_my": "အရင် ဒီခလုတ်ကို နှိပ်ပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S004_alt01",
              "text": "这个要怎么用？",
              "meaning_my": "ဒါကို ဘယ်လိုသုံးရမလဲ။"
            }
          ]
        },
        {
          "id": "01.04.01-S005",
          "text": "这个用中文怎么说？",
          "meaning_my": "ဒါကို တရုတ်လို ဘယ်လိုပြောလဲ။",
          "replies": [
            {
              "id": "01.04.01-S005_reply01",
              "text": "中文叫雨伞。",
              "meaning_my": "တရုတ်လို 雨伞 လို့ ခေါ်တယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S005_alt01",
              "text": "这个中文叫什么？",
              "meaning_my": "ဒါကို တရုတ်လို ဘယ်လိုခေါ်လဲ။"
            }
          ],
          "notes": [
            {
              "type": "usage",
              "text": "“用中文怎么说”是请教中文表达；“这个叫什么”主要问名称，不能总当成同一句。",
              "text_my": "“用中文怎么说” က တရုတ်လို ဘယ်လိုပြောလဲလို့ မေးတာ၊ “叫什么” က နာမည်ကို မေးတာပါ။"
            }
          ]
        },
        {
          "id": "01.04.01-S006",
          "text": "这个字怎么读？",
          "meaning_my": "ဒီတရုတ်စာလုံးကို ဘယ်လိုအသံထွက်ရလဲ။",
          "replies": [
            {
              "id": "01.04.01-S006_reply01",
              "text": "我读给你听。",
              "meaning_my": "ဖတ်ပြပေးမယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S006_alt01",
              "text": "这个字怎么念？",
              "meaning_my": "ဒီတရုတ်စာလုံးကို ဘယ်လိုဖတ်ရလဲ။"
            }
          ],
          "notes": [
            {
              "type": "usage",
              "text": "“怎么读”问发音，“怎么写”问写法，两者不要混淆。",
              "text_my": "“怎么读” က ဘယ်လိုဖတ်ရလဲလို့ မေးတာ၊ “怎么写” က ဘယ်လိုရေးရလဲလို့ မေးတာပါ။"
            }
          ]
        },
        {
          "id": "01.04.01-S007",
          "text": "这个和那个有什么区别？",
          "meaning_my": "ဒီနှစ်ခု ဘာကွာလဲ။",
          "replies": [
            {
              "id": "01.04.01-S007_reply01",
              "text": "这个便宜一点。",
              "meaning_my": "ဒီဟာက နည်းနည်း ပိုဈေးသက်သာတယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S007_alt01",
              "text": "这俩有什么不同？",
              "meaning_my": "ဒီနှစ်ခု ဘာကွာလဲ။"
            }
          ],
          "notes": [
            {
              "type": "usage",
              "text": "问区别时可比较大小、价格、用途，不一定只是外观不同。",
              "text_my": "ကွာခြားချက် မေးတဲ့အခါ အရွယ်အစား၊ ဈေးနှုန်း၊ အသုံးပြုပုံ စတာတွေကို နှိုင်းယှဉ်နိုင်တယ်။"
            }
          ]
        },
        {
          "id": "01.04.01-S008",
          "text": "用缅语怎么说？",
          "meaning_my": "မြန်မာလို ဘယ်လိုပြောလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.04.01-S009",
          "text": "这两个一样吗？",
          "meaning_my": "ဒီနှစ်ခု တူလား။",
          "replies": [
            {
              "id": "01.04.01-S009_reply01",
              "text": "不一样，大小不同。",
              "meaning_my": "မတူဘူး၊ အရွယ်အစား မတူဘူး။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S009_alt01",
              "text": "这俩一样吗？",
              "meaning_my": "ဒီနှစ်ခု တူလား။"
            }
          ]
        },
        {
          "id": "01.04.01-S010",
          "text": "不一样，这个大一点。",
          "meaning_my": "မတူဘူး၊ ဒါက နည်းနည်း ပိုကြီးတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.04.01-S011",
          "text": "这个怎么打开？",
          "meaning_my": "ဒါကို ဘယ်လိုဖွင့်ရလဲ။",
          "replies": [
            {
              "id": "01.04.01-S011_reply01",
              "text": "往这边拉就开了。",
              "meaning_my": "ဒီဘက်ကို ဆွဲလိုက်ရင် ပွင့်ပြီ။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S011_alt01",
              "text": "怎么把它打开？",
              "meaning_my": "ဒါကို ဘယ်လိုဖွင့်ရမလဲ။"
            }
          ]
        },
        {
          "id": "01.04.01-S012",
          "text": "这个是什么意思？",
          "meaning_my": "ဒါက ဘာအဓိပ္ပာယ်လဲ။",
          "replies": [
            {
              "id": "01.04.01-S012_reply01",
              "text": "就是不能进去的意思。",
              "meaning_my": "အထဲဝင်လို့မရဘူးဆိုတဲ့ အဓိပ္ပာယ်ပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S012_alt01",
              "text": "这是什么意思？",
              "meaning_my": "ဒါ ဘာအဓိပ္ပာယ်လဲ။"
            }
          ]
        },
        {
          "id": "01.04.01-S013",
          "text": "这个怎么关？",
          "meaning_my": "ဒါကို ဘယ်လိုပိတ်ရလဲ။",
          "replies": [
            {
              "id": "01.04.01-S013_reply01",
              "text": "按一下这里就关了。",
              "meaning_my": "ဒီနေရာကို တစ်ချက်နှိပ်လိုက်ရင် ပိတ်သွားမယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S013_alt01",
              "text": "怎么把它关掉？",
              "meaning_my": "ဒါကို ဘယ်လိုပိတ်ရမလဲ။"
            }
          ]
        },
        {
          "id": "01.04.01-S014",
          "text": "这个怎么弄？",
          "meaning_my": "ဒါကို ဘယ်လိုလုပ်ရလဲ။",
          "replies": [
            {
              "id": "01.04.01-S014_reply01",
              "text": "我做给你看。",
              "meaning_my": "လုပ်ပြပေးမယ်။"
            }
          ],
          "alternatives": []
        },
        {
          "id": "01.04.01-S015",
          "text": "这个能吃吗？",
          "meaning_my": "ဒါကို စားလို့ရလား။",
          "replies": [
            {
              "id": "01.04.01-S015_reply01",
              "text": "可以吃，但要煮熟。",
              "meaning_my": "စားလို့ရတယ်၊ ဒါပေမဲ့ ကျက်အောင် ချက်ရမယ်။"
            }
          ],
          "alternatives": []
        },
        {
          "id": "01.04.01-S016",
          "text": "这个还能用吗？",
          "meaning_my": "ဒါကို သုံးလို့ရသေးလား။",
          "replies": [
            {
              "id": "01.04.01-S016_reply01",
              "text": "可以，还能用。",
              "meaning_my": "ရတယ်၊ သုံးလို့ရသေးတယ်။"
            }
          ],
          "alternatives": [],
          "notes": [
            {
              "type": "usage",
              "text": "“还能用吗”问现在是否仍可使用，不一定是问怎么使用。",
              "text_my": "“还能用吗” က အခုထိ သုံးလို့ရသေးလားလို့ မေးတာပါ။ ဘယ်လိုသုံးရလဲလို့ မေးတာ မဟုတ်ဘူး။"
            }
          ]
        },
        {
          "id": "01.04.01-S017",
          "text": "这个坏了吗？",
          "meaning_my": "ဒါ ပျက်သွားပြီလား။",
          "replies": [
            {
              "id": "01.04.01-S017_reply01",
              "text": "没坏，是没电了。",
              "meaning_my": "မပျက်ဘူး၊ အားကုန်သွားတာ။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S017_alt01",
              "text": "是不是坏了？",
              "meaning_my": "ပျက်သွားတာလား။"
            }
          ]
        },
        {
          "id": "01.04.01-S018",
          "text": "这里写的是什么？",
          "meaning_my": "ဒီမှာ ဘာရေးထားတာလဲ။",
          "replies": [
            {
              "id": "01.04.01-S018_reply01",
              "text": "这里写的是电话号码。",
              "meaning_my": "ဒီမှာ ဖုန်းနံပါတ် ရေးထားတာပါ။"
            }
          ],
          "alternatives": []
        },
        {
          "id": "01.04.01-S019",
          "text": "要按哪个按钮？",
          "meaning_my": "ဘယ်ခလုတ်ကို နှိပ်ရမလဲ။",
          "replies": [
            {
              "id": "01.04.01-S019_reply01",
              "text": "按左边这个。",
              "meaning_my": "ဘယ်ဘက်က ဒီခလုတ်ကို နှိပ်ပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.01-S019_alt01",
              "text": "点哪个？",
              "meaning_my": "ဘယ်ဟာကို နှိပ်ရမလဲ။"
            }
          ]
        }
      ]
    },
    {
      "id": "01.04.02",
      "title": "问路、指路与回应",
      "title_my": "လမ်းမေးခြင်း၊ လမ်းညွှန်ခြင်းနှင့် ပြန်ဖြေခြင်း",
      "phrase_count": 31,
      "original_count": 18,
      "added_count": 13,
      "phrases": [
        {
          "id": "01.04.02-S001",
          "text": "厕所在哪儿？",
          "meaning_my": "အိမ်သာ ဘယ်မှာလဲ။",
          "replies": [
            {
              "id": "01.04.02-S001_reply01",
              "text": "往前走，左手边就是。",
              "meaning_my": "ရှေ့တည့်တည့်သွား၊ ဘယ်ဘက်မှာပဲ။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.02-S001_alt01",
              "text": "洗手间在哪儿？",
              "meaning_my": "အိမ်သာ ဘယ်မှာလဲ။"
            }
          ]
        },
        {
          "id": "01.04.02-S002",
          "text": "往哪边走？",
          "meaning_my": "ဘယ်ဘက်ကို သွားရမလဲ။",
          "replies": [
            {
              "id": "01.04.02-S002_reply01",
              "text": "往左边走。",
              "meaning_my": "ဘယ်ဘက်ကို သွားပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.02-S002_alt01",
              "text": "往哪儿走？",
              "meaning_my": "ဘယ်ဘက်ကို သွားရမလဲ။"
            }
          ],
          "notes": [
            {
              "type": "usage",
              "text": "“往哪边走”是在问方向；左边是左，右边是右，不能混淆。",
              "text_my": "“往哪边走” က ဘယ်ဘက်ကို သွားရမလဲလို့ မေးတာပါ။ ဘယ်ဘက်နဲ့ ညာဘက် မမှားဖို့ သတိထားပါ။"
            }
          ]
        },
        {
          "id": "01.04.02-S003",
          "text": "去车站怎么走？",
          "meaning_my": "ကားဂိတ်ကို ဘယ်လိုသွားရမလဲ။",
          "replies": [
            {
              "id": "01.04.02-S003_reply01",
              "text": "直走到路口再右转。",
              "meaning_my": "လမ်းဆုံအထိ တည့်တည့်သွားပြီး ညာဘက်ကွေ့ပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "01.04.02-S003_alt01",
              "text": "车站怎么走？",
              "meaning_my": "ကားဂိတ်ကို ဘယ်လိုသွားရမလဲ။"
            }
          ]
        },
        {
          "id": "01.04.02-S004",
          "text": "先下楼，再往右走。",
          "meaning_my": "အရင် အောက်ဆင်းပြီး ညာဘက်ကို သွားပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.04.02-S005",
          "text": "在这边吗？",
          "meaning_my": "ဒီဘက်မှာလား။",
          "replies": [
            {
              "id": "01.04.02-S005_reply01",
              "text": "对，就在这边。",
              "meaning_my": "ဟုတ်တယ်၊ ဒီဘက်မှာပဲ။"
            }
          ],
          "alternatives": []
        },
        {
          "id": "01.04.02-S006",
          "text": "楼上还是楼下？",
          "meaning_my": "အပေါ်ထပ်လား၊ အောက်ထပ်လား။",
          "replies": [
            {
              "id": "01.04.02-S006_reply01",
              "text": "在楼上，三楼。",
              "meaning_my": "အပေါ်ထပ်မှာ၊ တတိယထပ်ပါ။"
            }
          ],
          "alternatives": []
        },
        {
          "id": "01.04.02-S007",
          "text": "附近有便利店吗？",
