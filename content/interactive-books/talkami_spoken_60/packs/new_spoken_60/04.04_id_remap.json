{
  "theme_id": "04.04",
  "original_main_candidates": 64,
  "addition_candidates": 54,
  "current_main": 58,
  "mapping": [
    {
      "source_ref": "user_addition_04.04.01_N01",
      "id": "04.04.01-S001",
      "text": "我们的菜呢？"
    },
    {
      "source_ref": "user_original_04.04.01_O003",
      "id": "04.04.01-S002",
      "text": "这道菜还要多久？"
    },
    {
      "source_ref": "user_original_04.04.01_O005",
      "id": "04.04.01-S003",
      "text": "是不是漏单了？"
    },
    {
      "source_ref": "user_original_04.04.01_O006",
      "id": "04.04.01-S004",
      "text": "这道菜下单了吗？"
    },
    {
      "source_ref": "user_addition_04.04.01_N02",
      "id": "04.04.01-S005",
      "text": "炒饭还没来。"
    },
    {
      "source_ref": "user_addition_04.04.01_N10",
      "id": "04.04.01-S006",
      "text": "还有一道没上。"
    },
    {
      "source_ref": "user_original_04.04.01_O018",
      "id": "04.04.01-S007",
      "text": "我们等得有点久了。"
    },
    {
      "source_ref": "user_original_04.04.01_O008",
      "id": "04.04.01-S008",
      "text": "后面点的菜都上了。"
    },
    {
      "source_ref": "user_original_04.04.01_O007",
      "id": "04.04.01-S009",
      "text": "我们赶时间。"
    },
    {
      "source_ref": "user_original_04.04.01_O009",
      "id": "04.04.01-S010",
      "text": "能先上这道吗？"
    },
    {
      "source_ref": "user_original_04.04.01_O017",
      "id": "04.04.01-S011",
      "text": "这道菜还没开始做吗？"
    },
    {
      "source_ref": "user_addition_04.04.01_N12",
      "id": "04.04.01-S012",
      "text": "饮料先上吧。"
    },
    {
      "source_ref": "user_original_04.04.02_O001",
      "id": "04.04.02-S001",
      "text": "麻烦加点水。"
    },
    {
      "source_ref": "user_original_04.04.02_O002",
      "id": "04.04.02-S002",
      "text": "麻烦拿双筷子。"
    },
    {
      "source_ref": "user_original_04.04.02_O003",
      "id": "04.04.02-S003",
      "text": "给我一个勺子。"
    },
    {
      "source_ref": "user_original_04.04.02_O005",
      "id": "04.04.02-S004",
      "text": "纸巾在哪里？"
    },
    {
      "source_ref": "user_original_04.04.02_O006",
      "id": "04.04.02-S005",
      "text": "这个碗能换一下吗？"
    },
    {
      "source_ref": "user_original_04.04.02_O007",
      "id": "04.04.02-S006",
      "text": "有公筷吗？"
    },
    {
      "source_ref": "user_original_04.04.02_O008",
      "id": "04.04.02-S007",
      "text": "再来一壶热水。"
    },
    {
      "source_ref": "user_original_04.04.02_O009",
      "id": "04.04.02-S008",
      "text": "能给我一把叉子吗？"
    },
    {
      "source_ref": "user_original_04.04.02_O011",
      "id": "04.04.02-S009",
      "text": "给我两个小碗。"
    },
    {
      "source_ref": "user_original_04.04.02_O012",
      "id": "04.04.02-S010",
      "text": "纸巾用完了。"
    },
    {
      "source_ref": "user_original_04.04.02_O013",
      "id": "04.04.02-S011",
      "text": "我不太会用筷子。"
    },
    {
      "source_ref": "user_original_04.04.02_O017",
      "id": "04.04.02-S012",
      "text": "麻烦拿个空盘子。"
    },
    {
      "source_ref": "user_original_04.04.02_O019",
      "id": "04.04.02-S013",
      "text": "能帮我加点热水吗？"
    },
    {
      "source_ref": "user_original_04.04.02_O020",
      "id": "04.04.02-S014",
      "text": "能给我一个干净的杯子吗？"
    },
    {
      "source_ref": "user_original_04.04.02_O021",
      "id": "04.04.02-S015",
      "text": "有一次性筷子吗？"
    },
    {
      "source_ref": "user_original_04.04.02_O022",
      "id": "04.04.02-S016",
      "text": "筷子掉地上了，麻烦换一双。"
    },
    {
      "source_ref": "user_original_04.04.02_O023",
      "id": "04.04.02-S017",
      "text": "能再拿点纸巾吗？"
    },
    {
      "source_ref": "user_addition_04.04.02_N05",
      "id": "04.04.02-S018",
      "text": "给个小碟子。"
    },
    {
      "source_ref": "user_addition_04.04.02_N07",
      "id": "04.04.02-S019",
      "text": "有湿巾吗？"
    },
    {
      "source_ref": "user_addition_04.04.02_N09",
      "id": "04.04.02-S020",
      "text": "有儿童餐具吗？"
    },
    {
      "source_ref": "user_addition_04.04.02_N10",
      "id": "04.04.02-S021",
      "text": "筷子不够。"
    },
    {
      "source_ref": "user_addition_04.04.02_N12",
      "id": "04.04.02-S022",
      "text": "这个杯子有点脏。"
    },
    {
      "source_ref": "user_addition_04.04.02_N13",
      "id": "04.04.02-S023",
      "text": "麻烦给点冰块。"
    },
    {
      "source_ref": "user_addition_04.04.02_N14",
      "id": "04.04.02-S024",
      "text": "有吸管吗？"
    },
    {
      "source_ref": "user_addition_04.04.02_N15",
      "id": "04.04.02-S025",
      "text": "能帮我拿个打包盒吗？"
    },
    {
      "source_ref": "user_addition_04.04.02_N17",
      "id": "04.04.02-S026",
      "text": "能帮我擦一下桌子吗？"
    },
    {
      "source_ref": "user_original_04.04.03_O001",
      "id": "04.04.03-S001",
      "text": "这个有点凉。"
    },
    {
      "source_ref": "user_original_04.04.03_O003",
      "id": "04.04.03-S002",
      "text": "肉还没熟。"
    },
    {
      "source_ref": "user_original_04.04.03_O004",
      "id": "04.04.03-S003",
      "text": "这个菜上错了。"
    },
    {
      "source_ref": "user_original_04.04.03_O006",
      "id": "04.04.03-S004",
      "text": "可以帮我换一份吗？"
    },
    {
      "source_ref": "user_original_04.04.03_O007",
      "id": "04.04.03-S005",
      "text": "麻烦叫一下经理。"
    },
    {
      "source_ref": "user_original_04.04.03_O009",
      "id": "04.04.03-S006",
      "text": "这个闻起来不太对。"
    },
    {
      "source_ref": "user_original_04.04.03_O010",
      "id": "04.04.03-S007",
      "text": "里面还是冷的。"
    },
    {
      "source_ref": "user_original_04.04.03_O011",
      "id": "04.04.03-S008",
      "text": "能帮我加热一下吗？"
    },
    {
      "source_ref": "user_original_04.04.03_O016",
      "id": "04.04.03-S009",
      "text": "这道菜有问题，可以退吗？"
    },
    {
      "source_ref": "user_original_04.04.03_O018",
      "id": "04.04.03-S010",
      "text": "菜里有异物。"
    },
    {
      "source_ref": "user_original_04.04.03_O020",
      "id": "04.04.03-S011",
      "text": "换菜要另外付钱吗？"
    },
    {
      "source_ref": "user_original_04.04.03_O021",
      "id": "04.04.03-S012",
      "text": "今天的米饭有点硬。"
    },
    {
      "source_ref": "user_original_04.04.03_O022",
      "id": "04.04.03-S013",
      "text": "这个味道有点不对。"
    },
    {
      "source_ref": "user_addition_04.04.03_N06",
      "id": "04.04.03-S014",
      "text": "分量有点少。"
    },
    {
      "source_ref": "user_addition_04.04.03_N07",
      "id": "04.04.03-S015",
      "text": "和图片不一样。"
    },
    {
      "source_ref": "user_addition_04.04.03_N12",
      "id": "04.04.03-S016",
      "text": "菜里有头发。"
    },
    {
      "source_ref": "user_addition_04.04.03_N15",
      "id": "04.04.03-S017",
      "text": "肉有点硬。"
    },
    {
      "source_ref": "user_addition_04.04.03_N17",
      "id": "04.04.03-S018",
      "text": "能重新做一份吗？"
    },
    {
      "source_ref": "user_addition_04.04.03_N20",
      "id": "04.04.03-S019",
      "text": "这种情况能优惠一点吗？"
    },
    {
      "source_ref": "user_addition_04.04.03_N22",
      "id": "04.04.03-S020",
      "text": "我要投诉。"
    }
  ]
}
