  "entries": [
    {
      "id": "02.05.01-S001",
      "kind": "main",
      "cn": "我的手机在哪儿？",
      "meaning_my": "ဖုန်း ဘယ်မှာလဲ။",
      "audio_file": "02.05.01-S001.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S001_reply01",
      "kind": "reply",
      "cn": "刚才还在桌上呢。",
      "meaning_my": "ခုနက စားပွဲပေါ်မှာ ရှိသေးတယ်။",
      "audio_file": "02.05.01-S001_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S001_alt01",
      "kind": "alternative",
      "cn": "我手机放哪儿了？",
      "meaning_my": "ဖုန်း ဘယ်မှာ ထားမိတာလဲ။",
      "audio_file": "02.05.01-S001_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S002",
      "kind": "main",
      "cn": "钥匙呢？",
      "meaning_my": "သော့ကရော။",
      "audio_file": "02.05.01-S002.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S002_reply01",
      "kind": "reply",
      "cn": "在你包里吧。",
      "meaning_my": "ခင်ဗျား အိတ်ထဲမှာ ထင်တယ်။",
      "audio_file": "02.05.01-S002_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S002_alt01",
      "kind": "alternative",
      "cn": "我的钥匙在哪儿？",
      "meaning_my": "သော့ ဘယ်မှာလဲ။",
      "audio_file": "02.05.01-S002_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S003",
      "kind": "main",
      "cn": "你看到我的包了吗？",
      "meaning_my": "အိတ်ကို မြင်မိလား။",
      "audio_file": "02.05.01-S003.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S003_reply01",
      "kind": "reply",
      "cn": "没看到，你再找找。",
      "meaning_my": "မမြင်မိဘူး၊ ထပ်ရှာကြည့်ပါဦး။",
      "audio_file": "02.05.01-S003_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S003_alt01",
      "kind": "alternative",
      "cn": "有没有看到我的包？",
      "meaning_my": "အိတ်ကို မြင်မိသေးလား။",
      "audio_file": "02.05.01-S003_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S004",
      "kind": "main",
      "cn": "在桌上吗？",
      "meaning_my": "စားပွဲပေါ်မှာလား။",
      "audio_file": "02.05.01-S004.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S004_reply01",
      "kind": "reply",
      "cn": "不在，桌上没有。",
      "meaning_my": "မရှိဘူး၊ စားပွဲပေါ်မှာ မရှိဘူး။",
      "audio_file": "02.05.01-S004_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S005",
      "kind": "main",
      "cn": "抽屉里有吗？",
      "meaning_my": "အံဆွဲထဲမှာ ရှိလား။",
      "audio_file": "02.05.01-S005.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S005_reply01",
      "kind": "reply",
      "cn": "有，在最下面。",
      "meaning_my": "ရှိတယ်၊ အောက်ဆုံးမှာ။",
      "audio_file": "02.05.01-S005_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S006",
      "kind": "main",
      "cn": "帮我找一下。",
      "meaning_my": "နည်းနည်း ကူရှာပေးပါ။",
      "audio_file": "02.05.01-S006.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S006_reply01",
      "kind": "reply",
      "cn": "好，一起找吧。",
      "meaning_my": "ကောင်းပြီ၊ အတူ ရှာကြမယ်။",
      "audio_file": "02.05.01-S006_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S006_alt01",
      "kind": "alternative",
      "cn": "帮我一起找找。",
      "meaning_my": "အတူ ကူရှာပေးပါဦး။",
      "audio_file": "02.05.01-S006_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S007",
      "kind": "main",
      "cn": "我还是找不到。",
      "meaning_my": "ရှာမတွေ့သေးဘူး။",
      "audio_file": "02.05.01-S007.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S007_reply01",
      "kind": "reply",
      "cn": "别急，再仔细看看。",
      "meaning_my": "စိတ်မလောနဲ့၊ သေချာ ထပ်ကြည့်ပါ။",
      "audio_file": "02.05.01-S007_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S007_alt01",
      "kind": "alternative",
      "cn": "怎么找都找不到。",
      "meaning_my": "ဘယ်လိုရှာရှာ မတွေ့ဘူး။",
      "audio_file": "02.05.01-S007_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S008",
      "kind": "main",
      "cn": "你再想想最后放哪儿了。",
      "meaning_my": "နောက်ဆုံး ဘယ်မှာထားခဲ့လဲ ပြန်စဉ်းစားကြည့်ဦး။",
      "audio_file": "02.05.01-S008.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S009",
      "kind": "main",
      "cn": "是不是放柜子里了？",
      "meaning_my": "ဗီရိုထဲမှာ ထားခဲ့တာလား။",
      "audio_file": "02.05.01-S009.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S009_reply01",
      "kind": "reply",
      "cn": "没有，柜子里没有。",
      "meaning_my": "မရှိဘူး၊ ဗီရိုထဲမှာ မရှိဘူး။",
      "audio_file": "02.05.01-S009_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S010",
      "kind": "main",
      "cn": "没有，柜子里也没有。",
      "meaning_my": "မရှိဘူး၊ ဗီရိုထဲမှာလည်း မရှိဘူး။",
      "audio_file": "02.05.01-S010.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S011",
      "kind": "main",
      "cn": "我记得放在这里了。",
      "meaning_my": "ဒီမှာ ထားခဲ့တယ်လို့ မှတ်မိတယ်။",
      "audio_file": "02.05.01-S011.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S011_alt01",
      "kind": "alternative",
      "cn": "我明明记得放这儿了。",
      "meaning_my": "ဒီမှာပဲ ထားခဲ့တာ သေချာ မှတ်မိတယ်။",
      "audio_file": "02.05.01-S011_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S012",
      "kind": "main",
      "cn": "是不是在外套口袋里？",
      "meaning_my": "အပေါ်အင်္ကျီအိတ်ကပ်ထဲမှာများ ရှိနေလား။",
      "audio_file": "02.05.01-S012.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S012_reply01",
      "kind": "reply",
      "cn": "找过了，没有。",
      "meaning_my": "ရှာပြီးပြီ၊ မရှိဘူး။",
      "audio_file": "02.05.01-S012_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S013",
      "kind": "main",
      "cn": "在你包里。",
      "meaning_my": "ခင်ဗျား အိတ်ထဲမှာ ရှိတယ်။",
      "audio_file": "02.05.01-S013.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S014",
      "kind": "main",
      "cn": "我没看到。",
      "meaning_my": "မမြင်မိဘူး။",
      "audio_file": "02.05.01-S014.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S015",
      "kind": "main",
      "cn": "好像在抽屉里。",
      "meaning_my": "အံဆွဲထဲမှာ ထင်တယ်။",
      "audio_file": "02.05.01-S015.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S015_alt01",
      "kind": "alternative",
      "cn": "可能在抽屉里。",
      "meaning_my": "အံဆွဲထဲမှာ ရှိနိုင်တယ်။",
      "audio_file": "02.05.01-S015_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S016",
      "kind": "main",
      "cn": "你把包再翻一遍。",
      "meaning_my": "အိတ်ကို နောက်တစ်ခေါက် သေချာရှာကြည့်ပါ။",
      "audio_file": "02.05.01-S016.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S017",
      "kind": "main",
      "cn": "我进店的时候手机还在。",
      "meaning_my": "ဆိုင်ထဲဝင်တုန်းက ဖုန်းရှိသေးတယ်။",
      "audio_file": "02.05.01-S017.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S017_reply01",
      "kind": "reply",
      "cn": "那可能掉在店里了。",
      "meaning_my": "ဒါဆို ဆိုင်ထဲမှာ ကျသွားတာ ဖြစ်နိုင်တယ်။",
      "audio_file": "02.05.01-S017_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S018",
      "kind": "main",
      "cn": "我的背包找不到了。",
      "meaning_my": "ကျောပိုးအိတ် ရှာမတွေ့တော့ဘူး။",
      "audio_file": "02.05.01-S018.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S018_alt01",
      "kind": "alternative",
      "cn": "我的背包不见了。",
      "meaning_my": "ကျောပိုးအိတ် ရှာမတွေ့တော့ဘူး။",
      "audio_file": "02.05.01-S018_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S019",
      "kind": "main",
      "cn": "床底下找过了吗？",
      "meaning_my": "ကုတင်အောက်မှာ ရှာကြည့်ပြီးပြီလား။",
      "audio_file": "02.05.01-S019.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S019_reply01",
      "kind": "reply",
      "cn": "找过了，没找到。",
      "meaning_my": "ရှာပြီးပြီ၊ ရှာမတွေ့ဘူး။",
      "audio_file": "02.05.01-S019_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S020",
      "kind": "main",
      "cn": "你放哪儿了？",
      "meaning_my": "ဘယ်မှာ ထားခဲ့တာလဲ။",
      "audio_file": "02.05.01-S020.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S020_reply01",
      "kind": "reply",
      "cn": "我放桌上了。",
      "meaning_my": "စားပွဲပေါ်မှာ ထားခဲ့တာ။",
      "audio_file": "02.05.01-S020_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S021",
      "kind": "main",
      "cn": "是不是在沙发上？",
      "meaning_my": "ဆိုဖာပေါ်မှာ ရှိနေလား။",
      "audio_file": "02.05.01-S021.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S021_reply01",
      "kind": "reply",
      "cn": "我看看，沙发上没有。",
      "meaning_my": "ကြည့်ဦးမယ်၊ ဆိုဖာပေါ်မှာ မရှိဘူး။",
      "audio_file": "02.05.01-S021_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S022",
      "kind": "main",
      "cn": "椅子下面找找。",
      "meaning_my": "ကုလားထိုင်အောက်မှာ ရှာကြည့်ပါဦး။",
      "audio_file": "02.05.01-S022.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S023",
      "kind": "main",
      "cn": "门后面有没有？",
      "meaning_my": "တံခါးနောက်မှာ ရှိလား။",
      "audio_file": "02.05.01-S023.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S024",
      "kind": "main",
      "cn": "是不是掉地上了？",
      "meaning_my": "ကြမ်းပြင်ပေါ် ကျသွားတာလား။",
      "audio_file": "02.05.01-S024.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S025",
      "kind": "main",
      "cn": "在这儿呢。",
      "meaning_my": "ဒီမှာ ရှိတယ်။",
      "audio_file": "02.05.01-S025.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S025_alt01",
      "kind": "alternative",
      "cn": "找到了，在这里。",
      "meaning_my": "တွေ့ပြီ၊ ဒီမှာ။",
      "audio_file": "02.05.01-S025_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S026",
      "kind": "main",
      "cn": "找到了！",
      "meaning_my": "ရှာတွေ့ပြီ။",
      "audio_file": "02.05.01-S026.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S026_reply01",
      "kind": "reply",
      "cn": "太好了，在哪里找到的？",
      "meaning_my": "ကောင်းလိုက်တာ၊ ဘယ်မှာ ရှာတွေ့တာလဲ။",
      "audio_file": "02.05.01-S026_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S027",
      "kind": "main",
      "cn": "就在你手边。",
      "meaning_my": "ခင်ဗျား လက်နားမှာတင်ပဲ။",
      "audio_file": "02.05.01-S027.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S028",
      "kind": "main",
      "cn": "包里找过了吗？",
      "meaning_my": "အိတ်ထဲမှာ ရှာကြည့်ပြီးပြီလား။",
      "audio_file": "02.05.01-S028.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S029",
      "kind": "main",
      "cn": "我的耳机去哪儿了？",
      "meaning_my": "နားကြပ် ဘယ်ရောက်သွားလဲ။",
      "audio_file": "02.05.01-S029.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S029_reply01",
      "kind": "reply",
      "cn": "是不是在桌上？",
      "meaning_my": "စားပွဲပေါ်မှာများ ရှိနေလား။",
      "audio_file": "02.05.01-S029_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.01-S030",
      "kind": "main",
      "cn": "我再仔细找找。",
      "meaning_my": "သေချာ ထပ်ရှာကြည့်ဦးမယ်။",
      "audio_file": "02.05.01-S030.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.02-S001",
      "kind": "main",
      "cn": "我手机丢了。",
      "meaning_my": "ဖုန်း ပျောက်သွားပြီ။",
      "audio_file": "02.05.02-S001.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.02-S001_reply01",
      "kind": "reply",
      "cn": "先给手机打个电话试试。",
      "meaning_my": "ဖုန်းကို အရင် တစ်ချက် ဆက်ကြည့်ပါဦး။",
      "audio_file": "02.05.02-S001_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.02-S001_alt01",
      "kind": "alternative",
      "cn": "我的手机不见了。",
      "meaning_my": "ဖုန်း ပျောက်နေပြီ။",
      "audio_file": "02.05.02-S001_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.05.02-S002",
      "kind": "main",
      "cn": "我找不到钥匙。",
