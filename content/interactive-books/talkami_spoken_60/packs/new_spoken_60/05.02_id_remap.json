  "mapping": [
    {
      "source_ref": "user_original_05.02.01_O003",
      "id": "05.02.01-S001",
      "text": "我想看看这款。"
    },
    {
      "source_ref": "user_original_05.02.01_O001",
      "id": "05.02.01-S002",
      "text": "有黑色的吗？"
    },
    {
      "source_ref": "user_original_05.02.01_O004",
      "id": "05.02.01-S003",
      "text": "有别的颜色吗？"
    },
    {
      "source_ref": "user_original_05.02.01_O022",
      "id": "05.02.01-S004",
      "text": "我想要深蓝色的。"
    },
    {
      "source_ref": "user_original_05.02.01_O010",
      "id": "05.02.01-S005",
      "text": "有没有颜色深一点的？"
    },
    {
      "source_ref": "user_original_05.02.01_O023",
      "id": "05.02.01-S006",
      "text": "有浅一点的颜色吗？"
    },
    {
      "source_ref": "user_original_05.02.01_O005",
      "id": "05.02.01-S007",
      "text": "我要长袖的。"
    },
    {
      "source_ref": "user_original_05.02.01_O011",
      "id": "05.02.01-S008",
      "text": "这款有短袖的吗？"
    },
    {
      "source_ref": "user_original_05.02.01_O006",
      "id": "05.02.01-S009",
      "text": "有没有不带图案的？"
    },
    {
      "source_ref": "user_original_05.02.01_O007",
      "id": "05.02.01-S010",
      "text": "我喜欢简单一点的款式。"
    },
    {
      "source_ref": "user_original_05.02.01_O012",
      "id": "05.02.01-S011",
      "text": "我想看宽松一点的。"
    },
    {
      "source_ref": "user_addition_05.02.01_N11",
      "id": "05.02.01-S012",
      "text": "有加大码的吗？"
    },
    {
      "source_ref": "user_original_05.02.01_O013",
      "id": "05.02.01-S013",
      "text": "这双鞋有白色的吗？"
    },
    {
      "source_ref": "user_original_05.02.01_O021",
      "id": "05.02.01-S014",
      "text": "这款有连帽的吗？"
    },
    {
      "source_ref": "user_addition_05.02.01_N01",
      "id": "05.02.01-S015",
      "text": "这是什么面料？"
    },
    {
      "source_ref": "user_addition_05.02.01_N02",
      "id": "05.02.01-S016",
      "text": "是棉的吗？"
    },
    {
      "source_ref": "user_addition_05.02.01_N03",
      "id": "05.02.01-S017",
      "text": "容易起球吗？"
    },
    {
      "source_ref": "user_addition_05.02.01_N04",
      "id": "05.02.01-S018",
      "text": "洗了会缩水吗？"
    },
    {
      "source_ref": "user_addition_05.02.01_N05",
      "id": "05.02.01-S019",
      "text": "容易皱吗？"
    },
    {
      "source_ref": "user_addition_05.02.01_N06",
      "id": "05.02.01-S020",
      "text": "这件厚吗？"
    },
    {
      "source_ref": "user_addition_05.02.01_N07",
      "id": "05.02.01-S021",
      "text": "有薄一点的吗？"
    },
    {
      "source_ref": "user_original_05.02.01_O008",
      "id": "05.02.01-S022",
      "text": "这种面料还有别的款吗？"
    },
    {
      "source_ref": "user_original_05.02.01_O009",
      "id": "05.02.01-S023",
      "text": "这个颜色太亮了。"
    },
    {
      "source_ref": "user_addition_05.02.01_N15",
      "id": "05.02.01-S024",
      "text": "我不太喜欢这个颜色。"
    },
    {
      "source_ref": "user_addition_05.02.01_N10",
      "id": "05.02.01-S025",
      "text": "这件配什么裤子好？"
    },
    {
      "source_ref": "user_original_05.02.01_O024",
      "id": "05.02.01-S026",
      "text": "我想再看看别的款。"
    },
    {
      "source_ref": "user_original_05.02.02_O003",
      "id": "05.02.02-S001",
      "text": "可以试穿吗？"
    },
    {
      "source_ref": "user_addition_05.02.02_N01",
      "id": "05.02.02-S002",
      "text": "试衣间在哪儿？"
    },
    {
      "source_ref": "user_original_05.02.02_O001",
      "id": "05.02.02-S003",
      "text": "我穿M码。"
    },
    {
      "source_ref": "user_original_05.02.02_O005",
      "id": "05.02.02-S004",
      "text": "有大一码的吗？"
    },
    {
      "source_ref": "editorial_new_05.02.02_E01",
      "id": "05.02.02-S005",
      "text": "有小一码的吗？"
    },
    {
      "source_ref": "user_original_05.02.02_O006",
      "id": "05.02.02-S006",
      "text": "有点小。"
    },
    {
      "source_ref": "user_original_05.02.02_O007",
      "id": "05.02.02-S007",
      "text": "太紧了。"
    },
    {
      "source_ref": "user_addition_05.02.02_N04",
      "id": "05.02.02-S008",
      "text": "这件太大了。"
    },
    {
      "source_ref": "user_original_05.02.02_O009",
      "id": "05.02.02-S009",
      "text": "这个正合适。"
    },
    {
      "source_ref": "user_original_05.02.02_O008",
      "id": "05.02.02-S010",
      "text": "这件太长了。"
    },
    {
      "source_ref": "user_addition_05.02.02_N07",
      "id": "05.02.02-S011",
      "text": "袖子有点长。"
    },
    {
      "source_ref": "user_addition_05.02.02_N06",
      "id": "05.02.02-S012",
      "text": "肩膀有点窄。"
    },
    {
      "source_ref": "user_addition_05.02.02_N08",
      "id": "05.02.02-S013",
      "text": "腰有点松。"
    },
    {
      "source_ref": "user_original_05.02.02_O014",
      "id": "05.02.02-S014",
      "text": "穿着挺舒服。"
    },
    {
      "source_ref": "user_addition_05.02.02_N03",
      "id": "05.02.02-S015",
      "text": "可以拿两件进去试吗？"
    },
    {
      "source_ref": "user_original_05.02.02_O013",
      "id": "05.02.02-S016",
      "text": "试完放哪里？"
    },
    {
      "source_ref": "user_original_05.02.02_O010",
      "id": "05.02.02-S017",
      "text": "这双鞋有42码吗？"
    },
    {
      "source_ref": "user_original_05.02.02_O023",
      "id": "05.02.02-S018",
      "text": "我试一下这双鞋。"
    },
    {
      "source_ref": "user_original_05.02.02_O012",
      "id": "05.02.02-S019",
      "text": "可以穿着走几步吗？"
    },
    {
      "source_ref": "user_addition_05.02.02_N09",
      "id": "05.02.02-S020",
      "text": "这双鞋有点挤脚。"
    },
    {
      "source_ref": "user_addition_05.02.02_N10",
      "id": "05.02.02-S021",
      "text": "脚趾顶到鞋头了。"
    },
    {
      "source_ref": "user_addition_05.02.02_N11",
      "id": "05.02.02-S022",
      "text": "这双鞋有大半码的吗？"
    },
    {
      "source_ref": "user_addition_05.02.02_N12",
      "id": "05.02.02-S023",
      "text": "穿袜子试可以吗？"
    },
    {
      "source_ref": "user_addition_05.02.02_N13",
      "id": "05.02.02-S024",
      "text": "这个面料贴身穿舒服吗？"
    },
    {
      "source_ref": "user_addition_05.02.02_N15",
      "id": "05.02.02-S025",
      "text": "这个颜色适合我吗？"
    },
    {
      "source_ref": "user_original_05.02.02_O021",
      "id": "05.02.02-S026",
      "text": "大小合适吗？"
    },
    {
      "source_ref": "user_original_05.02.03_O001",
      "id": "05.02.03-S001",
      "text": "帮我换大一码。"
    },
    {
      "source_ref": "user_original_05.02.03_O003",
      "id": "05.02.03-S002",
      "text": "还有L码吗？"
    },
    {
      "source_ref": "user_original_05.02.03_O005",
      "id": "05.02.03-S003",
      "text": "可以帮我查一下库存吗？"
    },
    {
      "source_ref": "user_addition_05.02.03_N09",
      "id": "05.02.03-S004",
      "text": "仓库还有这个码吗？"
    },
    {
      "source_ref": "user_original_05.02.03_O020",
      "id": "05.02.03-S005",
      "text": "其他店还有这个码吗？"
    },
    {
      "source_ref": "user_original_05.02.03_O006",
      "id": "05.02.03-S006",
      "text": "能从别的店调货吗？"
    },
    {
      "source_ref": "user_original_05.02.03_O010",
      "id": "05.02.03-S007",
      "text": "调货要多久？"
    },
    {
      "source_ref": "user_original_05.02.03_O008",
      "id": "05.02.03-S008",
      "text": "大概什么时候能到货？"
    },
    {
      "source_ref": "user_original_05.02.03_O007",
      "id": "05.02.03-S009",
      "text": "到了能通知我吗？"
    },
    {
      "source_ref": "user_original_05.02.03_O009",
      "id": "05.02.03-S010",
      "text": "可以帮我留一件吗？"
    },
    {
      "source_ref": "user_original_05.02.03_O011",
      "id": "05.02.03-S011",
      "text": "网上还有库存吗？"
    },
    {
      "source_ref": "user_original_05.02.03_O012",
      "id": "05.02.03-S012",
      "text": "调货要先付款吗？"
    },
    {
      "source_ref": "user_addition_05.02.03_N11",
      "id": "05.02.03-S013",
      "text": "调货要付定金吗？"
    },
    {
      "source_ref": "user_original_05.02.03_O019",
      "id": "05.02.03-S014",
      "text": "可以直接寄到我家吗？"
    },
    {
      "source_ref": "user_original_05.02.03_O021",
      "id": "05.02.03-S015",
      "text": "到货后能来店里取吗？"
    },
    {
      "source_ref": "user_addition_05.02.03_N01",
      "id": "05.02.03-S016",
      "text": "可以退换货吗？"
    },
    {
      "source_ref": "user_addition_05.02.03_N02",
      "id": "05.02.03-S017",
      "text": "几天内可以退换？"
    },
    {
      "source_ref": "user_addition_05.02.03_N03",
      "id": "05.02.03-S018",
      "text": "退换货要带什么？"
    },
    {
      "source_ref": "user_addition_05.02.03_N04",
      "id": "05.02.03-S019",
      "text": "吊牌要留着吗？"
    },
    {
      "source_ref": "user_addition_05.02.03_N05",
      "id": "05.02.03-S020",
      "text": "洗过了还能换吗？"
    },
    {
      "source_ref": "user_addition_05.02.03_N06",
      "id": "05.02.03-S021",
      "text": "可以换别的款吗？"
    },
    {
      "source_ref": "user_addition_05.02.03_N07",
      "id": "05.02.03-S022",
      "text": "换货要补差价吗？"
    },
    {
      "source_ref": "user_addition_05.02.03_N08",
      "id": "05.02.03-S023",
      "text": "退货的钱会退到哪里？"
    },
    {
      "source_ref": "user_addition_05.02.03_N16",
      "id": "05.02.03-S024",
      "text": "退货后多久能退款？"
    },
    {
      "source_ref": "user_addition_05.02.03_N15",
      "id": "05.02.03-S025",
      "text": "线上买的能到店退吗？"
    },
    {
      "source_ref": "user_addition_05.02.03_N12",
      "id": "05.02.03-S026",
      "text": "到货后能帮我留几天？"
    }
  ]
