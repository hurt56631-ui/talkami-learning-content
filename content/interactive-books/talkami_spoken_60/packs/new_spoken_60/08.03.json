          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "08.03.01-S002",
          "text": "帮我报警！",
          "meaning_my": "ရဲကို အကြောင်းကြားပေးပါ။",
          "replies": [],
          "alternatives": [],
