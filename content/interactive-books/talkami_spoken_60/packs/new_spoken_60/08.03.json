          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "08.03.01-S003",
          "text": "请帮我打110。",
          "meaning_my": "၁၁၀ ကို ဖုန်းဆက်ပေးပါ။",
