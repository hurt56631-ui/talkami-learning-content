      "id": "08.03.01",
      "title": "报警求助",
      "title_my": "ရဲတိုင်ခြင်းနှင့် အရေးပေါ်အကူအညီတောင်းခြင်း",
      "phrase_count": 30,
      "phrases": [
        {
          "id": "08.03.01-S001",
          "text": "救命！",
          "meaning_my": "ကယ်ကြပါဦး။",
