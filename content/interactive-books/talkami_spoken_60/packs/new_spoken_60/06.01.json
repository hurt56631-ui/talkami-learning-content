  "scenes": [
    {
      "id": "06.01.01",
      "title": "询问方向",
      "title_my": "လမ်းမေးခြင်းနှင့် သွားရမယ့်ဘက်",
      "phrase_count": 20,
      "phrases": [
        {
          "id": "06.01.01-S001",
          "text": "请问，去这里怎么走？",
          "meaning_my": "တဆိတ်လောက်၊ ဒီနေရာကို ဘယ်လိုသွားရမလဲ။",
          "replies": [
            {
              "id": "06.01.01-S001_reply01",
              "text": "你要去哪儿？",
              "meaning_my": "ဘယ်ကို သွားချင်တာလဲ။"
            }
          ],
          "alternatives": [
            {
              "id": "06.01.01-S001_alt01",
              "text": "不好意思，想问一下路。",
              "meaning_my": "အားနာပါတယ်၊ လမ်းနည်းနည်း မေးချင်လို့ပါ။"
            }
          ],
          "source_ref": "user_original_06.01.01_O001",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S002",
          "text": "去地铁站往哪边走？",
          "meaning_my": "မြေအောက်ရထားဘူတာကို သွားဖို့ ဘယ်ဘက်ကို သွားရမလဲ။",
          "replies": [
            {
              "id": "06.01.01-S002_reply01",
              "text": "一直往前，第二个路口左转。",
              "meaning_my": "ရှေ့တည့်တည့်သွားပြီး ဒုတိယလမ်းဆုံမှာ ဘယ်ဘက်ကွေ့ပါ။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_06.01.01_O002",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S003",
          "text": "去医院要往哪边走？",
          "meaning_my": "ဆေးရုံသွားဖို့ ဘယ်ဘက်ကို သွားရမလဲ။",
          "replies": [
            {
              "id": "06.01.01-S003_reply01",
              "text": "往前走五分钟，就在右边。",
              "meaning_my": "ရှေ့တည့်တည့် ငါးမိနစ်လောက် သွားရင် ညာဘက်မှာ ရှိတယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_06.01.01_O020",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S004",
          "text": "从这儿怎么去市场？",
          "meaning_my": "ဒီကနေ ဈေးကို ဘယ်လိုသွားရမလဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_06.01.01_O022",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S005",
          "text": "这附近有公交站吗？",
          "meaning_my": "ဒီနားမှာ ဘတ်စ်ကားမှတ်တိုင် ရှိလား။",
          "replies": [
            {
              "id": "06.01.01-S005_reply01",
              "text": "有，就在马路对面。",
              "meaning_my": "ရှိတယ်၊ လမ်းတစ်ဖက်ကမ်းမှာပဲ။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_06.01.01_O021",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S006",
          "text": "从哪个出口出去？",
          "meaning_my": "ဘယ်ထွက်ပေါက်ကနေ ထွက်ရမလဲ။",
          "replies": [
            {
              "id": "06.01.01-S006_reply01",
              "text": "从二号出口出去。",
              "meaning_my": "နံပါတ်နှစ်ထွက်ပေါက်ကနေ ထွက်ပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "06.01.01-S006_alt01",
              "text": "要走几号出口？",
              "meaning_my": "နံပါတ်ဘယ်လောက် ထွက်ပေါက်ကနေ ထွက်ရမလဲ။"
            }
          ],
          "source_ref": "user_original_06.01.01_O010",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S007",
          "text": "一直往前走吗？",
          "meaning_my": "ရှေ့တည့်တည့်ပဲ ဆက်သွားရမှာလား။",
          "replies": [
            {
              "id": "06.01.01-S007_reply01",
              "text": "对，直走，到路口再左转。",
              "meaning_my": "ဟုတ်တယ်၊ တည့်တည့်သွားပြီး လမ်းဆုံရောက်မှ ဘယ်ဘက်ကွေ့ပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "06.01.01-S007_alt01",
              "text": "一直直走吗？",
              "meaning_my": "တည့်တည့်ပဲ ဆက်သွားရမှာလား။"
            }
          ],
          "source_ref": "user_original_06.01.01_O004",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S008",
          "text": "左转还是右转？",
          "meaning_my": "ဘယ်ဘက်ကွေ့ရမလား၊ ညာဘက်ကွေ့ရမလား။",
          "replies": [
            {
              "id": "06.01.01-S008_reply01",
              "text": "到前面的路口右转。",
              "meaning_my": "ရှေ့က လမ်းဆုံရောက်ရင် ညာဘက်ကွေ့ပါ။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_06.01.01_O005",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "“左转/右转”是按你前进方向转向，不是站在对方面前以对方的左右为准。",
              "text_my": "“左转/右转” ဆိုတာ ကိုယ်သွားနေတဲ့ ဦးတည်ရာအတိုင်း ဘယ်ဘက်၊ ညာဘက် ကွေ့တာပါ။ မျက်နှာချင်းဆိုင်ရပ်နေတဲ့သူရဲ့ ဘယ်ညာနဲ့ မတွက်ပါနဲ့။"
            }
          ]
        },
        {
          "id": "06.01.01-S009",
          "text": "前面这个路口要转吗？",
          "meaning_my": "ရှေ့က ဒီလမ်းဆုံမှာ ကွေ့ရမလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_06.01.01_O007",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S010",
          "text": "走到路口以后呢？",
          "meaning_my": "လမ်းဆုံရောက်ပြီးရင် ဘယ်လိုဆက်သွားရမလဲ။",
          "replies": [
            {
              "id": "06.01.01-S010_reply01",
              "text": "过了路口就到了。",
              "meaning_my": "လမ်းဆုံကျော်သွားရင် ရောက်ပြီ။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_06.01.01_O009",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S011",
          "text": "从这里进去吗？",
          "meaning_my": "ဒီကနေ ဝင်ရမှာလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_06.01.01_O006",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S012",
          "text": "要过马路吗？",
          "meaning_my": "လမ်းဖြတ်ကူးရမလား။",
          "replies": [
            {
              "id": "06.01.01-S012_reply01",
              "text": "要，走前面的人行横道。",
              "meaning_my": "ဖြတ်ကူးရမယ်၊ ရှေ့က လူကူးမျဉ်းကြားကနေ ကူးပါ။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_06.01.01_O011",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S013",
          "text": "这里能过马路吗？",
          "meaning_my": "ဒီနေရာက လမ်းဖြတ်ကူးလို့ရလား။",
          "replies": [
            {
              "id": "06.01.01-S013_reply01",
              "text": "这里不行，去前面的斑马线。",
              "meaning_my": "ဒီနေရာက မရဘူး၊ ရှေ့က လူကူးမျဉ်းကြားကို သွားပါ။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_06.01.01_O023",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "safety",
              "text": "问路示例不代表允许随处横穿马路；应遵守现场信号灯、人行横道和当地交通规则。",
              "text_my": "လမ်းမေးတဲ့စကားဖြစ်ပေမဲ့ နေရာတိုင်း လမ်းဖြတ်ကူးလို့ရတယ်လို့ မဆိုလိုဘူး။ မီးပွိုင့်နဲ့ လူကူးမျဉ်းကြား စည်းကမ်းတွေကို လိုက်နာပါ။"
            }
          ]
        },
        {
          "id": "06.01.01-S014",
          "text": "这里能直接过去吗？",
          "meaning_my": "ဒီကနေ တိုက်ရိုက်သွားလို့ရလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_06.01.01_O008",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S015",
          "text": "走到头再转弯吗？",
          "meaning_my": "လမ်းအဆုံးထိ သွားပြီးမှ ကွေ့ရမှာလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_06.01.01_N04",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S016",
          "text": "要上天桥吗？",
          "meaning_my": "လူကူးခုံးကျော်တံတားပေါ် တက်ရမလား။",
          "replies": [
            {
              "id": "06.01.01-S016_reply01",
              "text": "对，从天桥走过去。",
              "meaning_my": "ဟုတ်တယ်၊ လူကူးခုံးကျော်တံတားကနေ ကူးသွားပါ။"
            }
