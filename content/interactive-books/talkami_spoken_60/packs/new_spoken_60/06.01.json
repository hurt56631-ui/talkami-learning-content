          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "06.01.01-S017",
          "text": "走地下通道吗？",
          "meaning_my": "မြေအောက်လူကူးလမ်းကနေ သွားရမလား။",
          "replies": [
            {
              "id": "06.01.01-S017_reply01",
              "text": "对，从地下通道过去。",
              "meaning_my": "ဟုတ်တယ်၊ မြေအောက်လူကူးလမ်းကနေ သွားပါ။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_addition_06.01.01_N07",
          "priority": "situational",
          "pinyin": null,
