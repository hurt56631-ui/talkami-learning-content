    {
      "id": "04.07.03",
      "title": "催单与超时",
      "title_my": "အော်ဒါနောက်ကျခြင်းနှင့် ပို့ဆောင်မှုအခြေအနေမေးခြင်း",
      "phrase_count": 9,
      "phrases": [
        {
          "id": "04.07.03-S001",
          "text": "外卖还要多久到？",
          "meaning_my": "မှာထားတဲ့ အစားအစာ နောက်ထပ် ဘယ်လောက်ကြာမှ ရောက်မလဲ။",
          "replies": [
            {
