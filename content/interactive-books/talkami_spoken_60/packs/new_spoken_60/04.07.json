  "scenes": [
    {
      "id": "04.07.01",
      "title": "下单备注与修改信息",
      "title_my": "အော်ဒါမှာချိန် မှတ်ချက်ရေးခြင်းနှင့် အချက်အလက်ပြင်ခြင်း",
      "phrase_count": 16,
      "phrases": [
        {
          "id": "04.07.01-S001",
          "text": "收货地址就填这个。",
          "meaning_my": "ပို့ရမယ့် လိပ်စာကို ဒါပဲ ဖြည့်ပါ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O001",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S002",
          "text": "放门口就行。",
          "meaning_my": "တံခါးရှေ့မှာပဲ ထားပေးပါ။",
          "replies": [],
          "alternatives": [
            {
              "id": "04.07.01-S002_alt01",
              "text": "麻烦放门口。",
              "meaning_my": "တံခါးရှေ့မှာ ထားပေးပါဦး။"
            }
          ],
          "source_ref": "user_original_04.07.01_O006",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S003",
          "text": "到了给我打电话。",
          "meaning_my": "ရောက်ရင် ဖုန်းဆက်ပေးပါ။",
          "replies": [],
          "alternatives": [
            {
              "id": "04.07.01-S003_alt01",
              "text": "送到了打个电话。",
              "meaning_my": "ပို့ရောက်ရင် ဖုန်းတစ်ချက် ဆက်ပေးပါ။"
            }
          ],
          "source_ref": "user_original_04.07.01_O007",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S004",
          "text": "不要打电话，发消息就行。",
          "meaning_my": "ဖုန်းမဆက်ပါနဲ့၊ စာပဲ ပို့ပေးပါ။",
          "replies": [
            {
              "id": "04.07.01-S004_reply01",
              "text": "好，我到了给您发消息。",
              "meaning_my": "ဟုတ်ကဲ့၊ ရောက်ရင် စာပို့ပေးပါမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O010",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S005",
          "text": "不用餐具。",
          "meaning_my": "ဇွန်းနဲ့တူ မလိုဘူး။",
          "replies": [],
          "alternatives": [
            {
              "id": "04.07.01-S005_alt01",
              "text": "不需要筷子和勺子。",
              "meaning_my": "တူနဲ့ ဇွန်း မလိုပါဘူး။"
            }
          ],
          "source_ref": "user_original_04.07.01_O005",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S006",
          "text": "备注不要辣。",
          "meaning_my": "မှတ်ချက်မှာ အစပ်မထည့်ဖို့ ရေးပေးပါ။",
          "replies": [
            {
              "id": "04.07.01-S006_reply01",
              "text": "好的，我帮您备注不要辣。",
              "meaning_my": "ဟုတ်ကဲ့၊ အစပ်မထည့်ဖို့ မှတ်ချက်ရေးပေးပါမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O002",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "外卖“备注”是给商家或骑手看的要求，不保证商家一定能按要求改；对食物过敏应另外明确确认配料。",
              "text_my": "အော်ဒါမှာတဲ့ “备注” က ဆိုင် ဒါမှမဟုတ် ပို့ဆောင်သူအတွက် မှတ်ချက်ပါ။ မှတ်ချက်အတိုင်း လုပ်ပေးမယ်လို့ အမြဲ မသေချာဘူး။"
            }
          ]
        },
        {
          "id": "04.07.01-S007",
          "text": "汤和饭分开装。",
          "meaning_my": "ဟင်းရည်နဲ့ ထမင်းကို သီးသန့် ခွဲထုပ်ပေးပါ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O017",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S008",
          "text": "餐具要两份。",
          "meaning_my": "ဇွန်းနဲ့တူ နှစ်စုံ လိုတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O011",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S009",
          "text": "能改收货地址吗？",
          "meaning_my": "ပို့ရမယ့် လိပ်စာ ပြောင်းလို့ရမလား။",
          "replies": [
            {
              "id": "04.07.01-S009_reply01",
              "text": "我先查一下还能不能改。",
              "meaning_my": "လိပ်စာ ပြောင်းလို့ရသေးလား အရင် စစ်ပေးမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O008",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "商家接单或骑手开始配送后，地址可能无法直接修改，应尽早联系商家或平台客服确认。",
              "text_my": "ဆိုင်က အော်ဒါလက်ခံပြီးရင်၊ ပို့ဆောင်မှုစပြီးရင် လိပ်စာကို တိုက်ရိုက် ပြောင်းလို့မရနိုင်ဘူး။ ဆိုင်နဲ့ အကူအညီဌာနကို အမြန် ဆက်သွယ်ပါ။"
            }
          ]
        },
        {
          "id": "04.07.01-S010",
          "text": "我把地址填错了。",
          "meaning_my": "လိပ်စာ မှားဖြည့်မိသွားတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O020",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S011",
          "text": "备注现在还能改吗？",
          "meaning_my": "မှတ်ချက်ကို အခု ပြင်လို့ရသေးလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O009",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S012",
          "text": "商家接单了吗？",
          "meaning_my": "ဆိုင်က အော်ဒါ လက်ခံပြီးပြီလား။",
          "replies": [
            {
              "id": "04.07.01-S012_reply01",
              "text": "已经接单，正在做了。",
              "meaning_my": "ဆိုင်က အော်ဒါလက်ခံပြီး ချက်နေပြီ။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O012",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S013",
          "text": "这个订单还能取消吗？",
          "meaning_my": "ဒီအော်ဒါကို ဖျက်လို့ရသေးလား။",
          "replies": [
            {
              "id": "04.07.01-S013_reply01",
              "text": "已经开始做了，我帮您问一下。",
              "meaning_my": "စချက်နေပြီ၊ ဖျက်လို့ရမရ မေးပေးပါမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O019",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "取消订单不等于一定获得全额退款；是否可以取消及费用处理取决于订单状态和平台规则。",
              "text_my": "အော်ဒါဖျက်လိုက်တာနဲ့ ငွေအပြည့် ပြန်ရမယ်လို့ မဆိုလိုဘူး။ အော်ဒါအခြေအနေနဲ့ ပလက်ဖောင်းစည်းကမ်းပေါ် မူတည်တယ်။"
            }
          ]
        },
        {
          "id": "04.07.01-S014",
          "text": "商家能看到我的备注吗？",
          "meaning_my": "ရေးထားတဲ့ မှတ်ချက်ကို ဆိုင်က မြင်နိုင်လား။",
          "replies": [
            {
              "id": "04.07.01-S014_reply01",
              "text": "看得到，我帮您再确认一下。",
              "meaning_my": "မြင်ရပါတယ်၊ ထပ်ပြီး သေချာ စစ်ပေးမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O013",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S015",
          "text": "下单后还能加一份米饭吗？",
          "meaning_my": "အော်ဒါတင်ပြီးမှ ထမင်းတစ်ပွဲ ထပ်မှာလို့ရသေးလား။",
          "replies": [
            {
              "id": "04.07.01-S015_reply01",
              "text": "我先问一下商家能不能加。",
              "meaning_my": "ဆိုင်မှာ ထပ်မှာလို့ရမရ မေးပေးမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.07.01_O018",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.01-S016",
          "text": "请送到一楼前台。",
          "meaning_my": "ပထမထပ်က ရှေ့ကောင်တာကို ပို့ပေးပါ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "editorial_new_04.07.01_E01",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        }
      ]
    },
    {
      "id": "04.07.02",
      "title": "联系骑手与碰面",
      "title_my": "ပို့ဆောင်သူကို ဆက်သွယ်ခြင်းနှင့် တွေ့ဆုံယူခြင်း",
      "phrase_count": 14,
      "phrases": [
        {
          "id": "04.07.02-S001",
          "text": "我在楼下。",
          "meaning_my": "အောက်ထပ်မှာ ရှိနေတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.07.02_O001",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.02-S002",
          "text": "我马上下来拿。",
          "meaning_my": "အခု ဆင်းယူလိုက်မယ်။",
          "replies": [
            {
              "id": "04.07.02-S002_reply01",
              "text": "好，我在门口等你。",
              "meaning_my": "ဟုတ်ပြီ၊ တံခါးပေါက်မှာ စောင့်နေမယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "04.07.02-S002_alt01",
              "text": "我这就下楼。",
              "meaning_my": "အခု အောက်ဆင်းလာမယ်။"
            }
          ],
          "source_ref": "user_original_04.07.02_O005",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.02-S003",
          "text": "你在哪个门？",
          "meaning_my": "ဘယ်တံခါးပေါက်မှာ ရှိနေလဲ။",
          "replies": [
            {
              "id": "04.07.02-S003_reply01",
              "text": "我在东门，不在南门。",
              "meaning_my": "အရှေ့ဘက်တံခါးပေါက်မှာပါ၊ တောင်ဘက်မှာ မဟုတ်ဘူး။"
            }
          ],
          "alternatives": [
            {
              "id": "04.07.02-S003_alt01",
              "text": "你在哪个入口？",
              "meaning_my": "ဘယ်ဝင်ပေါက်မှာ ရှိနေလဲ။"
            }
          ],
          "source_ref": "user_original_04.07.02_O002",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.02-S004",
          "text": "我找不到你。",
          "meaning_my": "ခင်ဗျားကို ရှာမတွေ့ဘူး။",
          "replies": [
            {
              "id": "04.07.02-S004_reply01",
              "text": "我就在保安亭旁边。",
              "meaning_my": "လုံခြုံရေးဂိတ်ဘေးမှာပဲ ရှိနေတယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.07.02_O003",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.02-S005",
          "text": "我到门口了。",
          "meaning_my": "တံခါးပေါက်နား ရောက်ပြီ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.07.02_O009",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.07.02-S006",
          "text": "我在东门，穿黑色衣服。",
          "meaning_my": "အရှေ့ဘက် တံခါးပေါက်မှာပါ၊ အနက်ရောင်အင်္ကျီ ဝတ်ထားတယ်။",
          "replies": [],
          "alternatives": [
            {
              "id": "04.07.02-S006_alt01",
              "text": "我在东门，不在南门。",
              "meaning_my": "အရှေ့ဘက်တံခါးပေါက်မှာပါ၊ တောင်ဘက်မှာ မဟုတ်ဘူး။"
            }
