          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S015",
          "text": "先关一会儿。",
          "meaning_my": "ခဏ ပိတ်ထားလိုက်ဦး။",
          "replies": [],
          "alternatives": [],
