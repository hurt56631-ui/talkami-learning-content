      "id": "03.04.01",
      "title": "空调温度",
      "title_my": "အဲကွန်းနှင့် အပူချိန်ချိန်ညှိခြင်း",
      "phrase_count": 18,
      "phrases": [
        {
          "id": "03.04.01-S001",
          "text": "开一下空调。",
          "meaning_my": "အဲကွန်းလေး ဖွင့်ပေးပါဦး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "03.04.01-S001",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S002",
          "text": "太热了。",
          "meaning_my": "ပူလွန်းတယ်။",
          "replies": [
            {
              "id": "03.04.01-S002_reply01",
              "text": "那我调低一点。",
              "meaning_my": "ဒါဆို အပူချိန် နည်းနည်းလျှော့ပေးမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "03.04.01-S003",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S003",
          "text": "太冷了。",
          "meaning_my": "အေးလွန်းတယ်။",
          "replies": [
            {
              "id": "03.04.01-S003_reply01",
              "text": "我把温度调高一点。",
              "meaning_my": "အပူချိန် နည်းနည်းမြှင့်ပေးမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "03.04.01-S002",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S004",
          "text": "温度调高一点。",
          "meaning_my": "အပူချိန် နည်းနည်းမြှင့်ပေးပါ။",
          "replies": [
            {
              "id": "03.04.01-S004_reply01",
              "text": "已经调高了。",
              "meaning_my": "အပူချိန် မြှင့်ထားပြီးပြီ။"
            }
          ],
          "alternatives": [],
          "source_ref": "03.04.01-S004",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "制冷模式下，调高设定温度通常会没那么冷；调低则通常更冷。不要把“调高”误解成让空调吹得更冷。",
              "text_my": "အအေးပေးမုဒ်မှာ သတ်မှတ်အပူချိန် မြှင့်ရင် အေးတာ လျော့တတ်တယ်။ အပူချိန်လျှော့ရင် ပိုအေးတတ်တယ်။"
            }
          ]
        },
        {
          "id": "03.04.01-S005",
          "text": "温度调低一点。",
          "meaning_my": "အပူချိန် နည်းနည်းလျှော့ပေးပါ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "03.04.01-S008",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S006",
          "text": "空调开多少度？",
          "meaning_my": "အဲကွန်း ဘယ်နှဒီဂရီထားလဲ။",
          "replies": [
            {
              "id": "03.04.01-S006_reply01",
              "text": "现在调到二十四度了。",
              "meaning_my": "အခု နှစ်ဆယ့်လေးဒီဂရီ ထားပြီးပြီ။"
            }
          ],
          "alternatives": [
            {
              "id": "03.04.01-S006_alt01",
              "text": "空调调到几度了？",
              "meaning_my": "အဲကွန်း ဘယ်နှဒီဂရီ ချိန်ထားလဲ။"
            }
          ],
          "source_ref": "03.04.01-S005",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S007",
          "text": "调到二十四度可以吗？",
          "meaning_my": "နှစ်ဆယ့်လေးဒီဂရီ ထားရင် ရမလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "03.04.01-S009",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S008",
          "text": "遥控器在哪儿？",
          "meaning_my": "ရီမုတ် ဘယ်မှာလဲ။",
          "replies": [
            {
              "id": "03.04.01-S008_reply01",
              "text": "遥控器在桌上。",
              "meaning_my": "ရီမုတ်က စားပွဲပေါ်မှာ။"
            }
          ],
          "alternatives": [],
          "source_ref": "03.04.01-S011",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S009",
          "text": "关一下空调。",
          "meaning_my": "အဲကွန်းလေး ပိတ်ပေးပါဦး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "editorial_new_N001_03.04.01",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S010",
          "text": "空调可以关了吗？",
          "meaning_my": "အဲကွန်း ပိတ်လို့ရပြီလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "03.04.01-S007",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S011",
          "text": "空调不制冷。",
          "meaning_my": "အဲကွန်းက အေးမလာဘူး။",
          "replies": [
            {
              "id": "03.04.01-S011_reply01",
              "text": "先看看是不是制冷模式。",
              "meaning_my": "အအေးပေးမုဒ် ဟုတ်မဟုတ် အရင်ကြည့်။"
            }
          ],
          "alternatives": [
            {
              "id": "03.04.01-S011_alt01",
              "text": "空调不凉了。",
              "meaning_my": "အဲကွန်း အေးမလာတော့ဘူး။"
            }
          ],
          "source_ref": "03.04.01-S015",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "“不制冷”是空调不能正常降温，不等于“空调没开”。",
              "text_my": "“不制冷” က အဲကွန်းက ပုံမှန်အတိုင်း မအေးတာပါ။ “မဖွင့်ထားဘူး” ဆိုတာနဲ့ မတူပါ။"
            }
          ]
        },
        {
          "id": "03.04.01-S012",
          "text": "风太大了，调小点吧。",
          "meaning_my": "လေအရမ်းပြင်းတယ်၊ နည်းနည်းလျှော့ပေးပါဦး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "03.04.01-S018",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S013",
          "text": "空调别对着我吹。",
          "meaning_my": "အဲကွန်းလေ ဒီဘက် တည့်တည့် မတိုက်အောင် လှည့်ပေးပါဦး။",
          "replies": [
            {
              "id": "03.04.01-S013_reply01",
              "text": "好，我把风口往上调。",
              "meaning_my": "ကောင်းပြီ၊ လေထွက်ပေါက်ကို အပေါ်ဘက် လှည့်ပေးမယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "03.04.01-S013_alt01",
              "text": "风口别对着我。",
              "meaning_my": "လေထွက်ပေါက် ဒီဘက် တည့်တည့် မထားပါနဲ့။"
            }
          ],
          "source_ref": "03.04.01-S006",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "03.04.01-S014",
          "text": "温度别调太低。",
          "meaning_my": "အပူချိန် အရမ်းမလျှော့နဲ့နော်။",
          "replies": [],
