          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "10.03.02-S004",
          "text": "这批先别继续做了。",
          "meaning_my": "ဒီအသုတ်ကို အခု ဆက်မလုပ်နဲ့ဦး။",
          "replies": [],
          "alternatives": [],
