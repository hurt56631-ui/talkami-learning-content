          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "10.03.01-S009",
          "text": "这里有划痕。",
          "meaning_my": "ဒီနေရာမှာ ခြစ်ရာရှိတယ်။",
          "replies": [
            {
              "id": "10.03.01-S009_reply01",
              "text": "先标记，交给质检员确认。",
              "meaning_my": "အမှတ်အသား အရင်လုပ်ပြီး အရည်အသွေးစစ်ဝန်ထမ်းကို အတည်ပြုခိုင်းပါ။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_10.03.01_B004",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
