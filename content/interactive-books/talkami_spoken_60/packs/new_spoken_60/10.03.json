      "phrase_count": 16,
      "phrases": [
        {
          "id": "10.03.02-S001",
          "text": "这个不合格。",
          "meaning_my": "ဒီပစ္စည်းက အရည်အသွေး မမီဘူး။",
          "replies": [
            {
              "id": "10.03.02-S001_reply01",
              "text": "先放到不合格品区。",
              "meaning_my": "အရည်အသွေးမမီတဲ့ပစ္စည်းနေရာမှာ အရင်ထားပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "10.03.02-S001_alt01",
              "text": "这个没达到标准。",
              "meaning_my": "ဒီပစ္စည်းက သတ်မှတ်စံနှုန်း မမီဘူး။"
            }
          ],
          "source_ref": "user_original_10.03.02_B001",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "10.03.02-S002",
          "text": "为什么不合格？",
          "meaning_my": "ဘာလို့ အရည်အသွေးမမီတာလဲ။",
          "replies": [
            {
              "id": "10.03.02-S002_reply01",
              "text": "尺寸超过允许范围。",
              "meaning_my": "အရွယ်အစားက ခွင့်ပြုထားတဲ့ ပမာဏထက် ကျော်နေတယ်။"
            }
