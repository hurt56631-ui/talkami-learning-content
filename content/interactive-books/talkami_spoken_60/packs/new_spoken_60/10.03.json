    {
      "id": "10.03.03",
      "title": "机器故障与维修",
      "title_my": "စက်ချို့ယွင်းမှုနှင့် ပြုပြင်ခြင်း",
      "phrase_count": 23,
      "phrases": [
        {
          "id": "10.03.03-S001",
          "text": "机器停了。",
          "meaning_my": "စက်ရပ်သွားပြီ။",
          "replies": [
            {
              "id": "10.03.03-S001_reply01",
              "text": "先别乱动，通知主管。",
              "meaning_my": "အခု လျှောက်မထိနဲ့ဦး၊ ကြီးကြပ်ရေးမှူးကို ပြောပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "10.03.03-S001_alt01",
              "text": "机器停下来了。",
              "meaning_my": "စက် ရပ်သွားပြီ။"
