          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "10.03.01-S010",
          "text": "这里有毛刺。",
          "meaning_my": "ဒီနေရာမှာ အစွန်းကြမ်းတွေ ရှိတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_10.03.01_B009",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "10.03.01-S011",
          "text": "表面有污点。",
          "meaning_my": "မျက်နှာပြင်မှာ အစွန်းအထင်း ရှိတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_10.03.01_B010",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "10.03.01-S012",
          "text": "这件有裂纹。",
          "meaning_my": "ဒီပစ္စည်းမှာ အက်ကွဲကြောင်း ရှိတယ်။",
          "replies": [],
          "alternatives": [],
