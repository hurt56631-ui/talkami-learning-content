          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "10.03.01-S021",
          "text": "先别签字，再核对一次。",
          "meaning_my": "လက်မှတ် အခုမထိုးနဲ့ဦး၊ နောက်တစ်ခါ ပြန်စစ်ပါ။",
          "replies": [],
