          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "10.03.01-S007",
          "text": "尺寸对吗？",
          "meaning_my": "အရွယ်အစား မှန်လား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_10.03.01_B002",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "10.03.01-S008",
          "text": "颜色不一样。",
          "meaning_my": "အရောင် မတူဘူး။",
          "replies": [],
          "alternatives": [],
