          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "10.03.02-S005",
          "text": "这批先隔离，别发货。",
          "meaning_my": "ဒီအသုတ်ကို အရင် သီးသန့်ခွဲထားပါ၊ ပစ္စည်း မပို့နဲ့ဦး။",
          "replies": [],
          "alternatives": [],
