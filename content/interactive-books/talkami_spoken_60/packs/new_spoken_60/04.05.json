          "replies": [
            {
              "id": "04.05.03-S002_reply01",
              "text": "好的，发到哪个邮箱？",
              "meaning_my": "ဟုတ်ကဲ့၊ ဘယ်အီးမေးလ်ကို ပို့ရမလဲ။"
            }
