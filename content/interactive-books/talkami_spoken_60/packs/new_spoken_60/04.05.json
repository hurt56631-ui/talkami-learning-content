      "title": "开发票与填写抬头",
      "title_my": "အခွန်ပြေစာ ထုတ်ခြင်းနှင့် အချက်အလက်ဖြည့်ခြင်း",
      "phrase_count": 13,
      "phrases": [
        {
          "id": "04.05.03-S001",
          "text": "可以开发票吗？",
          "meaning_my": "အခွန်ပြေစာ ထုတ်ပေးလို့ရမလား။",
          "replies": [
            {
              "id": "04.05.03-S001_reply01",
              "text": "可以，请填写开票信息。",
              "meaning_my": "ရပါတယ်၊ အခွန်ပြေစာထုတ်ဖို့ အချက်အလက် ဖြည့်ပေးပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "04.05.03-S001_alt01",
              "text": "我要开发票。",
              "meaning_my": "အခွန်ပြေစာ ထုတ်ချင်လို့ပါ။"
            }
