  "scenes": [
    {
      "id": "04.05.01",
      "title": "买单与核对账单",
      "title_my": "ငွေရှင်းခြင်းနှင့် ဘေလ်စစ်ဆေးခြင်း",
      "phrase_count": 25,
      "phrases": [
        {
          "id": "04.05.01-S001",
          "text": "买单。",
          "meaning_my": "ငွေရှင်းမယ်။",
          "replies": [
            {
              "id": "04.05.01-S001_reply01",
              "text": "好的，请到前台结账。",
              "meaning_my": "ဟုတ်ကဲ့၊ ကောင်တာမှာ သွားရှင်းပေးပါ။"
            }
          ],
          "alternatives": [
            {
              "id": "04.05.01-S001_alt01",
              "text": "服务员，结账。",
              "meaning_my": "ဝန်ထမ်းရေ၊ ငွေရှင်းမယ်။"
            }
          ],
          "source_ref": "user_original_04.05.01_O001",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.05.01-S002",
          "text": "这一桌一共多少钱？",
          "meaning_my": "ဒီစားပွဲအတွက် စုစုပေါင်း ဘယ်လောက်ကျလဲ။",
          "replies": [
            {
              "id": "04.05.01-S002_reply01",
              "text": "一共二百六。",
              "meaning_my": "စုစုပေါင်း ယွမ်နှစ်ရာ့ခြောက်ဆယ်ပါ။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.05.01_O002",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.05.01-S003",
          "text": "麻烦给我看一下账单。",
          "meaning_my": "ဘေလ်လေး ပြပေးပါဦး။",
          "replies": [
            {
              "id": "04.05.01-S003_reply01",
              "text": "好的，我给您拿过来。",
              "meaning_my": "ဟုတ်ကဲ့၊ ယူလာပေးပါမယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "04.05.01-S003_alt01",
              "text": "账单给我看一下。",
              "meaning_my": "ဘေလ်လေး ကြည့်ပါရစေ။"
            }
          ],
          "source_ref": "user_original_04.05.01_O003",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.05.01-S004",
          "text": "这个费用是什么？",
          "meaning_my": "ဒီငွေက ဘာအတွက် ကောက်ထားတာလဲ။",
          "replies": [
            {
              "id": "04.05.01-S004_reply01",
              "text": "这是餐位费。",
              "meaning_my": "ဒါက စားပွဲထိုင်ခုံကြေးပါ။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.05.01_O004",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "culture",
              "text": "“服务费”和“餐位费”可能是不同项目；具体收费和优惠以店家的实际账单为准。",
              "text_my": "“ဝန်ဆောင်ခ” နဲ့ “စားပွဲထိုင်ခုံကြေး” က မတူနိုင်ပါဘူး။ ဘာကြေးလဲဆိုတာ ဘေလ်ထဲမှာ သေချာ စစ်ပါ။"
            }
          ]
        },
        {
          "id": "04.05.01-S005",
          "text": "可以分开结账吗？",
          "meaning_my": "ငွေခွဲရှင်းလို့ ရမလား။",
          "replies": [
            {
              "id": "04.05.01-S005_reply01",
              "text": "可以，各付各的还是平摊？",
              "meaning_my": "ရပါတယ်၊ ကိုယ်စားတဲ့ဟာကိုယ်ရှင်းမလား၊ အညီအမျှ ခွဲရှင်းမလား။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.05.01_O005",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "“分开结账”可以各自付自己的，也可以均摊；结账前可问清是哪一种。",
              "text_my": "“分开结账” က ကိုယ်စားတဲ့ဟာကိုယ်ရှင်းတာလည်း ဖြစ်နိုင်သလို အညီအမျှ ခွဲရှင်းတာလည်း ဖြစ်နိုင်တယ်။"
            }
          ]
        },
        {
          "id": "04.05.01-S006",
          "text": "麻烦核对一下金额。",
          "meaning_my": "ကျသင့်ငွေပမာဏကို ပြန်စစ်ပေးပါဦး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.05.01_O007",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
