  "scenes": [
    {
      "id": "01.05.01",
      "title": "请求帮忙与回应",
      "title_my": "အကူအညီတောင်းခြင်းနှင့် ပြန်ဖြေခြင်း",
      "phrase_count": 43,
      "original_count": 24,
      "added_count": 19,
      "phrases": [
        {
          "id": "01.05.01-S001",
          "text": "能帮我一下吗？",
          "meaning_my": "နည်းနည်းလောက် ကူညီပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S002",
          "text": "不好意思，我现在有点忙。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ အခု နည်းနည်း အလုပ်များနေတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S003",
          "text": "我需要帮忙。",
          "meaning_my": "အကူအညီလိုနေတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S004",
          "text": "这个我一个人弄不了。",
          "meaning_my": "ဒါကို တစ်ယောက်တည်း မလုပ်နိုင်ဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S005",
          "text": "帮我看看。",
          "meaning_my": "နည်းနည်း ကြည့်ပေးပါဦး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S006",
          "text": "我现在没空，等会儿可以吗？",
          "meaning_my": "အခု မအားသေးဘူး၊ ခဏနေမှ ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S007",
          "text": "帮我确认一下。",
          "meaning_my": "သေချာအောင် စစ်ပေးပါဦး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S008",
          "text": "这个我不会弄。",
          "meaning_my": "ဒါကို မလုပ်တတ်ဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S009",
          "text": "这事有点急。",
          "meaning_my": "ဒီကိစ္စက နည်းနည်း အရေးတကြီးဖြစ်နေတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S010",
          "text": "我现在走不开，晚点行吗？",
          "meaning_my": "အခု ဒီနေရာက မထွက်နိုင်သေးလို့ နောက်မှ ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S011",
          "text": "能帮我联系一下负责人吗？",
          "meaning_my": "တာဝန်ခံကို ဆက်သွယ်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S012",
          "text": "我帮你看看。",
          "meaning_my": "ကြည့်ပေးမယ်နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S013",
          "text": "我帮你问问。",
          "meaning_my": "မေးပေးမယ်နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S014",
          "text": "要我帮你做什么？",
          "meaning_my": "ဘာကူညီပေးရမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S015",
          "text": "我找个懂的人来帮你。",
          "meaning_my": "နားလည်တဲ့သူတစ်ယောက်ကို ခေါ်ပေးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S016",
          "text": "这个得找工作人员。",
          "meaning_my": "ဒါက ဝန်ထမ်းကို မေးရမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S017",
          "text": "能帮我打个电话吗？",
          "meaning_my": "ဖုန်းတစ်ချက် ဆက်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S018",
          "text": "能帮我翻译一下吗？",
          "meaning_my": "ဘာသာပြန်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S019",
          "text": "需要我帮忙吗？",
          "meaning_my": "ကူညီပေးရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S020",
          "text": "能搭把手吗？",
          "meaning_my": "နည်းနည်း ဝိုင်းကူပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S021",
          "text": "这袋东西能帮我拎一下吗？",
          "meaning_my": "ဒီအိတ်လေး ကူသယ်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S022",
          "text": "这张通知能帮我看一下吗？",
          "meaning_my": "ဒီအသိပေးစာကို ကြည့်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S023",
          "text": "这东西我一个人搬不动。",
          "meaning_my": "ဒီပစ္စည်းကို တစ်ယောက်တည်း မမနိုင်ဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S024",
          "text": "能帮我拍张照吗？",
          "meaning_my": "ဓာတ်ပုံတစ်ပုံ ရိုက်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S025",
          "text": "帮我拿一下这个。",
          "meaning_my": "ဒါလေး ကူယူပေးပါဦး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S026",
          "text": "帮我开一下门。",
          "meaning_my": "တံခါးလေး ဖွင့်ပေးပါဦး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S027",
          "text": "帮我关一下门。",
          "meaning_my": "တံခါးလေး ပိတ်ပေးပါဦး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S028",
          "text": "能帮我叫一下服务员吗？",
          "meaning_my": "ဆိုင်ဝန်ထမ်းကို ခေါ်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S029",
          "text": "能帮我叫辆出租车吗？",
          "meaning_my": "တက္ကစီတစ်စီး ခေါ်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S030",
          "text": "能帮我叫一下医生吗？",
          "meaning_my": "ဆရာဝန်ကို ခေါ်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S031",
          "text": "能帮我看着点包吗？",
          "meaning_my": "အိတ်ကို ခဏ စောင့်ကြည့်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S032",
          "text": "能借我个充电器吗？",
          "meaning_my": "အားသွင်းကြိုးနဲ့ ခေါင်းလေး ခဏ ငှားပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S033",
          "text": "能让我充会儿电吗？",
          "meaning_my": "ခဏလောက် အားသွင်းလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S034",
          "text": "能帮我打印一下吗？",
          "meaning_my": "ပရင့်ထုတ်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S035",
          "text": "能帮我复印一份吗？",
          "meaning_my": "မိတ္တူတစ်စောင် ကူးပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S036",
          "text": "能帮我看看这个怎么填吗？",
          "meaning_my": "ဒါကို ဘယ်လိုဖြည့်ရမလဲ ကြည့်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S037",
          "text": "当然可以。",
          "meaning_my": "ရတာပေါ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S038",
          "text": "稍等，我马上来。",
          "meaning_my": "ခဏစောင့်နော်၊ ချက်ချင်း လာမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S039",
          "text": "不好意思，这个我帮不了。",
          "meaning_my": "အားနာပါတယ်၊ ဒီကိစ္စတော့ မကူညီနိုင်ဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S040",
          "text": "你可以再问问别人。",
          "meaning_my": "တခြားသူကိုလည်း ထပ်မေးကြည့်လို့ရတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S041",
          "text": "需要帮忙随时叫我。",
          "meaning_my": "အကူအညီလိုရင် အချိန်မရွေး ခေါ်နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S042",
          "text": "这东西能帮我搬一下吗？",
          "meaning_my": "ဒီပစ္စည်းကို ကူမပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.01-S043",
          "text": "不急，你有空再帮我。",
          "meaning_my": "အလျင်မလိုဘူး၊ အားတဲ့အခါမှ ကူညီပေးနော်။",
          "replies": [],
          "alternatives": []
        }
      ]
    },
    {
      "id": "01.05.02",
      "title": "请求示范与回应",
      "title_my": "လုပ်ပြပေးရန် တောင်းဆိုခြင်းနှင့် ပြန်ဖြေခြင်း",
      "phrase_count": 36,
      "original_count": 19,
      "added_count": 17,
      "phrases": [
        {
          "id": "01.05.02-S001",
          "text": "这个怎么做？",
          "meaning_my": "ဒါကို ဘယ်လိုလုပ်ရမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S002",
          "text": "你教我一下。",
          "meaning_my": "နည်းနည်း သင်ပေးပါဦး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S003",
          "text": "等会儿，我忙完教你。",
          "meaning_my": "ခဏနေဦး၊ အလုပ်ပြီးရင် သင်ပေးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S004",
          "text": "你做一遍给我看。",
          "meaning_my": "တစ်ခေါက် လုပ်ပြပါဦး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S005",
          "text": "刚才太快了，能慢点吗？",
          "meaning_my": "ခုနက မြန်လွန်းလို့ နည်းနည်း ဖြည်းဖြည်းလုပ်ပြလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S006",
          "text": "来，我再做一遍给你看。",
          "meaning_my": "လာ၊ နောက်တစ်ခေါက် လုပ်ပြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S007",
          "text": "这一步怎么弄？",
          "meaning_my": "ဒီအဆင့်ကို ဘယ်လိုလုပ်ရမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S008",
          "text": "下一步做什么？",
          "meaning_my": "နောက်တစ်ဆင့် ဘာလုပ်ရမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S009",
          "text": "我第一次做。",
          "meaning_my": "ဒါ ပထမဆုံး လုပ်ဖူးတာ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S010",
          "text": "先做哪一步？",
          "meaning_my": "ဘယ်အဆင့်ကို အရင်လုပ်ရမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S011",
          "text": "你做完我再试。",
          "meaning_my": "ခင်ဗျား လုပ်ပြီးမှ စမ်းလုပ်ကြည့်မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S012",
          "text": "别着急，慢慢来。",
          "meaning_my": "စိတ်မလောနဲ့၊ ဖြည်းဖြည်းလုပ်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S013",
          "text": "你看我做一遍。",
          "meaning_my": "လုပ်ပြတာ ကြည့်ပါဦး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S014",
          "text": "照这样做。",
          "meaning_my": "ဒီအတိုင်း လုပ်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S015",
          "text": "先做这一步。",
          "meaning_my": "ဒီအဆင့်ကို အရင်လုပ်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S016",
          "text": "然后把它放这儿。",
          "meaning_my": "ပြီးရင် ဒါကို ဒီမှာ ထားပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S017",
          "text": "先别动这个。",
          "meaning_my": "ဒါကို အခု မထိသေးနဲ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S018",
          "text": "你试一下。",
          "meaning_my": "စမ်းလုပ်ကြည့်ပါဦး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S019",
          "text": "对，就是这样。",
          "meaning_my": "ဟုတ်တယ်၊ အဲဒီလိုပဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S020",
          "text": "先按这个按钮。",
          "meaning_my": "အရင် ဒီခလုတ်ကို နှိပ်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S021",
          "text": "按住这里。",
          "meaning_my": "ဒီနေရာကို ဖိထားပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S022",
          "text": "点这里。",
          "meaning_my": "ဒီနေရာကို နှိပ်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S023",
          "text": "往左滑。",
          "meaning_my": "ဘယ်ဘက်ကို ပွတ်ဆွဲပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S024",
          "text": "往右滑。",
          "meaning_my": "ညာဘက်ကို ပွတ်ဆွဲပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S025",
          "text": "往上滑。",
          "meaning_my": "အပေါ်ကို ပွတ်ဆွဲပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S026",
          "text": "往下滑。",
          "meaning_my": "အောက်ကို ပွတ်ဆွဲပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S027",
          "text": "先关掉再打开。",
          "meaning_my": "အရင် ပိတ်ပြီး ပြန်ဖွင့်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S028",
          "text": "插在这里。",
          "meaning_my": "ဒီမှာ ထိုးထည့်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S029",
          "text": "对准这里。",
          "meaning_my": "ဒီနေရာနဲ့ တည့်အောင် ချိန်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S030",
          "text": "先别松手。",
          "meaning_my": "အခု လက်မလွှတ်သေးနဲ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S031",
          "text": "好了，你来试试。",
          "meaning_my": "ရပြီ၊ အခု စမ်းကြည့်ပါဦး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S032",
          "text": "我做一遍，你跟着做。",
          "meaning_my": "တစ်ခေါက် လုပ်ပြမယ်၊ လိုက်လုပ်ကြည့်နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S033",
          "text": "不对，再试一次。",
          "meaning_my": "မဟုတ်သေးဘူး၊ နောက်တစ်ခေါက် စမ်းကြည့်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S034",
          "text": "我还是不会。",
          "meaning_my": "မလုပ်တတ်သေးဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S035",
          "text": "能一步一步教我吗？",
          "meaning_my": "တစ်ဆင့်ချင်း သင်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.02-S036",
          "text": "这一步做完了吗？",
          "meaning_my": "ဒီအဆင့် ပြီးပြီလား။",
          "replies": [],
          "alternatives": []
        }
      ]
    },
    {
      "id": "01.05.03",
      "title": "请求带路与回应",
      "title_my": "လမ်းပြပေးရန် တောင်းဆိုခြင်းနှင့် ပြန်ဖြေခြင်း",
      "phrase_count": 26,
      "original_count": 15,
      "added_count": 11,
      "phrases": [
        {
          "id": "01.05.03-S001",
          "text": "可以带我去前台吗？",
          "meaning_my": "ဧည့်ကြိုကောင်တာကို လိုက်ပို့ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S002",
          "text": "不好意思，我现在走不开。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ အခု ဒီနေရာက မထွက်နိုင်သေးဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S003",
          "text": "我找不到入口。",
          "meaning_my": "ဝင်ပေါက် ရှာမတွေ့ဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S004",
          "text": "我不知道怎么走。",
          "meaning_my": "ဘယ်လိုသွားရမလဲ မသိဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S005",
          "text": "能带我过去吗？",
          "meaning_my": "လိုက်ပို့ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S006",
          "text": "我只能带你到门口。",
          "meaning_my": "တံခါးဝအထိပဲ လိုက်ပို့ပေးနိုင်မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S007",
          "text": "到这里就行。",
          "meaning_my": "ဒီအထိဆို ရပြီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S008",
          "text": "跟我来。",
          "meaning_my": "လိုက်ခဲ့ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S009",
          "text": "我第一次来这儿。",
          "meaning_my": "ဒီကို ပထမဆုံးလာတာ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S010",
          "text": "我带你过去。",
          "meaning_my": "လိုက်ပို့ပေးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S011",
          "text": "就在前面。",
          "meaning_my": "ရှေ့နားလေးမှာပဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S012",
          "text": "从这边走。",
          "meaning_my": "ဒီဘက်က သွားပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S013",
          "text": "到了，就是这儿。",
          "meaning_my": "ရောက်ပြီ၊ ဒီနေရာပဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S014",
          "text": "进去以后往哪儿走？",
          "meaning_my": "အထဲဝင်ပြီး ဘယ်ဘက်သွားရမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S015",
          "text": "从这里一直往前走。",
          "meaning_my": "ဒီကနေ ရှေ့တည့်တည့် ဆက်သွားပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S016",
          "text": "我带你到电梯口。",
          "meaning_my": "ဓာတ်လှေကားဝအထိ လိုက်ပို့ပေးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S017",
          "text": "在大厅等我。",
          "meaning_my": "ဧည့်ခန်းမမှာ စောင့်နေနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S018",
          "text": "穿过大厅就到了。",
          "meaning_my": "ခန်းမကို ဖြတ်သွားရင် ရောက်ပြီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S019",
          "text": "电梯就在旁边。",
          "meaning_my": "ဓာတ်လှေကားက ဘေးနားမှာပဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S020",
          "text": "从后门出去。",
          "meaning_my": "နောက်တံခါးကနေ ထွက်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S021",
          "text": "进门后左转。",
          "meaning_my": "တံခါးက ဝင်ပြီး ဘယ်ဘက်ကွေ့ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S022",
          "text": "快到了。",
          "meaning_my": "ရောက်တော့မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S023",
          "text": "还有多远？",
          "meaning_my": "နောက်ထပ် ဘယ်လောက်ဝေးသေးလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S024",
          "text": "我带你走一段。",
          "meaning_my": "လမ်းတစ်ပိုင်းလောက် လိုက်ပို့ပေးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S025",
          "text": "你先在这儿等我。",
          "meaning_my": "ဒီမှာ ခဏ စောင့်နေနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.05.03-S026",
          "text": "走错了，往回走。",
          "meaning_my": "လမ်းမှားသွားပြီ၊ ပြန်လှည့်သွားပါ။",
          "replies": [],
          "alternatives": []
        }
      ]
    }
  ]
