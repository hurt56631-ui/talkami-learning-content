        },
        {
          "id": "01.01.03-S016",
          "text": "别担心。",
          "meaning_my": "စိတ်မပူနဲ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S017",
          "text": "早点休息。",
          "meaning_my": "စောစောအနားယူနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S018",
          "text": "没事吧？",
          "meaning_my": "အဆင်ပြေရဲ့လား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S019",
          "text": "你脸色不太好。",
          "meaning_my": "မျက်နှာကြည့်ရတာ နေမကောင်းသလိုပဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S020",
          "text": "昨晚没睡好吗？",
          "meaning_my": "မနေ့ညက ကောင်းကောင်း မအိပ်ရဘူးလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S021",
          "text": "吃药了吗？",
          "meaning_my": "ဆေးသောက်ပြီးပြီလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S022",
          "text": "看过医生了吗？",
          "meaning_my": "ဆရာဝန် ပြပြီးပြီလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S023",
          "text": "多喝点热水。",
          "meaning_my": "ရေနွေး များများသောက်နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S024",
          "text": "多休息。",
          "meaning_my": "ကောင်းကောင်း အနားယူနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S025",
          "text": "需要帮忙就叫我。",
          "meaning_my": "အကူအညီလိုရင် ခေါ်နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S026",
          "text": "我陪你去。",
          "meaning_my": "လိုက်ပေးမယ်နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S027",
          "text": "那就好。",
          "meaning_my": "ဒါဆို ကောင်းတာပေါ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S028",
          "text": "没事就好。",
          "meaning_my": "ဘာမှမဖြစ်ရင် တော်သေးတာပေါ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S029",
          "text": "谢谢关心。",
          "meaning_my": "စိတ်ပူပေးလို့ ကျေးဇူးပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.03-S030",
          "text": "别太累了。",
          "meaning_my": "အရမ်း ပင်ပန်းမခံနဲ့နော်။",
          "replies": [],
          "alternatives": []
        }
      ]
    },
    {
      "id": "01.01.04",
      "title": "告别与叮嘱",
      "title_my": "နှုတ်ဆက်ခြင်းနှင့် ဂရုစိုက်စကား",
      "phrase_count": 24,
      "original_count": 12,
      "added_count": 12,
      "phrases": [
        {
          "id": "01.01.04-S001",
          "text": "我先走了。",
          "meaning_my": "အရင်သွားနှင့်တော့မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S002",
          "text": "再见。",
          "meaning_my": "နောက်မှတွေ့မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S003",
          "text": "明天见。",
          "meaning_my": "မနက်ဖြန်တွေ့မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S004",
          "text": "晚安。",
          "meaning_my": "ကောင်းကောင်းအိပ်ပါနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S005",
          "text": "好，到了给你发消息。",
          "meaning_my": "ကောင်းပြီ၊ ရောက်ရင် စာပို့လိုက်မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S006",
          "text": "到家告诉我。",
          "meaning_my": "အိမ်ရောက်ရင် ပြောနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S007",
          "text": "东西都带齐了吗？",
          "meaning_my": "ပစ္စည်းတွေ အကုန်ယူပြီးပြီလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S008",
          "text": "我得去赶车了。",
          "meaning_my": "ကားမီအောင် သွားရတော့မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S009",
          "text": "明天再联系。",
          "meaning_my": "မနက်ဖြန်မှ ပြန်ဆက်သွယ်ကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S010",
          "text": "下次再约。",
          "meaning_my": "နောက်တစ်ခါမှ ပြန်ချိန်းကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S011",
          "text": "有空再聊。",
          "meaning_my": "အားတဲ့အခါမှ ဆက်ပြောကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S012",
          "text": "路上小心点。",
          "meaning_my": "လမ်းမှာ သတိထားသွားနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S013",
          "text": "我先回去了。",
          "meaning_my": "အရင်ပြန်နှင့်တော့မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S014",
          "text": "一路顺风。",
          "meaning_my": "ခရီးလမ်း အဆင်ပြေပါစေ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S015",
          "text": "有事打电话。",
          "meaning_my": "ကိစ္စရှိရင် ဖုန်းဆက်နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S016",
          "text": "保持联系。",
          "meaning_my": "အဆက်အသွယ် မပြတ်နဲ့နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S017",
          "text": "先这样，回头聊。",
          "meaning_my": "ဒီလောက်ပဲနော်၊ နောက်မှ ဆက်ပြောကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S018",
          "text": "不用送。",
          "meaning_my": "လိုက်ပို့စရာ မလိုပါဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S019",
          "text": "我送送你。",
          "meaning_my": "လိုက်ပို့ပေးမယ်နော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S020",
          "text": "下次再来玩。",
          "meaning_my": "နောက်တစ်ခါ လာလည်ဦးနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S021",
          "text": "到家了吗？",
          "meaning_my": "အိမ်ရောက်ပြီလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S022",
          "text": "我到家了。",
          "meaning_my": "အိမ်ရောက်ပြီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.01.04-S023",
          "text": "路上慢点。",
          "meaning_my": "လမ်းမှာ အလျင်မလိုနဲ့နော်။",
          "replies": [],
          "alternatives": []
        },
        {
