      "source_ref": "user_original_05.01.04_O009",
      "id": "05.01.04-S010",
      "text": "会员码在哪里扫？"
    },
    {
      "source_ref": "user_original_05.01.04_O011",
      "id": "05.01.04-S011",
      "text": "没有会员。"
    },
    {
      "source_ref": "user_original_05.01.04_O010",
      "id": "05.01.04-S012",
      "text": "要袋子。"
    },
    {
      "source_ref": "user_addition_05.01.04_N14",
      "id": "05.01.04-S013",
      "text": "我买的东西有点多。"
    },
    {
      "source_ref": "user_original_05.01.04_O012",
      "id": "05.01.04-S014",
      "text": "不要小票。"
    },
    {
      "source_ref": "user_addition_05.01.04_N15",
      "id": "05.01.04-S015",
      "text": "怎么打印小票？"
    },
    {
      "source_ref": "user_addition_05.01.04_N08",
      "id": "05.01.04-S016",
      "text": "这台可以用现金吗？"
    },
    {
      "source_ref": "user_addition_05.01.04_N10",
      "id": "05.01.04-S017",
      "text": "怎么付不了？"
    },
    {
      "source_ref": "user_addition_05.01.04_N11",
      "id": "05.01.04-S018",
      "text": "付款码扫不上。"
    },
    {
      "source_ref": "user_original_05.01.04_O020",
      "id": "05.01.04-S019",
      "text": "能叫工作人员来一下吗？"
    },
    {
      "source_ref": "user_addition_05.01.04_N12",
      "id": "05.01.04-S020",
      "text": "能重新来一遍吗？"
    },
    {
      "source_ref": "editorial_new_05.01.04_E02",
      "id": "05.01.04-S021",
      "text": "机器卡住了。"
    },
    {
      "source_ref": "editorial_new_05.01.04_E03",
      "id": "05.01.04-S022",
      "text": "这个价格不对。"
    },
    {
      "source_ref": "user_addition_05.01.04_N06",
      "id": "05.01.04-S023",
      "text": "这件我不买了。"
    },
    {
      "source_ref": "editorial_new_05.01.04_E04",
      "id": "05.01.04-S024",
      "text": "这种水果在自助机上怎么称重？"
    }
