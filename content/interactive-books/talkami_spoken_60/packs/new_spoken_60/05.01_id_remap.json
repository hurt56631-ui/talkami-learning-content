      "text": "保质期多久？"
    },
    {
      "source_ref": "user_original_05.01.03_O003",
      "id": "05.01.03-S003",
      "text": "什么时候过期？"
    },
    {
      "source_ref": "user_addition_05.01.03_N03",
      "id": "05.01.03-S004",
      "text": "这个已经过期了。"
    },
    {
      "source_ref": "user_addition_05.01.03_N02",
      "id": "05.01.03-S005",
      "text": "这个还没过期吧？"
    },
    {
      "source_ref": "user_original_05.01.03_O005",
      "id": "05.01.03-S006",
      "text": "今天到期吗？"
    },
    {
      "source_ref": "user_original_05.01.03_O006",
      "id": "05.01.03-S007",
      "text": "临期有优惠吗？"
    },
    {
      "source_ref": "user_original_05.01.03_O004",
      "id": "05.01.03-S008",
      "text": "这个新鲜吗？"
    },
    {
      "source_ref": "user_addition_05.01.03_N04",
      "id": "05.01.03-S009",
      "text": "有新鲜一点的吗？"
    },
    {
      "source_ref": "user_original_05.01.03_O009",
      "id": "05.01.03-S010",
      "text": "这个要放冰箱吗？"
    },
    {
      "source_ref": "user_addition_05.01.03_N07",
      "id": "05.01.03-S011",
      "text": "常温放行吗？"
    },
    {
      "source_ref": "user_original_05.01.03_O010",
      "id": "05.01.03-S012",
      "text": "开封后怎么保存？"
    },
    {
      "source_ref": "user_addition_05.01.03_N08",
      "id": "05.01.03-S013",
      "text": "开封后几天内吃完？"
    },
    {
      "source_ref": "user_original_05.01.03_O011",
      "id": "05.01.03-S014",
      "text": "上面的日期看不清。"
    },
    {
      "source_ref": "user_original_05.01.03_O007",
      "id": "05.01.03-S015",
      "text": "这个是今天到货的吗？"
    },
    {
      "source_ref": "user_addition_05.01.03_N13",
      "id": "05.01.03-S016",
      "text": "这个还有几天到期？"
    },
    {
      "source_ref": "user_original_05.01.03_O008",
      "id": "05.01.03-S017",
      "text": "这个是哪天生产的？"
    },
    {
      "source_ref": "user_addition_05.01.03_N11",
      "id": "05.01.03-S018",
      "text": "买到过期的可以退吗？"
    },
    {
      "source_ref": "user_original_05.01.04_O001",
      "id": "05.01.04-S001",
      "text": "自助结账在哪儿？"
    },
    {
      "source_ref": "editorial_new_05.01.04_E01",
      "id": "05.01.04-S002",
      "text": "这个自助收银怎么用？"
    },
    {
      "source_ref": "user_original_05.01.04_O002",
      "id": "05.01.04-S003",
      "text": "这个怎么扫？"
    },
    {
      "source_ref": "user_original_05.01.04_O003",
      "id": "05.01.04-S004",
      "text": "这个条码扫不出来。"
    },
    {
      "source_ref": "user_addition_05.01.04_N03",
      "id": "05.01.04-S005",
      "text": "这个没有条码。"
    },
    {
      "source_ref": "user_original_05.01.04_O004",
      "id": "05.01.04-S006",
      "text": "我刚才多扫了一次。"
    },
    {
      "source_ref": "user_addition_05.01.04_N07",
      "id": "05.01.04-S007",
      "text": "能帮我取消这一件吗？"
    },
    {
      "source_ref": "user_original_05.01.04_O007",
      "id": "05.01.04-S008",
