    {
      "id": "05.04.01",
      "title": "询问价格与计价",
      "title_my": "ဈေးနှုန်းနှင့် တွက်ချက်ပုံ မေးခြင်း",
      "phrase_count": 14,
      "phrases": [
        {
          "id": "05.04.01-S001",
          "text": "这个价格对吗？",
          "meaning_my": "ဒီဈေးနှုန်း မှန်ရဲ့လား။",
          "replies": [
            {
              "id": "05.04.01-S001_reply01",
              "text": "我帮您再核对一下。",
              "meaning_my": "ဈေးနှုန်းကို ထပ်စစ်ပေးပါမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_05.04.01_O002",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "05.04.01-S002",
          "text": "就按标价卖吗？",
          "meaning_my": "ဈေးတံဆိပ်ပေါ်က ဈေးအတိုင်းပဲ ရောင်းတာလား။",
          "replies": [
            {
              "id": "05.04.01-S002_reply01",
              "text": "对，按标价算。",
              "meaning_my": "ဟုတ်ပါတယ်၊ ဈေးတံဆိပ်ပေါ်ကဈေးအတိုင်း တွက်ပါတယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_05.04.01_O003",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "标价是标签价格，实付价是最终结账金额，可能包含折扣和费用。",
              "text_my": "“标价” က ဈေးတံဆိပ်ပေါ်ကဈေး၊ “实付价” က တကယ်ရှင်းရတဲ့ ငွေပါ။"
            }
          ]
        },
        {
          "id": "05.04.01-S003",
          "text": "能帮我算一下总价吗？",
          "meaning_my": "စုစုပေါင်း ကျသင့်ငွေကို တွက်ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_05.04.01_O006",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "05.04.01-S004",
          "text": "打折后是多少钱？",
          "meaning_my": "လျှော့ဈေးနဲ့ဆို ဘယ်လောက်ကျမလဲ။",
          "replies": [],
          "alternatives": [
            {
              "id": "05.04.01-S004_alt01",
              "text": "优惠后实付多少？",
              "meaning_my": "လျှော့ဈေးပြီးရင် တကယ်ပေးရမယ့်ငွေ ဘယ်လောက်လဲ။"
            }
          ],
          "source_ref": "user_original_05.04.01_O018",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "05.04.01-S005",
          "text": "买两个一共多少钱？",
          "meaning_my": "နှစ်ခုဝယ်ရင် စုစုပေါင်း ဘယ်လောက်ကျမလဲ။",
          "replies": [],
