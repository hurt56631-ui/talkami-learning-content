  "scenes": [
    {
      "id": "02.04.01",
      "title": "询问到哪儿",
      "title_my": "ဘယ်အထိ ရောက်နေပြီလဲ မေးခြင်း",
      "phrase_count": 32,
      "original_count": 23,
      "added_count": 9,
      "phrases": [
        {
          "id": "02.04.01-S001",
          "text": "到了吗？",
          "meaning_my": "ရောက်ပြီလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S002",
          "text": "到哪儿了？",
          "meaning_my": "ဘယ်အထိ ရောက်ပြီလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S003",
          "text": "还有多久？",
          "meaning_my": "နောက်ထပ် ဘယ်လောက်ကြာဦးမလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S004",
          "text": "你出发了吗？",
          "meaning_my": "ထွက်လာပြီလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S005",
          "text": "大概几点能到？",
          "meaning_my": "ဘယ်နှနာရီလောက် ရောက်နိုင်မလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S006",
          "text": "我还在等你。",
          "meaning_my": "စောင့်နေတုန်းပဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S007",
          "text": "离这里还有多远？",
          "meaning_my": "ဒီကိုရောက်ဖို့ ဘယ်လောက်ဝေးသေးလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S008",
          "text": "你现在在路上吗？",
          "meaning_my": "အခု လမ်းမှာလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S009",
          "text": "到附近了告诉我。",
          "meaning_my": "ဒီနားရောက်ရင် ပြောနော်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S010",
          "text": "你坐上车了吗？",
          "meaning_my": "ကားပေါ် တက်ပြီးပြီလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S011",
          "text": "在路上。",
          "meaning_my": "လမ်းမှာပါ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S012",
          "text": "我十分钟后到。",
          "meaning_my": "နောက်ဆယ်မိနစ်ဆို ရောက်မယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S013",
          "text": "刚出发。",
          "meaning_my": "အခုမှ ထွက်လာတာ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S014",
          "text": "有点堵车。",
          "meaning_my": "ကား နည်းနည်းပိတ်နေတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S015",
          "text": "我已经到附近了。",
          "meaning_my": "ဒီနားရောက်နေပြီ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S016",
          "text": "你先进去吧。",
          "meaning_my": "အထဲ အရင်ဝင်နှင့်ပါ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S017",
          "text": "我快到门口了。",
          "meaning_my": "တံခါးဝ ရောက်တော့မယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S018",
          "text": "我到楼下了，入口在哪儿？",
          "meaning_my": "အဆောက်အအုံအောက် ရောက်ပြီ၊ ဝင်ပေါက် ဘယ်မှာလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S019",
          "text": "你能准时到吗？",
          "meaning_my": "အချိန်မှန် ရောက်နိုင်မလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S020",
          "text": "我已经出门了。",
          "meaning_my": "အိမ်က ထွက်လာပြီ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S021",
          "text": "我刚坐上公交车。",
          "meaning_my": "ခုနကမှ ဘတ်စ်ကားပေါ် တက်တာ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S022",
          "text": "我快到了，再等我一下。",
          "meaning_my": "ရောက်တော့မယ်၊ ခဏထပ်စောင့်ပါဦး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S023",
          "text": "你先点菜吧，不用等我。",
          "meaning_my": "ဟင်းအရင်မှာထားလိုက်ပါ၊ မစောင့်နဲ့နော်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S024",
          "text": "你现在在哪儿？",
          "meaning_my": "အခု ဘယ်မှာလဲ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S025",
          "text": "你出门了吗？",
          "meaning_my": "အိမ်က ထွက်လာပြီလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S026",
          "text": "路上堵车吗？",
          "meaning_my": "လမ်းမှာ ကားပိတ်နေလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S027",
          "text": "要不要我过去接你？",
          "meaning_my": "လာကြိုပေးရမလား။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S028",
          "text": "别着急，路上小心。",
          "meaning_my": "အလျင်မလိုနဲ့၊ လမ်းမှာ သတိထားနော်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S029",
          "text": "我在老地方等你。",
          "meaning_my": "အရင်ချိန်းနေကျ နေရာမှာ စောင့်နေမယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S030",
          "text": "我已经等了半小时了。",
          "meaning_my": "နာရီဝက် စောင့်နေရပြီ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S031",
          "text": "你到了直接进来。",
          "meaning_my": "ရောက်ရင် တန်းဝင်လာခဲ့နော်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.01-S032",
          "text": "快到的时候告诉我。",
          "meaning_my": "ရောက်ခါနီးရင် ပြောနော်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        }
      ]
    },
    {
      "id": "02.04.02",
      "title": "迟到说明",
      "title_my": "နောက်ကျသည့်အကြောင်း ရှင်းပြခြင်း",
      "phrase_count": 27,
      "original_count": 18,
      "added_count": 9,
      "phrases": [
        {
          "id": "02.04.02-S001",
          "text": "不好意思，出门晚了。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ အိမ်ကထွက်တာ နောက်ကျသွားလို့။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S002",
          "text": "不好意思，我迟到了。",
          "meaning_my": "တောင်းပန်ပါတယ်၊ နောက်ကျသွားတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S003",
          "text": "地铁晚点了。",
          "meaning_my": "မြေအောက်ရထား နောက်ကျသွားတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S004",
          "text": "没事，路上注意安全。",
          "meaning_my": "ရပါတယ်၊ လမ်းမှာ သတိထားပါ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S005",
          "text": "我会晚十分钟。",
          "meaning_my": "ဆယ်မိနစ်လောက် နောက်ကျမယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S006",
          "text": "没关系，我在这儿等你。",
          "meaning_my": "ရပါတယ်၊ ဒီမှာ စောင့်နေမယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S007",
          "text": "我刚从公司出来。",
          "meaning_my": "အခုမှ ကုမ္ပဏီက ထွက်လာတာ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S008",
          "text": "大概七点十分到。",
          "meaning_my": "ခုနစ်နာရီ ဆယ်မိနစ်လောက် ရောက်မယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S009",
          "text": "还有五分钟就到。",
          "meaning_my": "နောက်ငါးမိနစ်ဆို ရောက်တော့မယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S010",
          "text": "我刚下地铁。",
          "meaning_my": "အခုမှ မြေအောက်ရထားပေါ်က ဆင်းတာ။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S011",
          "text": "临时有点事耽误了。",
          "meaning_my": "ရုတ်တရက် ကိစ္စတစ်ခုကြောင့် နောက်ကျသွားတယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S012",
          "text": "不用在门口等我。",
          "meaning_my": "တံခါးဝမှာ စောင့်နေစရာ မလိုဘူး။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S013",
          "text": "没事，慢慢来。",
          "meaning_my": "ရပါတယ်၊ ဖြည်းဖြည်းလာပါ။",
          "replies": [],
