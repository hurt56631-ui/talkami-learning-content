          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S017",
          "text": "我先进去等。",
          "meaning_my": "အထဲ အရင်ဝင်စောင့်မယ်။",
          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S018",
          "text": "路上太堵了，得晚点到。",
          "meaning_my": "လမ်းမှာ ကားအရမ်းပိတ်လို့ နောက်ကျမှ ရောက်မယ်။",
          "replies": [],
