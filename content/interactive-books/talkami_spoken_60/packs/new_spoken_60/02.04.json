          "replies": [],
          "alternatives": [],
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "02.04.02-S015",
          "text": "到了告诉我。",
          "meaning_my": "ရောက်ရင် ပြောနော်။",
          "replies": [],
          "alternatives": [],
