{
  "theme_id": "04.02",
  "original_candidates": 69,
  "additional_candidates": 68,
  "current_main": 88,
  "mapping": [
    {
      "source_ref": "user_original_04.02.01_O001",
      "id": "04.02.01-S001",
      "text": "我要两个包子。"
    },
    {
      "source_ref": "user_original_04.02.01_O002",
      "id": "04.02.01-S002",
      "text": "来一碗粥。"
    },
    {
      "source_ref": "user_original_04.02.01_O004",
      "id": "04.02.01-S003",
      "text": "一杯豆浆。"
    },
    {
      "source_ref": "user_original_04.02.01_O005",
      "id": "04.02.01-S004",
      "text": "再加一个鸡蛋。"
    },
    {
      "source_ref": "user_original_04.02.01_O009",
      "id": "04.02.01-S005",
      "text": "油条来两根。"
    },
    {
      "source_ref": "user_addition_04.02.01_N01",
      "id": "04.02.01-S006",
      "text": "有什么早餐？"
    },
    {
      "source_ref": "user_original_04.02.01_O010",
      "id": "04.02.01-S007",
      "text": "包子有什么馅？"
    },
    {
      "source_ref": "user_addition_04.02.01_N07",
      "id": "04.02.01-S008",
      "text": "我要一个肉包、一个菜包。"
    },
    {
      "source_ref": "user_addition_04.02.01_N09",
      "id": "04.02.01-S009",
      "text": "这个多少钱一个？"
    },
    {
      "source_ref": "user_original_04.02.01_O007",
      "id": "04.02.01-S010",
      "text": "这些一共多少钱？"
    },
    {
      "source_ref": "user_addition_04.02.01_N11",
      "id": "04.02.01-S011",
      "text": "要等多久？"
    },
    {
      "source_ref": "user_addition_04.02.01_N15",
      "id": "04.02.01-S012",
      "text": "可以扫码付款吗？"
    },
    {
      "source_ref": "user_addition_04.02.01_N16",
      "id": "04.02.01-S013",
      "text": "现金可以吗？"
    },
    {
      "source_ref": "user_original_04.02.01_O020",
      "id": "04.02.01-S014",
      "text": "豆浆不要糖。"
    },
    {
      "source_ref": "user_addition_04.02.01_N05",
      "id": "04.02.01-S015",
      "text": "粥有什么口味？"
    },
    {
      "source_ref": "user_addition_04.02.01_N06",
      "id": "04.02.01-S016",
      "text": "豆浆有冰的吗？"
    },
    {
      "source_ref": "user_addition_04.02.01_N02",
      "id": "04.02.01-S017",
      "text": "有馒头吗？"
    },
    {
      "source_ref": "user_addition_04.02.01_N03",
      "id": "04.02.01-S018",
      "text": "有煎饼吗？"
    },
    {
      "source_ref": "user_addition_04.02.01_N04",
      "id": "04.02.01-S019",
      "text": "有面条吗？"
    },
    {
      "source_ref": "user_original_04.02.01_O021",
      "id": "04.02.01-S020",
      "text": "还有茶叶蛋吗？"
    },
    {
      "source_ref": "user_original_04.02.01_O013",
      "id": "04.02.01-S021",
      "text": "包子能帮我加热一下吗？"
    },
    {
      "source_ref": "user_original_04.02.01_O016",
      "id": "04.02.01-S022",
      "text": "自助点餐机怎么用？"
    },
    {
      "source_ref": "user_original_04.02.01_O018",
      "id": "04.02.01-S023",
      "text": "我的包子还没拿到。"
    },
    {
      "source_ref": "user_original_04.02.01_O017",
      "id": "04.02.01-S024",
      "text": "是不是有人拿错我的餐了？"
    },
    {
      "source_ref": "user_original_04.02.01_O019",
      "id": "04.02.01-S025",
      "text": "跟他一样就行。"
    },
    {
      "source_ref": "user_original_04.02.01_O022",
      "id": "04.02.01-S026",
      "text": "这个饼刚出锅吗？"
    },
    {
      "source_ref": "user_addition_04.02.01_N18",
      "id": "04.02.01-S027",
      "text": "这个还有吗？"
    },
    {
      "source_ref": "user_addition_04.02.01_N21",
      "id": "04.02.01-S028",
      "text": "有筷子吗？"
    },
    {
      "source_ref": "user_addition_04.02.01_N22",
      "id": "04.02.01-S029",
      "text": "有勺子吗？"
    },
    {
      "source_ref": "user_original_04.02.01_O011",
      "id": "04.02.01-S030",
      "text": "还要什么？"
    },
    {
      "source_ref": "user_original_04.02.02_O001",
      "id": "04.02.02-S001",
      "text": "这个多少钱一串？"
    },
    {
      "source_ref": "user_original_04.02.02_O002",
      "id": "04.02.02-S002",
      "text": "我要一份。"
    },
    {
      "source_ref": "user_original_04.02.02_O003",
      "id": "04.02.02-S003",
      "text": "来两串。"
    },
    {
      "source_ref": "user_addition_04.02.02_N03",
      "id": "04.02.02-S004",
      "text": "一份多少钱？"
    },
    {
      "source_ref": "user_addition_04.02.02_N01",
      "id": "04.02.02-S005",
      "text": "这个怎么卖？"
    },
    {
      "source_ref": "user_original_04.02.02_O007",
      "id": "04.02.02-S006",
      "text": "加料要钱吗？"
    },
    {
      "source_ref": "user_original_04.02.02_O008",
      "id": "04.02.02-S007",
      "text": "有不辣的吗？"
    },
    {
      "source_ref": "user_original_04.02.02_O009",
      "id": "04.02.02-S008",
      "text": "可以现做吗？"
    },
    {
      "source_ref": "user_original_04.02.02_O010",
      "id": "04.02.02-S009",
      "text": "现做要等多久？"
    },
    {
      "source_ref": "user_addition_04.02.02_N14",
      "id": "04.02.02-S010",
      "text": "我要现做的。"
    },
    {
      "source_ref": "user_original_04.02.02_O011",
      "id": "04.02.02-S011",
      "text": "这个里面是什么馅？"
    },
    {
      "source_ref": "user_original_04.02.02_O012",
      "id": "04.02.02-S012",
      "text": "可以不放葱吗？"
    },
    {
      "source_ref": "user_original_04.02.02_O013",
      "id": "04.02.02-S013",
      "text": "辣椒另外放。"
    },
    {
      "source_ref": "user_original_04.02.02_O014",
      "id": "04.02.02-S014",
      "text": "辣椒要吗？"
    },
    {
      "source_ref": "user_original_04.02.02_O015",
      "id": "04.02.02-S015",
      "text": "加不加葱？"
    },
    {
      "source_ref": "user_addition_04.02.02_N06",
      "id": "04.02.02-S016",
      "text": "少放辣。"
    },
    {
      "source_ref": "user_addition_04.02.02_N09",
      "id": "04.02.02-S017",
      "text": "加个鸡蛋。"
    },
    {
      "source_ref": "user_addition_04.02.02_N10",
      "id": "04.02.02-S018",
      "text": "加点肉。"
    },
    {
      "source_ref": "user_addition_04.02.02_N11",
      "id": "04.02.02-S019",
      "text": "菜多放一点。"
    },
    {
      "source_ref": "user_original_04.02.02_O022",
      "id": "04.02.02-S020",
      "text": "能多加点酱吗？"
    },
    {
      "source_ref": "user_addition_04.02.02_N18",
      "id": "04.02.02-S021",
      "text": "酱少放一点。"
    },
    {
      "source_ref": "user_original_04.02.02_O016",
      "id": "04.02.02-S022",
      "text": "一份够一个人吃吗？"
    },
    {
      "source_ref": "user_original_04.02.02_O019",
      "id": "04.02.02-S023",
      "text": "这个是刚炸好的吗？"
    },
    {
      "source_ref": "user_addition_04.02.02_N22",
      "id": "04.02.02-S024",
      "text": "那边有座位吗？"
    },
    {
      "source_ref": "user_original_04.02.02_O021",
      "id": "04.02.02-S025",
      "text": "还要加别的吗？"
    },
    {
      "source_ref": "editorial_new_04.02.02_M01",
      "id": "04.02.02-S026",
      "text": "这是甜的还是咸的？"
    },
    {
      "source_ref": "user_original_04.02.03_O014",
      "id": "04.02.03-S001",
      "text": "在这儿吃还是带走？"
    },
    {
      "source_ref": "user_original_04.02.03_O001",
      "id": "04.02.03-S002",
      "text": "我要带走。"
    },
    {
      "source_ref": "user_original_04.02.03_O002",
      "id": "04.02.03-S003",
      "text": "在这儿吃。"
    },
    {
      "source_ref": "user_original_04.02.03_O003",
      "id": "04.02.03-S004",
      "text": "帮我打包。"
    },
    {
      "source_ref": "user_original_04.02.03_O009",
      "id": "04.02.03-S005",
      "text": "剩下的也带走。"
    },
    {
      "source_ref": "user_original_04.02.03_O004",
      "id": "04.02.03-S006",
      "text": "这个汤单独装。"
    },
    {
      "source_ref": "user_original_04.02.03_O011",
      "id": "04.02.03-S007",
      "text": "这个不要跟汤放一起。"
    },
    {
      "source_ref": "user_original_04.02.03_O008",
      "id": "04.02.03-S008",
      "text": "麻烦装好点，别洒了。"
    },
    {
      "source_ref": "user_original_04.02.03_O010",
      "id": "04.02.03-S009",
      "text": "袋子能多给一个吗？"
    },
    {
      "source_ref": "user_addition_04.02.03_N03",
      "id": "04.02.03-S010",
      "text": "不用袋子。"
    },
    {
      "source_ref": "user_addition_04.02.03_N01",
      "id": "04.02.03-S011",
      "text": "打包盒多少钱？"
    },
    {
      "source_ref": "user_addition_04.02.03_N02",
      "id": "04.02.03-S012",
      "text": "袋子多少钱？"
    },
    {
      "source_ref": "user_addition_04.02.03_N05",
      "id": "04.02.03-S013",
      "text": "这个分开装。"
    },
    {
      "source_ref": "user_addition_04.02.03_N07",
      "id": "04.02.03-S014",
      "text": "凉的和热的分开装。"
    },
    {
      "source_ref": "user_original_04.02.03_O012",
      "id": "04.02.03-S015",
      "text": "餐具也帮我放进去。"
    },
    {
      "source_ref": "user_addition_04.02.03_N08",
      "id": "04.02.03-S016",
      "text": "筷子多给一双。"
    },
    {
      "source_ref": "user_original_04.02.03_O019",
      "id": "04.02.03-S017",
      "text": "需要餐具吗？"
    },
    {
      "source_ref": "user_original_04.02.03_O013",
      "id": "04.02.03-S018",
      "text": "做好了在哪儿取？"
    },
    {
      "source_ref": "user_original_04.02.03_O021",
      "id": "04.02.03-S019",
      "text": "叫到你的号再来拿。"
    },
    {
      "source_ref": "user_original_04.02.03_O007",
      "id": "04.02.03-S020",
      "text": "好了叫我一声。"
    },
    {
      "source_ref": "user_original_04.02.03_O006",
      "id": "04.02.03-S021",
      "text": "我等会儿来拿。"
    },
    {
      "source_ref": "user_original_04.02.03_O022",
      "id": "04.02.03-S022",
      "text": "取餐码在哪个页面？"
    },
    {
      "source_ref": "user_original_04.02.03_O023",
      "id": "04.02.03-S023",
      "text": "刚才叫到我的号了吗？"
    },
    {
      "source_ref": "user_original_04.02.03_O024",
      "id": "04.02.03-S024",
      "text": "没有取餐码，报手机号行吗？"
    },
    {
      "source_ref": "user_addition_04.02.03_N10",
      "id": "04.02.03-S025",
      "text": "我的取餐号是多少？"
    },
    {
      "source_ref": "user_addition_04.02.03_N11",
      "id": "04.02.03-S026",
      "text": "这是我点的吗？"
    },
    {
      "source_ref": "user_addition_04.02.03_N12",
      "id": "04.02.03-S027",
      "text": "我的还没好吗？"
    },
    {
      "source_ref": "user_addition_04.02.03_N13",
      "id": "04.02.03-S028",
      "text": "还要等多久？"
    },
    {
      "source_ref": "user_addition_04.02.03_N14",
      "id": "04.02.03-S029",
      "text": "我赶时间，能快点吗？"
    },
    {
      "source_ref": "user_addition_04.02.03_N22",
      "id": "04.02.03-S030",
      "text": "这份不是我的。"
    },
    {
      "source_ref": "user_addition_04.02.03_N15",
      "id": "04.02.03-S031",
      "text": "可以送餐吗？"
    },
    {
      "source_ref": "user_original_04.02.03_O025",
      "id": "04.02.03-S032",
      "text": "粥能打包吗？"
    }
  ]
}
