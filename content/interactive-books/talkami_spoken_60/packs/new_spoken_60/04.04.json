  "scenes": [
    {
      "id": "04.04.01",
      "title": "催菜与上菜进度",
      "title_my": "ဟင်းပွဲနောက်ကျခြင်းနှင့် လာချပေးမည့်အချိန်",
      "phrase_count": 12,
      "phrases": [
        {
          "id": "04.04.01-S001",
          "text": "我们的菜呢？",
          "meaning_my": "မှာထားတဲ့ ဟင်းတွေ ဘယ်ရောက်နေပြီလဲ။",
          "replies": [
            {
              "id": "04.04.01-S001_reply01",
              "text": "不好意思，我帮您问一下厨房。",
              "meaning_my": "တောင်းပန်ပါတယ်၊ မီးဖိုချောင်မှာ မေးပေးပါမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_addition_04.04.01_N01",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.01-S002",
          "text": "这道菜还要多久？",
          "meaning_my": "ဒီဟင်း နောက်ထပ် ဘယ်လောက်ကြာမလဲ။",
          "replies": [
            {
              "id": "04.04.01-S002_reply01",
              "text": "大概还要五分钟。",
              "meaning_my": "နောက်ထပ် ငါးမိနစ်လောက် ကြာမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.04.01_O003",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.01-S003",
          "text": "是不是漏单了？",
          "meaning_my": "အော်ဒါကျန်ခဲ့တာလား။",
          "replies": [
            {
              "id": "04.04.01-S003_reply01",
              "text": "我马上帮您查一下订单。",
              "meaning_my": "အော်ဒါကို အခုချက်ချင်း စစ်ပေးပါမယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "04.04.01-S003_alt01",
              "text": "是不是漏了我们的单？",
              "meaning_my": "မှာထားတဲ့အော်ဒါ ကျန်ခဲ့တာလား။"
            }
          ],
          "source_ref": "user_original_04.04.01_O005",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "“漏单”指餐厅遗漏了订单；不一定代表上错菜，也不一定意味着故意不做。",
              "text_my": "“漏单” က အော်ဒါကျန်ခဲ့တာ၊ မေ့လျော့သွားတာကို ဆိုလိုတယ်။ ဟင်းမှားလာတာနဲ့ မတူပါဘူး။"
            }
          ]
        },
        {
          "id": "04.04.01-S004",
          "text": "这道菜下单了吗？",
          "meaning_my": "ဒီဟင်း အော်ဒါတင်ပြီးပြီလား။",
          "replies": [
            {
              "id": "04.04.01-S004_reply01",
              "text": "我先帮您确认一下。",
              "meaning_my": "အရင် စစ်ပေးပါမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.04.01_O006",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.01-S005",
          "text": "炒饭还没来。",
          "meaning_my": "ထမင်းကြော် မရောက်သေးဘူး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_04.04.01_N02",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.01-S006",
          "text": "还有一道没上。",
          "meaning_my": "ဟင်းတစ်ပွဲ ကျန်သေးတယ်။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_04.04.01_N10",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.01-S007",
          "text": "我们等得有点久了。",
          "meaning_my": "စောင့်ရတာ နည်းနည်း ကြာနေပြီ။",
          "replies": [
            {
              "id": "04.04.01-S007_reply01",
              "text": "实在不好意思，我再催一下。",
              "meaning_my": "တကယ် တောင်းပန်ပါတယ်၊ နောက်တစ်ခါ ထပ်လိုက်မေးပေးပါမယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "04.04.01-S007_alt01",
              "text": "已经等很久了。",
              "meaning_my": "အကြာကြီး စောင့်နေရပြီ။"
            }
          ],
          "source_ref": "user_original_04.04.01_O018",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.01-S008",
          "text": "后面点的菜都上了。",
          "meaning_my": "နောက်မှမှာထားတဲ့ ဟင်းတွေတောင် ရောက်နေပြီ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.04.01_O008",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.01-S009",
          "text": "我们赶时间。",
          "meaning_my": "အချိန်မရတော့ဘူး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.04.01_O007",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.01-S010",
          "text": "能先上这道吗？",
          "meaning_my": "ဒီဟင်းကို အရင် တင်ပေးလို့ရမလား။",
          "replies": [
            {
              "id": "04.04.01-S010_reply01",
              "text": "我去问问厨房能不能先上。",
              "meaning_my": "အဲဒီဟင်းကို အရင်တင်ပေးလို့ရမရ မီးဖိုချောင်မှာ သွားမေးပေးမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.04.01_O009",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.01-S011",
          "text": "这道菜还没开始做吗？",
          "meaning_my": "ဒီဟင်းကို အခုထိ မချက်ရသေးဘူးလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.04.01_O017",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "“还没开始做”是尚未开工；“做了但还没上”则表示做好或正在制作但未端上桌。",
              "text_my": "“还没开始做” က စမချက်ရသေးတာပါ။ ချက်နေပြီး စားပွဲပေါ် မရောက်သေးတာနဲ့ မတူပါဘူး။"
            }
          ]
        },
        {
          "id": "04.04.01-S012",
          "text": "饮料先上吧。",
          "meaning_my": "သောက်စရာကို အရင် တင်ပေးပါဦး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_addition_04.04.01_N12",
          "priority": "situational",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        }
      ]
    },
    {
      "id": "04.04.02",
      "title": "加水餐具与用餐请求",
      "title_my": "ရေဖြည့်ခြင်း၊ ပန်းကန်ဇွန်းတူနှင့် စားသောက်ရာတွင် တောင်းဆိုခြင်း",
      "phrase_count": 26,
      "phrases": [
        {
          "id": "04.04.02-S001",
          "text": "麻烦加点水。",
          "meaning_my": "ရေ နည်းနည်း ထပ်ဖြည့်ပေးပါဦး။",
          "replies": [
            {
              "id": "04.04.02-S001_reply01",
              "text": "要热水还是常温水？",
              "meaning_my": "ရေနွေး လိုချင်လား၊ အခန်းအပူချိန်အတိုင်း ရေ လိုချင်လား။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.04.02_O001",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "usage",
              "text": "“加水/续水”是往杯子或壶里补水；需要热水应说“加点热水”。",
              "text_my": "“加水/续水” က ခွက် ဒါမှမဟုတ် ရေကရားထဲ ရေထပ်ဖြည့်တာပါ။ ရေနွေးလိုချင်ရင် သီးသန့်ပြောပါ။"
            }
          ]
        },
        {
          "id": "04.04.02-S002",
          "text": "麻烦拿双筷子。",
          "meaning_my": "တူတစ်စုံ ယူလာပေးပါဦး။",
          "replies": [],
          "alternatives": [
            {
              "id": "04.04.02-S002_alt01",
              "text": "再给我一双筷子。",
              "meaning_my": "တူတစ်စုံ ထပ်ပေးပါဦး။"
            }
          ],
          "source_ref": "user_original_04.04.02_O002",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.02-S003",
          "text": "给我一个勺子。",
          "meaning_my": "ဇွန်းတစ်ချောင်း ပေးပါဦး။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.04.02_O003",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.02-S004",
          "text": "纸巾在哪里？",
          "meaning_my": "တစ်ရှူး ဘယ်မှာလဲ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.04.02_O005",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.02-S005",
          "text": "这个碗能换一下吗？",
          "meaning_my": "ဒီပန်းကန်လုံးကို လဲပေးလို့ရမလား။",
          "replies": [
            {
              "id": "04.04.02-S005_reply01",
              "text": "可以，给您换一个干净的。",
              "meaning_my": "ရပါတယ်၊ သန့်တဲ့ပန်းကန်လုံးတစ်လုံး လဲပေးမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.04.02_O006",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.02-S006",
          "text": "有公筷吗？",
          "meaning_my": "ဟင်းခပ်ဖို့ သီးသန့်တူ ရှိလား။",
          "replies": [
            {
              "id": "04.04.02-S006_reply01",
              "text": "有，我给您拿一双夹菜用的。",
              "meaning_my": "ရှိတယ်၊ ဟင်းခပ်ဖို့ တူတစ်စုံ ယူပေးမယ်။"
            }
          ],
          "alternatives": [
            {
              "id": "04.04.02-S006_alt01",
              "text": "有夹菜用的筷子吗？",
              "meaning_my": "ဟင်းခပ်ဖို့ သီးသန့်တူ ရှိလား။"
            }
          ],
          "source_ref": "user_original_04.04.02_O007",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review",
          "notes": [
            {
              "type": "culture",
              "text": "“公筷”是夹取公共菜品的专用筷子，和自己入口使用的筷子分开。",
              "text_my": "“公筷” က အားလုံးစားမယ့် ဟင်းတွေကို ခပ်ယူဖို့ သီးသန့်တူပါ။ ကိုယ်တိုင်စားတဲ့ တူနဲ့ ခွဲသုံးတာပါ။"
            }
          ]
        },
        {
          "id": "04.04.02-S007",
          "text": "再来一壶热水。",
          "meaning_my": "ရေနွေး တစ်ကရား ထပ်ပေးပါ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.04.02_O008",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.02-S008",
          "text": "能给我一把叉子吗？",
          "meaning_my": "ခက်ရင်းတစ်ချောင်း ပေးလို့ရမလား။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.04.02_O009",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.02-S009",
          "text": "给我两个小碗。",
          "meaning_my": "ပန်းကန်လုံးအသေး နှစ်လုံး ပေးပါ။",
          "replies": [],
          "alternatives": [],
          "source_ref": "user_original_04.04.02_O011",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.02-S010",
          "text": "纸巾用完了。",
          "meaning_my": "တစ်ရှူး ကုန်သွားပြီ။",
          "replies": [
            {
              "id": "04.04.02-S010_reply01",
              "text": "我再拿一点过来。",
              "meaning_my": "နည်းနည်း ထပ်ယူလာပေးမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.04.02_O012",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.02-S011",
          "text": "我不太会用筷子。",
          "meaning_my": "တူနဲ့စားတာ သိပ်မကျွမ်းဘူး။",
          "replies": [
            {
              "id": "04.04.02-S011_reply01",
              "text": "那我给您拿个叉子。",
              "meaning_my": "ဒါဆို ခက်ရင်းတစ်ချောင်း ယူပေးမယ်။"
            }
          ],
          "alternatives": [],
          "source_ref": "user_original_04.04.02_O013",
          "priority": "core",
          "pinyin": null,
          "phonetic_my": null,
          "pronunciation_source": "not_generated",
          "pronunciation_qa": "pending_mandarin_and_myanmar_teacher_review"
        },
        {
          "id": "04.04.02-S012",
          "text": "麻烦拿个空盘子。",
