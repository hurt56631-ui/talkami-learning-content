{
  "theme_id": "04.07",
  "original_candidates": 74,
  "current_main": 55,
  "mapping": [
    {
      "source_ref": "user_original_04.07.01_O001",
      "id": "04.07.01-S001",
      "text": "收货地址就填这个。"
    },
    {
      "source_ref": "user_original_04.07.01_O006",
      "id": "04.07.01-S002",
      "text": "放门口就行。"
    },
    {
      "source_ref": "user_original_04.07.01_O007",
      "id": "04.07.01-S003",
      "text": "到了给我打电话。"
    },
    {
      "source_ref": "user_original_04.07.01_O010",
      "id": "04.07.01-S004",
      "text": "不要打电话，发消息就行。"
    },
    {
      "source_ref": "user_original_04.07.01_O005",
      "id": "04.07.01-S005",
      "text": "不用餐具。"
    },
    {
      "source_ref": "user_original_04.07.01_O002",
      "id": "04.07.01-S006",
      "text": "备注不要辣。"
    },
    {
      "source_ref": "user_original_04.07.01_O017",
      "id": "04.07.01-S007",
      "text": "汤和饭分开装。"
    },
    {
      "source_ref": "user_original_04.07.01_O011",
      "id": "04.07.01-S008",
      "text": "餐具要两份。"
    },
    {
      "source_ref": "user_original_04.07.01_O008",
      "id": "04.07.01-S009",
      "text": "能改收货地址吗？"
    },
    {
      "source_ref": "user_original_04.07.01_O020",
      "id": "04.07.01-S010",
      "text": "我把地址填错了。"
    },
    {
      "source_ref": "user_original_04.07.01_O009",
      "id": "04.07.01-S011",
      "text": "备注现在还能改吗？"
    },
    {
      "source_ref": "user_original_04.07.01_O012",
      "id": "04.07.01-S012",
      "text": "商家接单了吗？"
    },
    {
      "source_ref": "user_original_04.07.01_O019",
      "id": "04.07.01-S013",
      "text": "这个订单还能取消吗？"
    },
    {
      "source_ref": "user_original_04.07.01_O013",
      "id": "04.07.01-S014",
      "text": "商家能看到我的备注吗？"
    },
    {
      "source_ref": "user_original_04.07.01_O018",
      "id": "04.07.01-S015",
      "text": "下单后还能加一份米饭吗？"
    },
    {
      "source_ref": "editorial_new_04.07.01_E01",
      "id": "04.07.01-S016",
      "text": "请送到一楼前台。"
    },
    {
      "source_ref": "user_original_04.07.02_O001",
      "id": "04.07.02-S001",
      "text": "我在楼下。"
    },
    {
      "source_ref": "user_original_04.07.02_O005",
      "id": "04.07.02-S002",
      "text": "我马上下来拿。"
    },
    {
      "source_ref": "user_original_04.07.02_O002",
      "id": "04.07.02-S003",
      "text": "你在哪个门？"
    },
    {
      "source_ref": "user_original_04.07.02_O003",
      "id": "04.07.02-S004",
      "text": "我找不到你。"
    },
    {
      "source_ref": "user_original_04.07.02_O009",
      "id": "04.07.02-S005",
      "text": "我到门口了。"
    },
    {
      "source_ref": "user_original_04.07.02_O004",
      "id": "04.07.02-S006",
      "text": "我在东门，穿黑色衣服。"
    },
    {
      "source_ref": "user_original_04.07.02_O006",
      "id": "04.07.02-S007",
      "text": "你进不来就放前台。"
    },
    {
      "source_ref": "user_original_04.07.02_O018",
      "id": "04.07.02-S008",
      "text": "外卖放在哪儿了？"
    },
    {
      "source_ref": "user_original_04.07.02_O008",
      "id": "04.07.02-S009",
      "text": "你能看到我的定位吗？"
    },
    {
      "source_ref": "user_original_04.07.02_O013",
      "id": "04.07.02-S010",
      "text": "我就在保安亭旁边。"
    },
    {
      "source_ref": "editorial_new_04.07.02_E01",
      "id": "04.07.02-S011",
      "text": "能送到楼下吗？"
    },
    {
      "source_ref": "editorial_new_04.07.02_E02",
      "id": "04.07.02-S012",
      "text": "你在几号楼？"
    },
    {
      "source_ref": "editorial_new_04.07.02_E03",
      "id": "04.07.02-S013",
      "text": "可以放外卖柜里吗？"
    },
    {
      "source_ref": "user_original_04.07.02_O019",
      "id": "04.07.02-S014",
      "text": "放前台就行。"
    },
    {
      "source_ref": "user_original_04.07.03_O001",
      "id": "04.07.03-S001",
      "text": "外卖还要多久到？"
    },
    {
      "source_ref": "user_original_04.07.03_O002",
      "id": "04.07.03-S002",
      "text": "已经超时了。"
    },
    {
      "source_ref": "user_original_04.07.03_O004",
      "id": "04.07.03-S003",
      "text": "骑手到哪儿了？"
    },
    {
      "source_ref": "user_original_04.07.03_O005",
      "id": "04.07.03-S004",
      "text": "商家出餐了吗？"
    },
    {
      "source_ref": "user_original_04.07.03_O006",
      "id": "04.07.03-S005",
      "text": "骑手是不是还没取餐？"
    },
    {
      "source_ref": "user_original_04.07.03_O014",
      "id": "04.07.03-S006",
      "text": "预计几点能送到？"
    },
    {
      "source_ref": "editorial_new_04.07.03_E01",
      "id": "04.07.03-S007",
      "text": "怎么一直显示配送中？"
    },
    {
      "source_ref": "editorial_new_04.07.03_E02",
      "id": "04.07.03-S008",
      "text": "能帮我联系骑手吗？"
    },
    {
      "source_ref": "user_original_04.07.03_O007",
      "id": "04.07.03-S009",
      "text": "再晚的话可以取消吗？"
    },
    {
      "source_ref": "user_original_04.07.04_O001",
      "id": "04.07.04-S001",
      "text": "少送了一份。"
    },
    {
      "source_ref": "user_original_04.07.04_O004",
      "id": "04.07.04-S002",
      "text": "外卖送错了。"
    },
    {
      "source_ref": "user_original_04.07.04_O005",
      "id": "04.07.04-S003",
      "text": "饮料没送。"
    },
    {
      "source_ref": "editorial_new_04.07.04_E01",
      "id": "04.07.04-S004",
      "text": "订单显示送达了，但我没收到。"
    },
    {
      "source_ref": "user_original_04.07.04_O006",
      "id": "04.07.04-S005",
      "text": "可以补送吗？"
    },
    {
      "source_ref": "user_original_04.07.04_O007",
      "id": "04.07.04-S006",
      "text": "我要申请退款。"
    },
    {
      "source_ref": "user_original_04.07.04_O008",
      "id": "04.07.04-S007",
      "text": "少送的那份能单独退款吗？"
    },
    {
      "source_ref": "user_original_04.07.04_O010",
      "id": "04.07.04-S008",
      "text": "饮料洒了。"
    },
    {
      "source_ref": "user_original_04.07.04_O011",
      "id": "04.07.04-S009",
      "text": "餐品被压坏了。"
    },
    {
      "source_ref": "user_original_04.07.04_O009",
      "id": "04.07.04-S010",
      "text": "餐具少了一套。"
    },
    {
      "source_ref": "user_original_04.07.04_O016",
      "id": "04.07.04-S011",
      "text": "商家一直没回复怎么办？"
    },
    {
      "source_ref": "editorial_new_04.07.04_E02",
      "id": "04.07.04-S012",
      "text": "能联系平台客服吗？"
    },
    {
      "source_ref": "user_original_04.07.04_O018",
      "id": "04.07.04-S013",
      "text": "取消订单后多久能退款？"
    },
    {
      "source_ref": "user_original_04.07.04_O019",
      "id": "04.07.04-S014",
      "text": "退款会原路退回吗？"
    },
    {
      "source_ref": "editorial_new_04.07.04_E03",
      "id": "04.07.04-S015",
      "text": "退款还没到账。"
    },
    {
      "source_ref": "user_original_04.07.04_O020",
      "id": "04.07.04-S016",
      "text": "送来的饭都凉了。"
    }
  ]
}
