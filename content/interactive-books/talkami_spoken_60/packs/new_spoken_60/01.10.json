  "scenes": [
    {
      "id": "01.10.01",
      "title": "时刻与约定",
      "title_my": "အချိန်နာရီနှင့် ချိန်းဆိုခြင်း",
      "phrase_count": 36,
      "original_count": 27,
      "added_count": 9,
      "phrases": [
        {
          "id": "01.10.01-S001",
          "text": "现在几点？",
          "meaning_my": "အခု ဘယ်နှနာရီရှိပြီလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S002",
          "text": "几点下班？",
          "meaning_my": "ဘယ်နှနာရီ အလုပ်ပြီးလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S003",
          "text": "今天要加班，我九点左右下班。",
          "meaning_my": "ဒီနေ့ အချိန်ပိုဆင်းရမယ်၊ ကိုးနာရီလောက်မှ အလုပ်ပြီးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S004",
          "text": "几点到？",
          "meaning_my": "ဘယ်နှနာရီ ရောက်မလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S005",
          "text": "上午几点开始？",
          "meaning_my": "မနက် ဘယ်နှနာရီ စမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S006",
          "text": "下午三点。",
          "meaning_my": "မွန်းလွဲ သုံးနာရီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S007",
          "text": "三点不方便，四点可以吗？",
          "meaning_my": "သုံးနာရီ မရဘူး၊ လေးနာရီဆို ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S008",
          "text": "三点半。",
          "meaning_my": "သုံးနာရီခွဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S009",
          "text": "我们六点见。",
          "meaning_my": "ခြောက်နာရီ တွေ့ကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S010",
          "text": "快八点了。",
          "meaning_my": "ရှစ်နာရီထိုးတော့မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S011",
          "text": "八点十五分。",
          "meaning_my": "ရှစ်နာရီ ဆယ့်ငါးမိနစ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S012",
          "text": "中午十二点。",
          "meaning_my": "နေ့လယ် ဆယ့်နှစ်နာရီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S013",
          "text": "晚上七点开始。",
          "meaning_my": "ည ခုနစ်နာရီ စမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S014",
          "text": "我九点上班。",
          "meaning_my": "ကိုးနာရီ အလုပ်စတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S015",
          "text": "我六点下班。",
          "meaning_my": "ခြောက်နာရီမှာ အလုပ်ပြီးတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S016",
          "text": "大概几点结束？",
          "meaning_my": "ဘယ်နှနာရီလောက် ပြီးမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S017",
          "text": "十点前到就行。",
          "meaning_my": "ဆယ်နာရီမတိုင်ခင် ရောက်ရင် ရပြီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S018",
          "text": "现在两点半。",
          "meaning_my": "အခု နှစ်နာရီခွဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S019",
          "text": "九点准时开始。",
          "meaning_my": "ကိုးနာရီတိတိ စမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S020",
          "text": "我今天五点就能走。",
          "meaning_my": "ဒီနေ့ ငါးနာရီကတည်းက ပြန်လို့ရတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S021",
          "text": "六点左右到。",
          "meaning_my": "ခြောက်နာရီလောက် ရောက်မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S022",
          "text": "还有十五分钟下班。",
          "meaning_my": "နောက်ထပ် ဆယ့်ငါးမိနစ်နေရင် အလုပ်ပြီးပြီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S023",
          "text": "我六点前得走。",
          "meaning_my": "ခြောက်နာရီမတိုင်ခင် သွားရမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S024",
          "text": "今天提前半小时下班。",
          "meaning_my": "ဒီနေ့ နာရီဝက်စောပြီး အလုပ်ပြီးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S025",
          "text": "三点一刻。",
          "meaning_my": "သုံးနာရီ ဆယ့်ငါးမိနစ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S026",
          "text": "还有十分钟就开始了。",
          "meaning_my": "စဖို့ ဆယ်မိနစ်ပဲ လိုတော့တယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S027",
          "text": "差五分八点。",
          "meaning_my": "ရှစ်နာရီထိုးဖို့ ငါးမိနစ်လိုသေးတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S028",
          "text": "还早。",
          "meaning_my": "စောသေးတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S029",
          "text": "时间到了。",
          "meaning_my": "အချိန်ရောက်ပြီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S030",
          "text": "我迟到了。",
          "meaning_my": "နောက်ကျသွားပြီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S031",
          "text": "我来早了。",
          "meaning_my": "စောရောက်သွားတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S032",
          "text": "大概三点。",
          "meaning_my": "သုံးနာရီလောက်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S033",
          "text": "还有半小时。",
          "meaning_my": "နာရီဝက် လိုသေးတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S034",
          "text": "时间不够了。",
          "meaning_my": "အချိန် မလောက်တော့ဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S035",
          "text": "还有时间。",
          "meaning_my": "အချိန် ရှိသေးတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.01-S036",
          "text": "时间改了。",
          "meaning_my": "အချိန် ပြောင်းသွားပြီ။",
          "replies": [],
          "alternatives": []
        }
      ]
    },
    {
      "id": "01.10.02",
      "title": "日期、星期与约定",
      "title_my": "ရက်စွဲ၊ အပတ်ရက်နှင့် ချိန်းဆိုခြင်း",
      "phrase_count": 36,
      "original_count": 28,
