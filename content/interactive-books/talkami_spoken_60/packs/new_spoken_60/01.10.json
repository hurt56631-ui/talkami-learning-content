      "phrases": [
        {
          "id": "01.10.02-S001",
          "text": "今天几号？",
          "meaning_my": "ဒီနေ့ ဘယ်နှရက်နေ့လဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S002",
          "text": "今天星期几？",
          "meaning_my": "ဒီနေ့ ဘာနေ့လဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S003",
          "text": "周几休息？",
          "meaning_my": "တစ်ပတ်မှာ ဘယ်နေ့နားရလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S004",
          "text": "哪天有空？",
          "meaning_my": "ဘယ်နေ့ အားလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S005",
          "text": "下周一可以吗？",
          "meaning_my": "နောက်တနင်္လာနေ့ ရမလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S006",
          "text": "今天八号。",
          "meaning_my": "ဒီနေ့ ရှစ်ရက်နေ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S007",
          "text": "我昨天休息。",
          "meaning_my": "မနေ့က နားခဲ့တယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S008",
          "text": "星期五。",
          "meaning_my": "သောကြာနေ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S009",
          "text": "我前天刚到。",
          "meaning_my": "မနေ့တစ်နေ့ကမှ ရောက်တာ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S010",
          "text": "后天你有空吗？",
          "meaning_my": "သန်ဘက်ခါ အားလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S011",
          "text": "明天几号？",
          "meaning_my": "မနက်ဖြန် ဘယ်နှရက်နေ့လဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S012",
          "text": "几号发工资？",
          "meaning_my": "ဘယ်နေ့ လစာထုတ်ပေးလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S013",
          "text": "下周几开会？",
          "meaning_my": "နောက်အပတ် ဘာနေ့ အစည်းအဝေးရှိလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S014",
          "text": "我周三休息。",
          "meaning_my": "ဗုဒ္ဓဟူးနေ့ နားရတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S015",
          "text": "上周我请假了。",
          "meaning_my": "ပြီးခဲ့တဲ့အပတ်က ခွင့်ယူခဲ့တယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S016",
          "text": "还有几天到月底？",
          "meaning_my": "လကုန်ဖို့ ဘယ်နှရက်လိုသေးလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S017",
          "text": "明天星期二。",
          "meaning_my": "မနက်ဖြန် အင်္ဂါနေ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S018",
          "text": "下周一上班。",
          "meaning_my": "နောက်တနင်္လာနေ့ အလုပ်ဆင်းရမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S019",
          "text": "我去年来的。",
          "meaning_my": "မနှစ်က ရောက်လာတာ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S020",
          "text": "这个月底发工资。",
          "meaning_my": "ဒီလကုန် လစာထုတ်ပေးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S021",
          "text": "十五号之前交给我。",
          "meaning_my": "ဆယ့်ငါးရက်နေ့မတိုင်ခင် အပ်ပေးပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S022",
          "text": "这次放几天假？",
          "meaning_my": "ဒီတစ်ခါ ဘယ်နှရက်ပိတ်မလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S023",
          "text": "下个月五号回来。",
          "meaning_my": "နောက်လ ငါးရက်နေ့ ပြန်လာမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S024",
          "text": "明年我想回家。",
          "meaning_my": "နောက်နှစ် အိမ်ပြန်ချင်တယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S025",
          "text": "今天是几月几号？",
          "meaning_my": "ဒီနေ့ ဘယ်လ ဘယ်နှရက်နေ့လဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S026",
          "text": "明天是周末吗？",
          "meaning_my": "မနက်ဖြန် ပိတ်ရက်လား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S027",
          "text": "我们下周几见？",
          "meaning_my": "နောက်အပတ် ဘာနေ့ တွေ့ကြမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S028",
          "text": "我上个月来的。",
          "meaning_my": "ပြီးခဲ့တဲ့လက ရောက်လာတာ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S029",
          "text": "约个时间吧。",
          "meaning_my": "အချိန်တစ်ခု ချိန်းကြရအောင်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S030",
          "text": "这个周末有空吗？",
          "meaning_my": "ဒီပိတ်ရက် အားလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S031",
          "text": "周末休息吗？",
          "meaning_my": "ပိတ်ရက်မှာ နားရလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S032",
          "text": "明天还上班吗？",
          "meaning_my": "မနက်ဖြန်လည်း အလုပ်ဆင်းရသေးလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S033",
          "text": "我后天有空。",
          "meaning_my": "သန်ဘက်ခါ အားတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S034",
          "text": "我们改天见。",
          "meaning_my": "တခြားနေ့မှ တွေ့ကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S035",
          "text": "这个星期来不及。",
          "meaning_my": "ဒီအပတ်တော့ အချိန်မမီတော့ဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.10.02-S036",
          "text": "下周再说吧。",
          "meaning_my": "နောက်အပတ်မှ ပြန်ပြောကြမယ်။",
          "replies": [],
          "alternatives": []
        }
      ]
