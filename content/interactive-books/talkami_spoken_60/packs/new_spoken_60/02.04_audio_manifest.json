  "entries": [
    {
      "id": "02.04.01-S001",
      "kind": "main",
      "cn": "到了吗？",
      "meaning_my": "ရောက်ပြီလား။",
      "audio_file": "02.04.01-S001.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S001_reply01",
      "kind": "reply",
      "cn": "还没，快到了。",
      "meaning_my": "မရောက်သေးဘူး၊ ရောက်တော့မယ်။",
      "audio_file": "02.04.01-S001_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S001_alt01",
      "kind": "alternative",
      "cn": "到地方了吗？",
      "meaning_my": "ချိန်းထားတဲ့နေရာ ရောက်ပြီလား။",
      "audio_file": "02.04.01-S001_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S002",
      "kind": "main",
      "cn": "到哪儿了？",
      "meaning_my": "ဘယ်အထိ ရောက်ပြီလဲ။",
      "audio_file": "02.04.01-S002.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S002_reply01",
      "kind": "reply",
      "cn": "刚到地铁站。",
      "meaning_my": "အခုမှ မြေအောက်ရထားဘူတာ ရောက်တာ။",
      "audio_file": "02.04.01-S002_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S002_alt01",
      "kind": "alternative",
      "cn": "你现在到哪儿了？",
      "meaning_my": "အခု ဘယ်အထိ ရောက်နေပြီလဲ။",
      "audio_file": "02.04.01-S002_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S003",
      "kind": "main",
      "cn": "还有多久？",
      "meaning_my": "နောက်ထပ် ဘယ်လောက်ကြာဦးမလဲ။",
      "audio_file": "02.04.01-S003.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S003_reply01",
      "kind": "reply",
      "cn": "大概还要十分钟。",
      "meaning_my": "နောက်ဆယ်မိနစ်လောက် လိုဦးမယ်။",
      "audio_file": "02.04.01-S003_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S003_alt01",
      "kind": "alternative",
      "cn": "还要多长时间？",
      "meaning_my": "နောက်ထပ် ဘယ်လောက်ကြာဦးမလဲ။",
      "audio_file": "02.04.01-S003_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S004",
      "kind": "main",
      "cn": "你出发了吗？",
      "meaning_my": "ထွက်လာပြီလား။",
      "audio_file": "02.04.01-S004.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S004_reply01",
      "kind": "reply",
      "cn": "出发了，在路上。",
      "meaning_my": "ထွက်လာပြီ၊ လမ်းမှာ။",
      "audio_file": "02.04.01-S004_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S004_alt01",
      "kind": "alternative",
      "cn": "你已经出发了吗？",
      "meaning_my": "ထွက်လာပြီးပြီလား။",
      "audio_file": "02.04.01-S004_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S005",
      "kind": "main",
      "cn": "大概几点能到？",
      "meaning_my": "ဘယ်နှနာရီလောက် ရောက်နိုင်မလဲ။",
      "audio_file": "02.04.01-S005.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S005_reply01",
      "kind": "reply",
      "cn": "七点左右到。",
      "meaning_my": "ခုနစ်နာရီလောက် ရောက်မယ်။",
      "audio_file": "02.04.01-S005_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S005_alt01",
      "kind": "alternative",
      "cn": "大概什么时候到？",
      "meaning_my": "ဘယ်အချိန်လောက် ရောက်မလဲ။",
      "audio_file": "02.04.01-S005_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S006",
      "kind": "main",
      "cn": "我还在等你。",
      "meaning_my": "စောင့်နေတုန်းပဲ။",
      "audio_file": "02.04.01-S006.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S006_reply01",
      "kind": "reply",
      "cn": "不好意思，让你等了。",
      "meaning_my": "စောင့်ခိုင်းမိလို့ တောင်းပန်ပါတယ်။",
      "audio_file": "02.04.01-S006_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S006_alt01",
      "kind": "alternative",
      "cn": "我还在这儿等着呢。",
      "meaning_my": "ဒီမှာ စောင့်နေတုန်းပဲ။",
      "audio_file": "02.04.01-S006_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S007",
      "kind": "main",
      "cn": "离这里还有多远？",
      "meaning_my": "ဒီကိုရောက်ဖို့ ဘယ်လောက်ဝေးသေးလဲ။",
      "audio_file": "02.04.01-S007.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S007_reply01",
      "kind": "reply",
      "cn": "还有两公里左右。",
      "meaning_my": "နောက်ထပ် နှစ်ကီလိုမီတာလောက် ဝေးသေးတယ်။",
      "audio_file": "02.04.01-S007_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S008",
      "kind": "main",
      "cn": "你现在在路上吗？",
      "meaning_my": "အခု လမ်းမှာလား။",
      "audio_file": "02.04.01-S008.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S008_reply01",
      "kind": "reply",
      "cn": "对，还在路上。",
      "meaning_my": "ဟုတ်တယ်၊ လမ်းမှာပဲ ရှိသေးတယ်။",
      "audio_file": "02.04.01-S008_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S009",
      "kind": "main",
      "cn": "到附近了告诉我。",
      "meaning_my": "ဒီနားရောက်ရင် ပြောနော်။",
      "audio_file": "02.04.01-S009.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S010",
      "kind": "main",
      "cn": "你坐上车了吗？",
      "meaning_my": "ကားပေါ် တက်ပြီးပြီလား။",
      "audio_file": "02.04.01-S010.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S010_reply01",
      "kind": "reply",
      "cn": "刚上车。",
      "meaning_my": "အခုမှ ကားပေါ် တက်တာ။",
      "audio_file": "02.04.01-S010_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S011",
      "kind": "main",
      "cn": "在路上。",
      "meaning_my": "လမ်းမှာပါ။",
      "audio_file": "02.04.01-S011.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S011_alt01",
      "kind": "alternative",
      "cn": "还在路上。",
      "meaning_my": "လမ်းမှာပဲ ရှိသေးတယ်။",
      "audio_file": "02.04.01-S011_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S012",
      "kind": "main",
      "cn": "我十分钟后到。",
      "meaning_my": "နောက်ဆယ်မိနစ်ဆို ရောက်မယ်။",
      "audio_file": "02.04.01-S012.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S013",
      "kind": "main",
      "cn": "刚出发。",
      "meaning_my": "အခုမှ ထွက်လာတာ။",
      "audio_file": "02.04.01-S013.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S014",
      "kind": "main",
      "cn": "有点堵车。",
      "meaning_my": "ကား နည်းနည်းပိတ်နေတယ်။",
      "audio_file": "02.04.01-S014.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S014_reply01",
      "kind": "reply",
      "cn": "那路上小心。",
      "meaning_my": "ဒါဆို လမ်းမှာ သတိထားနော်။",
      "audio_file": "02.04.01-S014_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S015",
      "kind": "main",
      "cn": "我已经到附近了。",
      "meaning_my": "ဒီနားရောက်နေပြီ။",
      "audio_file": "02.04.01-S015.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S016",
      "kind": "main",
      "cn": "你先进去吧。",
      "meaning_my": "အထဲ အရင်ဝင်နှင့်ပါ။",
      "audio_file": "02.04.01-S016.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S017",
      "kind": "main",
      "cn": "我快到门口了。",
      "meaning_my": "တံခါးဝ ရောက်တော့မယ်။",
      "audio_file": "02.04.01-S017.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S017_alt01",
      "kind": "alternative",
      "cn": "快到入口了。",
      "meaning_my": "ဝင်ပေါက် ရောက်တော့မယ်။",
      "audio_file": "02.04.01-S017_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S018",
      "kind": "main",
      "cn": "我到楼下了，入口在哪儿？",
      "meaning_my": "အဆောက်အအုံအောက် ရောက်ပြီ၊ ဝင်ပေါက် ဘယ်မှာလဲ။",
      "audio_file": "02.04.01-S018.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S018_reply01",
      "kind": "reply",
      "cn": "就在一楼大厅旁边。",
      "meaning_my": "မြေညီထပ် ဧည့်ခန်းမဘေးမှာပဲ။",
      "audio_file": "02.04.01-S018_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S019",
      "kind": "main",
      "cn": "你能准时到吗？",
      "meaning_my": "အချိန်မှန် ရောက်နိုင်မလား။",
      "audio_file": "02.04.01-S019.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S019_reply01",
      "kind": "reply",
      "cn": "应该能准时到。",
      "meaning_my": "အချိန်မီ ရောက်နိုင်လောက်တယ်။",
      "audio_file": "02.04.01-S019_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S019_alt01",
      "kind": "alternative",
      "cn": "能按时到吗？",
      "meaning_my": "အချိန်မီ ရောက်နိုင်မလား။",
      "audio_file": "02.04.01-S019_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S020",
      "kind": "main",
      "cn": "我已经出门了。",
      "meaning_my": "အိမ်က ထွက်လာပြီ။",
      "audio_file": "02.04.01-S020.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S021",
      "kind": "main",
      "cn": "我刚坐上公交车。",
      "meaning_my": "ခုနကမှ ဘတ်စ်ကားပေါ် တက်တာ။",
      "audio_file": "02.04.01-S021.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S022",
      "kind": "main",
      "cn": "我快到了，再等我一下。",
      "meaning_my": "ရောက်တော့မယ်၊ ခဏထပ်စောင့်ပါဦး။",
      "audio_file": "02.04.01-S022.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S022_alt01",
      "kind": "alternative",
      "cn": "我马上到了，再等等我。",
      "meaning_my": "ရောက်တော့မယ်၊ ခဏ ထပ်စောင့်ပေးဦးနော်။",
      "audio_file": "02.04.01-S022_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S023",
      "kind": "main",
      "cn": "你先点菜吧，不用等我。",
      "meaning_my": "ဟင်းအရင်မှာထားလိုက်ပါ၊ မစောင့်နဲ့နော်။",
      "audio_file": "02.04.01-S023.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S023_reply01",
      "kind": "reply",
      "cn": "好，我先点。",
      "meaning_my": "ကောင်းပြီ၊ အရင်မှာထားလိုက်မယ်။",
      "audio_file": "02.04.01-S023_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S024",
      "kind": "main",
      "cn": "你现在在哪儿？",
      "meaning_my": "အခု ဘယ်မှာလဲ။",
      "audio_file": "02.04.01-S024.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S024_reply01",
      "kind": "reply",
      "cn": "在地铁站附近。",
      "meaning_my": "မြေအောက်ရထားဘူတာနားမှာ။",
      "audio_file": "02.04.01-S024_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S024_alt01",
      "kind": "alternative",
      "cn": "你在哪个位置？",
      "meaning_my": "ဘယ်နေရာမှာ ရှိနေလဲ။",
      "audio_file": "02.04.01-S024_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S025",
      "kind": "main",
      "cn": "你出门了吗？",
      "meaning_my": "အိမ်က ထွက်လာပြီလား။",
      "audio_file": "02.04.01-S025.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S025_reply01",
      "kind": "reply",
      "cn": "出了，刚上车。",
      "meaning_my": "ထွက်လာပြီ၊ အခုမှ ကားပေါ်တက်တာ။",
      "audio_file": "02.04.01-S025_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S026",
      "kind": "main",
      "cn": "路上堵车吗？",
      "meaning_my": "လမ်းမှာ ကားပိတ်နေလား။",
      "audio_file": "02.04.01-S026.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S026_reply01",
      "kind": "reply",
      "cn": "有点堵，可能晚几分钟。",
      "meaning_my": "နည်းနည်း ကားပိတ်လို့ မိနစ်အနည်းငယ် နောက်ကျနိုင်တယ်။",
      "audio_file": "02.04.01-S026_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S027",
      "kind": "main",
      "cn": "要不要我过去接你？",
      "meaning_my": "လာကြိုပေးရမလား။",
      "audio_file": "02.04.01-S027.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S027_reply01",
      "kind": "reply",
      "cn": "不用，我自己过去。",
      "meaning_my": "မလိုဘူး၊ ကိုယ်တိုင် လာလိုက်မယ်။",
      "audio_file": "02.04.01-S027_reply01.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S028",
      "kind": "main",
      "cn": "别着急，路上小心。",
      "meaning_my": "အလျင်မလိုနဲ့၊ လမ်းမှာ သတိထားနော်။",
      "audio_file": "02.04.01-S028.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S029",
      "kind": "main",
      "cn": "我在老地方等你。",
      "meaning_my": "အရင်ချိန်းနေကျ နေရာမှာ စောင့်နေမယ်။",
      "audio_file": "02.04.01-S029.mp3",
      "audio_status": "not_recorded"
    },
    {
      "id": "02.04.01-S029_alt01",
      "kind": "alternative",
      "cn": "我在原来约好的地方等你。",
      "meaning_my": "အရင်ချိန်းထားတဲ့နေရာမှာ စောင့်နေမယ်။",
      "audio_file": "02.04.01-S029_alt01.mp3",
      "audio_status": "not_recorded"
    },
    {
