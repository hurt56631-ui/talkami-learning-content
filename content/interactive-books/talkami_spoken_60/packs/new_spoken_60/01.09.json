  "scenes": [
    {
      "id": "01.09.01",
      "title": "表达打算与询问",
      "title_my": "အစီအစဉ်နှင့် ရည်ရွယ်ချက်ကို ပြောခြင်း၊ မေးခြင်း",
      "original_count": 22,
      "added_count": 10,
      "phrase_count": 32,
      "phrases": [
        {
          "id": "01.09.01-S001",
          "text": "我想去。",
          "meaning_my": "သွားချင်တယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S002",
          "text": "我要买这个。",
          "meaning_my": "ဒါကို ဝယ်မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S003",
          "text": "我准备明天去。",
          "meaning_my": "မနက်ဖြန် သွားဖို့ စီစဉ်ထားတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S004",
          "text": "我打算换工作。",
          "meaning_my": "အလုပ်ပြောင်းဖို့ စဉ်းစားထားတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S005",
          "text": "我可能晚点去。",
          "meaning_my": "နောက်မှ သွားဖြစ်နိုင်တယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S006",
          "text": "我还没决定。",
          "meaning_my": "မဆုံးဖြတ်ရသေးဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S007",
          "text": "我先问问再说。",
          "meaning_my": "အရင် မေးကြည့်လိုက်ဦးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S008",
          "text": "我还想再看看。",
          "meaning_my": "နည်းနည်း ထပ်ကြည့်ချင်သေးတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S009",
          "text": "我打算先找房子。",
          "meaning_my": "အရင် အိမ်ရှာဖို့ စီစဉ်ထားတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S010",
          "text": "我想先试试。",
          "meaning_my": "အရင် စမ်းကြည့်ချင်တယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S011",
          "text": "你有什么打算？",
          "meaning_my": "ဘာအစီအစဉ်ရှိလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S012",
          "text": "准备什么时候去？",
          "meaning_my": "ဘယ်တော့သွားဖို့ စီစဉ်ထားလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S013",
          "text": "决定了吗？",
          "meaning_my": "ဆုံးဖြတ်ပြီးပြီလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S014",
          "text": "想好了告诉我。",
          "meaning_my": "စဉ်းစားပြီးရင် ပြောနော်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S015",
          "text": "你可以再考虑一下。",
          "meaning_my": "နည်းနည်း ထပ်စဉ်းစားလို့ရတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S016",
          "text": "你准备怎么做？",
          "meaning_my": "ဘယ်လိုလုပ်ဖို့ စီစဉ်ထားလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S017",
          "text": "周末我想出去走走。",
          "meaning_my": "ပိတ်ရက်ကျ အပြင်ထွက်လည်ချင်တယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S018",
          "text": "我想学中文。",
          "meaning_my": "တရုတ်စာ သင်ချင်တယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S019",
          "text": "找到合适的工作了吗？",
          "meaning_my": "ကိုက်ညီတဲ့ အလုပ်ရှာတွေ့ပြီလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S020",
          "text": "我还没想好去哪儿。",
          "meaning_my": "ဘယ်သွားမလဲ မစဉ်းစားရသေးဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S021",
          "text": "你考虑清楚了吗？",
          "meaning_my": "သေချာ စဉ်းစားပြီးပြီလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S022",
          "text": "我打算下个月搬家。",
          "meaning_my": "နောက်လ အိမ်ပြောင်းဖို့ စီစဉ်ထားတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S023",
          "text": "我决定好了。",
          "meaning_my": "ဆုံးဖြတ်ပြီးပြီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S024",
          "text": "我先看看情况。",
          "meaning_my": "အခြေအနေကို အရင်ကြည့်ဦးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S025",
          "text": "我打算明天开始。",
          "meaning_my": "မနက်ဖြန် စဖို့ စီစဉ်ထားတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S026",
          "text": "你准备去哪儿？",
          "meaning_my": "ဘယ်ကို သွားဖို့ စီစဉ်ထားလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S027",
          "text": "我先准备一下。",
          "meaning_my": "အရင် ခဏ ပြင်ဆင်လိုက်ဦးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S028",
          "text": "我想先休息几天。",
          "meaning_my": "ရက်နည်းနည်း အရင် နားချင်တယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S029",
          "text": "我暂时不打算买。",
          "meaning_my": "လောလောဆယ် ဝယ်ဖို့ အစီအစဉ် မရှိသေးဘူး။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S030",
          "text": "我想先存点钱。",
          "meaning_my": "ပိုက်ဆံ နည်းနည်း အရင် စုချင်တယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S031",
          "text": "我准备下周开始。",
          "meaning_my": "နောက်အပတ် စဖို့ ပြင်ဆင်ထားတယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.01-S032",
          "text": "要不要一起去？",
          "meaning_my": "အတူ သွားကြမလား။",
          "replies": [],
          "alternatives": []
        }
      ]
    },
    {
      "id": "01.09.02",
      "title": "制定计划与步骤",
      "title_my": "အစီအစဉ်ချမှတ်ခြင်းနှင့် အဆင့်လိုက်လုပ်ခြင်း",
      "original_count": 21,
      "added_count": 12,
      "phrase_count": 33,
      "phrases": [
        {
          "id": "01.09.02-S001",
          "text": "我们先吃饭。",
          "meaning_my": "အရင် ထမင်းစားကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S002",
          "text": "我还不饿，先办事吧。",
          "meaning_my": "ဗိုက်မဆာသေးဘူး၊ ကိစ္စအရင်သွားလုပ်ကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S003",
          "text": "然后去超市。",
          "meaning_my": "ပြီးရင် စူပါမားကတ်သွားမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S004",
          "text": "下午三点出发。",
          "meaning_my": "မွန်းလွဲသုံးနာရီ ထွက်မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S005",
          "text": "好，我三点前准备好。",
          "meaning_my": "ကောင်းပြီ၊ သုံးနာရီမတိုင်ခင် အဆင်သင့်လုပ်ထားမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S006",
          "text": "然后去拿快递。",
          "meaning_my": "ပြီးရင် ပါဆယ်သွားယူမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S007",
          "text": "先把东西准备好。",
          "meaning_my": "ပစ္စည်းတွေ အရင် အဆင်သင့်လုပ်ထားပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S008",
          "text": "吃完饭再出发。",
          "meaning_my": "ထမင်းစားပြီးမှ ထွက်မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S009",
          "text": "我们两点集合。",
          "meaning_my": "နှစ်နာရီမှာ စုကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S010",
          "text": "我先去，你晚点来。",
          "meaning_my": "အရင် သွားနှင့်မယ်၊ နောက်မှ လိုက်လာပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S011",
          "text": "最后再检查一遍。",
          "meaning_my": "နောက်ဆုံးမှာ နောက်တစ်ခေါက် ထပ်စစ်ပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S012",
          "text": "先买票，再订酒店。",
          "meaning_my": "လက်မှတ်အရင်ဝယ်ပြီးမှ ဟိုတယ်ဘွတ်ကင်လုပ်မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S013",
          "text": "先做哪个？",
          "meaning_my": "ဘယ်ဟာ အရင်လုပ်ရမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S014",
          "text": "然后做什么？",
          "meaning_my": "ပြီးရင် ဘာလုပ်ရမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S015",
          "text": "这件事做完再说。",
          "meaning_my": "ဒီကိစ္စပြီးမှ ဆက်ပြောကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S016",
          "text": "下午再弄。",
          "meaning_my": "နေ့လယ်နောက်ပိုင်းမှ ဆက်လုပ်မယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S017",
          "text": "出门别忘了带钥匙。",
          "meaning_my": "အိမ်ကထွက်ရင် သော့ယူဖို့ မမေ့နဲ့။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S018",
          "text": "几点开始？",
          "meaning_my": "ဘယ်အချိန် စမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S019",
          "text": "先把要做的事说清楚。",
          "meaning_my": "လုပ်စရာတွေကို အရင် ရှင်းရှင်းလင်းလင်း ပြောပါ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S020",
          "text": "我们先去哪儿？",
          "meaning_my": "ဘယ်ကို အရင်သွားကြမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S021",
          "text": "不急，今天弄完就行。",
          "meaning_my": "အလျင်မလိုဘူး၊ ဒီနေ့ပြီးရင် ရပြီ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S022",
          "text": "然后呢？",
          "meaning_my": "ပြီးရင်ရော။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S023",
          "text": "我们几点见？",
          "meaning_my": "ဘယ်နှနာရီမှာ တွေ့ကြမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S024",
          "text": "几点出发？",
          "meaning_my": "ဘယ်နှနာရီမှာ ထွက်မလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S025",
          "text": "几点回来？",
          "meaning_my": "ဘယ်နှနာရီ ပြန်လာမလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S026",
          "text": "大概需要多久？",
          "meaning_my": "ဘယ်လောက်ကြာလောက်မလဲ။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S027",
          "text": "先吃饭还是先办事？",
          "meaning_my": "ထမင်းအရင်စားမလား၊ ကိစ္စအရင်လုပ်မလား။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S028",
          "text": "我们分头行动。",
          "meaning_my": "ခွဲပြီး ကိုယ့်အလုပ်ကိုယ် လုပ်ကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S029",
          "text": "我先去办点事。",
          "meaning_my": "ကိစ္စလေးတစ်ခု သွားလုပ်လိုက်ဦးမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S030",
          "text": "你先去，我随后到。",
          "meaning_my": "အရင် သွားနှင့်ပါ၊ နောက်က လိုက်လာမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S031",
          "text": "先这样安排。",
          "meaning_my": "လောလောဆယ် ဒီလိုပဲ စီစဉ်ထားမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S032",
          "text": "按顺序来。",
          "meaning_my": "အစဉ်လိုက် လုပ်ကြမယ်။",
          "replies": [],
          "alternatives": []
        },
        {
          "id": "01.09.02-S033",
          "text": "做完给我发消息。",
          "meaning_my": "ပြီးရင် စာပို့ပေးနော်။",
          "replies": [],
          "alternatives": []
        }
      ]
